# Regenerate the article with tree-sitter CLI 0.26.8, a C compiler, Python 3 and pnpm.
highlight:
    #!/usr/bin/env bash
    set -euo pipefail
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    echo '{"private":true}' > "$work/package.json"
    pnpm --dir "$work" --config.node-linker=hoisted add --ignore-scripts tree-sitter-bash@0.25.1 tree-sitter-javascript@0.23.1 tree-sitter-typescript@0.23.2
    grammars="$work/node_modules"
    # The TypeScript query includes the base JavaScript query via this literal path.
    mkdir -p "$grammars/tree-sitter-typescript/node_modules"
    ln -s ../../tree-sitter-javascript "$grammars/tree-sitter-typescript/node_modules/tree-sitter-javascript"
    zsc="$grammars/tree-sitter-zustscript"
    mkdir "$zsc"
    git -C "$(git rev-parse --show-toplevel)" archive 2ff5500ac8f1d7501d3cff646ee5c7b5cc24c4f1:editor/tree-sitter-zustscript | tar -x -C "$zsc"
    (cd "$zsc" && tree-sitter generate)
    python3 highlight.py "$work"
