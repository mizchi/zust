// ML-style kernels on F32Array (Float32Array in JS): f32x4 lanes; @simd(relaxed) adds relaxed SIMD (fused
// multiply-add, relaxed max). The same source runs as JS (--all-js) and through zustc (--no-simd).

// a dense layer: y = W x + b, W is m×n in rows
@simd export fn dense(w: F32Array, x: F32Array, b: F32Array, m: i32, n: i32) -> F32Array {
  range(0, m).map((r) => b[r] + range(0, n).fold(0.0, (s, i) => s + w[r * n + i] * x[i]))
}

// the same with relaxed SIMD: the products are fused into the sums (relaxed_madd)
@simd(relaxed) export fn dense_fma(w: F32Array, x: F32Array, b: F32Array, m: i32, n: i32) -> F32Array {
  range(0, m).map((r) => b[r] + range(0, n).fold(0.0, (s, i) => s + w[r * n + i] * x[i]))
}

@simd export fn relu(xs: F32Array) -> F32Array { xs.map((x) => x.max(0.0)) }

@simd(relaxed) export fn relu_relaxed(xs: F32Array) -> F32Array { xs.map((x) => x.max(0.0)) }

// y = a * x + y, fused under relaxed
@simd(relaxed) export fn saxpy(a: f32, xs: F32Array, ys: F32Array) -> F32Array {
  range(0, xs.len()).map((i) => a * xs[i] + ys[i])
}

@simd export fn sumsq(xs: F32Array) -> f32 { xs.fold(0.0, (acc, x) => acc + x * x) }

// the layer as the JS layer uses it
export fn mlp(w1: F32Array, b1: F32Array, w2: F32Array, b2: F32Array, x: F32Array, hidden: i32, inputs: i32, outputs: i32) -> F32Array {
  dense(w2, relu(dense(w1, x, b1, hidden, inputs)), b2, outputs, hidden)
}
