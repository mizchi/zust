// Regression cases from the review of mizchi/zust#31 (CodeRabbit): each function's expected value is in
// tests/examples.rs (`regressions`)

enum Option<T> { None, Some(T) }
enum Only { One }
type View = { node: Jsx }

// a match arm's binding with the subject's own name
pub fn unwrap_or(o: Option<i32>, d: i32) -> i32 {
  match o { Some(o) => o, None => d }
}

// shadowing in one block, a nested block, a block as a value
pub fn shadow() -> i32 {
  let x = 1;
  let x = x + 1;
  { let x = 10; };
  let y = { let x = 5; x * 2 };
  x + y
}

// a match whose only arm opens no `if`
pub fn only(o: Only) -> i32 {
  match o { One => 1 }
}

// a range's end read once, before the loop
pub fn range_end_once() -> i32 {
  let mut end = 3;
  let mut c = 0;
  for i in range(0, end) { end = 0; c += 1; }
  c
}

// precedence of a sum whose first operand is a call
pub fn prec(x: f64, y: f64, z: f64) -> f64 {
  (x.abs() + y) * z
}

// a callback expression evaluated once
fn adder(k: i32) -> fn(i32) -> i32 {
  (x) => x + k
}
pub fn add_all(xs: Array<i32>) -> Array<i32> {
  xs.map(adder(1))
}

// a generated temporary named like a parameter (the Rust of @wasm)
@wasm pub fn push_v(xs: Array<i32>, v: i32) -> Array<i32> {
  xs.push(v)
}

// a record with a Jsx field: the .d.ts imports ReactElement
pub fn view_of(v: View) -> i32 { 1 }

// a local named like a top-level function, in a flattened block (review of 248aa0d)
fn value() -> i32 { 7 }
pub fn shadow_fn() -> i32 {
  { let value = 1; };
  value()
}

// parentheses inside strings do not make a sum look like one call
fn n(s: String) -> f64 { 1.0 }
pub fn prec_str(z: f64) -> f64 {
  (n("(") + n(")")) * z
}

// a source name in the lowering's temporary namespace
@wasm pub fn push_zs(xs: Array<i32>, __zs_v: i32) -> Array<i32> {
  xs.push(__zs_v)
}

// a user type named like React's
type ReactElement = { value: i32 }
pub fn re(r: ReactElement) -> i32 { r.value }

// source names that differ only by the escape the lowering adds (the mapping stays injective)
@wasm pub fn zs_inj(__zs_x: i32, u__zs_x: i32) -> i32 {
  let uu__zs_y = __zs_x - u__zs_x;
  uu__zs_y
}

// a keyword and the same name with the escape's `_` stay distinct
@wasm pub fn kw_inj(async: i32, async_: i32) -> i32 {
  let move = async - async_;
  move
}

// a record field named like an escaped keyword crosses the wasm boundary both ways
type Kw = { async_: i32, move: i32 }
@wasm pub fn kw_rec(r: Kw) -> Kw {
  Kw { async_: r.move, move: r.async_ }
}

// a tail-resumptive handler runs as plain calls: many operations in one handle do not grow the stack
enum Tally { Count -> i32, Bump(i32) -> () }
fn bump_all(n: i32) -> i32 {
  for i in range(0, n) { perform Bump(i % 3); }
  perform Count
}
pub fn many_ops(n: i32) -> i32 {
  let mut c = 0;
  handle bump_all(n) {
    Count, k => k(c),
    Bump(v), k => { c = c + v; k(()) },
  }
}

// an operation named like an Object method finds the outer handler, not an inherited property
enum Obj { toString -> i32 }
enum Pings { Ping -> i32 }
fn ask() -> i32 { perform toString }
pub fn own_ops() -> i32 {
  handle (handle ask() { Ping, j => j(5) }) { toString, k => k(42) }
}

// an arm whose inner handler calls the outer continuation: both stay generators (the inner one suspends through k)
enum Outer { Op -> i32 }
enum Inner { Get -> i32 }
fn use_op() -> i32 { perform Op + 100 }
pub fn nested_k() -> i32 {
  handle use_op() {
    Op, k => handle { let g = perform Get; k(1 + g) } { Get, j => j(0) },
  }
}

// an operation named __proto__ is an arm of the table, not its prototype
enum Proto { __proto__ -> i32 }
fn ask_proto() -> i32 { perform __proto__ }
pub fn proto_op() -> i32 {
  handle ask_proto() { __proto__, k => k(7) }
}
