// Records read from a TS file (tests/ts/model.ts): `number` is f64, arrays are arrays, and a record a record uses
// (`Reply`) is read with it (tests/examples.rs: ts_records)
import type { User, Post, Point, Doc, Tile, Flag, Shelf, Esc, Par, Loc, Sur } from "./ts/model.ts";
import type { Cr } from "./ts/cr.ts";

pub fn display(u: User) -> String {
  let role = if u.admin { "admin" } else { "member" };
  u.name + " (" + role + ", #" + (u.id as i32).to_string() + ")"
}

pub fn summary(p: Post) -> String {
  let total = p.scores.fold(0.0, (s, x) => s + x);
  p.title + " by " + display(p.author) + ": " + p.replies.len().to_string() + " replies, score " + (total as i32).to_string()
}

pub fn promote(u: User) -> User { User { admin: true, tags: u.tags.push("staff"), ..u } }

pub fn reply(p: Post, by: User, text: String) -> Post {
  Post { replies: p.replies.push(Reply { by: by, text: text, tags: [], grid: [[1.0, 2.0], [3.0]] }), ..p }
}

// a type model.ts does not export, returned to TS
pub fn first_reply(p: Post) -> Reply { p.replies[0] }

pub fn same_user(a: User, b: User) -> bool { a == b }

// a TS record of numbers crosses to wasm like a zustscript one
@wasm pub fn dist(a: Point, b: Point) -> f64 {
  let dx = a.x - b.x;
  let dy = a.y - b.y;
  (dx * dx + dy * dy).sqrt()
}

// a TS record holding strings and arrays crosses to wasm as bytes (zustscript-helper / zustscript_helper)
@wasm pub fn badge(u: User) -> String { u.name.to_upper() + " #" + (u.id as i32).to_string() + " " + u.tags.join("+") }

// members separated by CR, U+2028 and U+2029 only (tests/ts/cr.ts)
pub fn cr(c: Cr) -> String { c.b + (c.a as i32).to_string() + (if c.c { "!" } else { "?" }) }

// unions read as enums (Status, Shape come with Doc): matched, built and compared in TS's own shape
pub fn label(s: Status) -> String { match s { Draft => "draft!", Published => "live" } }
pub fn area(s: Shape) -> f64 {
  match s {
    Circle(r) => 3.0 * r * r,
    Rect(w, h) => w * h,
  }
}
pub fn turn(s: Shape) -> Shape { match s { Circle(r) => Circle(r * 2.0), Rect(w, h) => Rect(h, w) } }
pub fn publish(d: Doc) -> Doc { Doc { status: Published, shapes: d.shapes.map(turn), ..d } }
pub fn total_area(d: Doc) -> f64 { d.shapes.fold(0.0, (a, s) => a + area(s)) }
pub fn same_shape(a: Shape, b: Shape) -> bool { a == b }
pub fn tile(t: Tile) -> f64 { match t { Square(s) => s, Empty => 0.0 } }
pub fn same_flag(a: Flag, b: Flag) -> bool { a == b }
pub fn item_of(s: Shelf) -> Item { s.item }
pub fn crates(s: Shelf) -> f64 { match s.item { Crate(n) => n, Nothing => 0.0 } }
pub fn esc(e: Esc) -> String { match e { Done => "d", Todo => "t" } }
pub fn par(p: Par) -> Par { match p { P => Q, Q => P } }
pub fn loc(l: Loc) -> i32 { match l { L1 => 1, L2 => 2 } }
pub fn sur(s: Sur) -> i32 { match s { Bc => 2, _ => 1 } }
pub fn sur_first() -> Sur { 𝒜a }

// unions read from TS cross to wasm as bytes, in TS's own shape (a union of strings, one with a tag field, a
// record holding both)
@wasm pub fn area_w(s: Shape) -> f64 { match s { Circle(r) => 3.0 * r * r, Rect(w, h) => w * h } }
@wasm pub fn label_w(s: Status) -> String { match s { Draft => "draft!", Published => "live" } }
@wasm pub fn publish_w(d: Doc) -> Doc { Doc { status: Published, shapes: d.shapes.map((s) => match s { Circle(r) => Circle(r * 2.0), Rect(w, h) => Rect(h, w) }), ..d } }
