// The JS layer's in-place push (src/own.rs: inplace_pushes) must never be seen through another reference
// (tests/examples.rs: js_push_in_place). Each result is what the copying push gives.

type Box = { v: Array<i32> }

fn keep(xs: Array<i32>) -> Array<i32> { xs }

// built in a loop: in place
pub fn ramp(n: i32) -> i32 {
  let mut acc = [];
  for i in range(0, n) {
    acc = acc.push(i);
  }
  acc.len()
}

// another name for the same array, still read after the push
pub fn aliased() -> i32 {
  let mut a = [1];
  let b = a;
  a = a.push(2);
  b.len() * 10 + a.len()
}

// the caller's array: never appended to
pub fn from_param(xs: Array<i32>) -> i32 {
  let mut a = xs;
  a = a.push(9);
  a.len()
}

// iterated while it grows: the loop sees the original elements only
pub fn iterate_and_grow() -> i32 {
  let mut a = [1, 2];
  for x in a {
    a = a.push(x);
  }
  a.len()
}

// stored in a record, or handed to a function that returns it, before the push
pub fn stored() -> i32 {
  let mut a = [1];
  let r = Box { v: a };
  a = a.push(2);
  let mut c = [1];
  let k = keep(c);
  c = c.push(2);
  r.v.len() * 100 + k.len() * 10 + a.len() + c.len()
}

// the old array is still read after a push into another local
pub fn other_local() -> i32 {
  let mut a = [1];
  let mut b = a.push(2);
  b = b.push(3);
  a.len() * 10 + b.len()
}

// concat in place, and the right operand of && that may not run
pub fn concat_and_short() -> i32 {
  let mut a = [1];
  a = a.concat([2, 3]);
  let mut b = [1];
  let ok = (b.push(2).len() == 0) && { b = [7]; true };
  a.len() * 10 + b.len()
}

// the left operand of == is held while the right one runs
pub fn compare_with_push() -> bool {
  let mut xs = [1];
  xs == xs.push(2)
}

// an argument that assigns the receiver
pub fn push_arg_assigns() -> i32 {
  let mut a = [1];
  a = a.push({ a = [7]; 2 });
  a.len()
}

// an alias made inside a JSX attribute
pub fn jsx_alias() -> i32 {
  let mut a = [1];
  let mut b = [];
  let view = <div id={{ b = a; 0 }} />;
  a = a.push(2);
  b.len()
}

type P = { x: i32, name: String }
// == by content, on the declared fields only (a value from TS may carry more)
pub fn same_p(a: P, b: P) -> bool { a == b }

fn one(x: i32) -> i32 { 1 }
fn two(x: i32) -> i32 { 2 }
// the callee is an expression that reads the array
pub fn computed_callee() -> i32 {
  let mut a = [1];
  a.push(2);
  (if a.len() == 1 { one } else { two })(0)
}

// a JSX element's parts are evaluated in the emitter's order (`key` after the props): no in-place push in them
pub fn jsx_key() -> Jsx {
  let mut a = [1];
  <div key={a.len()} id={a.push(2).len()} />
}

// handler arms are alternatives: an assignment in one does not end a read in another
enum Store { Read -> i32, Reset -> i32 }
pub fn handler_alternatives() -> i32 {
  let mut a = [1];
  handle {
    a.push(2);
    perform Read
  } {
    Read, k => k(a.len()),
    Reset, k => { a = [7]; k(0) },
  }
}

// a handler arm runs once per operation: an array from outside is not appended to in place there
enum Step { Tick -> i32 }
fn ticks() -> i32 { perform Tick + perform Tick }
pub fn handler_twice() -> i32 {
  let mut a = [1];
  handle ticks() {
    Tick, k => k(a.push(2).len()),
  }
}
