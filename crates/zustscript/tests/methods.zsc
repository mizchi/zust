// tests/examples.rs methods_same_in_js_and_wasm: `impl` blocks: methods (`self`), associated functions (`V2::new`),
// `Self`, a generic impl and one with a bound; a method as a value (`V2::len`). Lowered to Rust and run as wasm, and
// run as JS
type V2 = { x: f64, y: f64 }
impl V2 {
  fn new(x: f64, y: f64) -> Self { Self { x, y } }
  fn zero() -> V2 { V2::new(0.0, 0.0) }
  fn add(self, o: V2) -> V2 { V2 { x: self.x + o.x, y: self.y + o.y } }
  fn scale(self, k: f64) -> Self { Self { x: self.x * k, y: self.y * k } }
  fn len(self) -> f64 { (self.x * self.x + self.y * self.y).sqrt() }
}
enum Shape { Circle(V2, f64), Rect(V2, V2) }
impl Shape {
  fn area(self) -> f64 { match self { Circle(_, r) => 3.0 * r * r, Rect(a, b) => (b.x - a.x) * (b.y - a.y) } }
  fn moved(self, d: V2) -> Shape { match self { Circle(c, r) => Circle(c.add(d), r), Rect(a, b) => Rect(a.add(d), b.add(d)) } }
}
type Stack<T> = { items: Array<T> }
impl<T> Stack<T> {
  fn empty() -> Stack<T> { Stack { items: [] } }
  fn push(self, x: T) -> Stack<T> { Stack { items: self.items.push(x) } }
  fn peek(self) -> Option<T> { self.items.last() }
  fn size(self) -> i32 { self.items.len() }
}
impl<T: Eq> Stack<T> {
  fn has(self, x: T) -> bool { self.items.includes(x) }
}
@wasm export fn run() -> Array<f64> {
  let v = V2::new(3.0, 4.0).add(V2::zero()).scale(2.0);
  let s = Rect(V2::zero(), V2::new(2.0, 3.0)).moved(V2::new(1.0, 1.0));
  let st = Stack::empty().push(1).push(2);
  [v.len(), s.area(), Circle(V2::zero(), 1.0).area(), st.size() as f64, match st.peek() { Some(n) => n as f64, None => -1.0 }, if st.has(1) { 1.0 } else { 0.0 }]
}
export fn js_run() -> String {
  let st = Stack::empty().push("a").push("b");
  let s2 = V2::new(1.0, 1.0).scale(3.0);
  `${st.size()} ${st.peek().unwrap_or("-")} ${st.has("a")} ${s2.x} ${[V2::new(1.0, 0.0), V2::new(0.0, 2.0)].map((v) => v.len()).fold(0.0, (a, b) => a + b)}`
}
export fn as_value(vs: Array<V2>) -> f64 { vs.map(V2::len).fold(0.0, (a, b) => a + b) }
