// tests/examples.rs stdlib_same_in_js_and_wasm: the standard library (arrays, strings, numbers), lowered to Rust and run
// as wasm, and run as JS (--all-js): the same results
type P = { name: String, age: i32 }
fn opt(o: Option<i32>) -> i32 { match o { Some(n) => n, None => -1 } }
fn sopt(o: Option<P>) -> String { match o { Some(p) => p.name, None => "-" } }
@wasm export fn arrays(xs: Array<i32>) -> Array<i32> {
  let ps = [P { name: "bo", age: 30 }, P { name: "ann", age: 25 }, P { name: "cy", age: 30 }];
  let a = [opt(xs.get(1)), opt(xs.get(99)), opt(xs.get(-1)), opt(xs.first()), opt(xs.last()), if xs.is_empty() { 1 } else { 0 }];
  let b = xs.slice(1, 3).concat(xs.slice(-2, 100)).concat(xs.reverse()).concat(xs.sort());
  let c = [if xs.includes(8) { 1 } else { 0 }, if ps.includes(P { name: "ann", age: 25 }) { 1 } else { 0 }, opt(ps.index_of(P { name: "cy", age: 30 })), opt(xs.index_of(9)), opt(xs.find((n) => n > 4)), opt(xs.find_index((n) => n > 4)), opt(ps.find_index((p) => p.age < 20))];
  let d = xs.flat_map((n) => [n, n * 10]);
  let e = ps.sort_by((p, q) => if p.age != q.age { p.age - q.age } else if p.name < q.name { -1 } else { 1 }).map((p) => p.name.len());
  a.concat(b).concat(c).concat(d).concat(e)
}
@wasm export fn names() -> Array<String> {
  let ps = [P { name: "bo", age: 30 }, P { name: "ann", age: 25 }];
  [sopt(ps.find((p) => p.age < 28)), sopt(ps.find((p) => p.age > 40)), sopt(ps.get(0)), sopt(ps.last())].concat(["b", "a", "C", "aa", "😀", "\u{ff61}"].sort()).concat(ps.map((p) => p.name).reverse())
}
@wasm export fn strings(s: String) -> Array<String> {
  let ix = [s.index_of("o"), s.index_of("z"), s.index_of("")].map((o) => opt(o).to_string());
  [if s.is_empty() { "e" } else { "n" }, s.to_lower(), if s.starts_with("He") { "y" } else { "n" }, if s.ends_with("d") { "y" } else { "n" }, s.slice(1, 6), s.slice(-3, 100), s.slice(5, 2), s.replace("l", "L"), "ab".replace("", "-"), "ab".repeat(3), s.trim_start(), s.trim_end(), s.chars().join("|")].concat(ix)
}
@wasm export fn parse(xs: Array<String>) -> Array<String> {
  xs.map((x) => match x.to_i32() { Some(v) => v.to_string(), None => "none" })
}
@wasm export fn parsef(xs: Array<String>) -> Array<f64> {
  xs.map((x) => match x.to_f64() { Some(v) => v, None => -12345.0 })
}
@wasm export fn floats(x: f64) -> Array<f64> {
  [x.pow(2.5), x.ceil(), x.trunc(), x.exp(), x.ln(), x.log10(), x.log2(), x.sin(), x.cos(), x.tan(), (x / 10.0).asin(), (x / 10.0).acos(), x.atan(), x.atan2(1.5), if x.is_nan() { 1.0 } else { 0.0 }, (x as f32).sin() as f64, (x as f32).pow(1.5) as f64]
}
@wasm export fn ints(i: i32) -> Array<i32> {
  [i.abs(), i.min(3), i.max(3), i.pow(3), (2).pow(31), (-2147483647 - 1).abs()]
}
@wasm export fn bigs(i: i64) -> Array<i64> { [i.abs(), i.min(2), i.max(2), i.pow(41)] }
