
pub struct PanicInfo {
    _private: u8,
}

unsafe extern "C" {
    #[link_name = "malloc"]
    fn __exr_malloc(size: usize) -> *mut u8;
}
unsafe extern "C" {
    #[link_name = "free"]
    fn __exr_free(p: *mut u8);
}
fn __exr_drop_in_place<T>(p: *mut T) {}
pub trait Drop {
    fn drop(&mut self);
}
pub fn __core_drop<T>(_x: T) {}
// `std::hint::black_box(x)`: 値をそのまま返す (最適化はしないので何もしなくてよい)
// `std::hint::spin_loop()`: a hint to the processor in a busy-wait loop; nothing to do here
pub fn __core_spin_loop() {}
pub fn __core_black_box<T>(x: T) -> T {
    x
}

// 関数ポインタを `dyn Fn` にするときの vtable の中身 (データは関数ポインタを置いた場所)
fn __exr_fnptr0<R>(f: &fn() -> R) -> R {
    (*f)()
}
fn __exr_fnptr1<A, R>(f: &fn(A) -> R, a: A) -> R {
    (*f)(a)
}
fn __exr_fnptr2<A, B, R>(f: &fn(A, B) -> R, a: A, b: B) -> R {
    (*f)(a, b)
}
fn __exr_fnptr3<A, B, C, R>(f: &fn(A, B, C) -> R, a: A, b: B, c: C) -> R {
    (*f)(a, b, c)
}

// core::cmp / core::mem / core::ptr の関数。ユーザが同じ名前の関数を定義してもぶつからないよう
// `__core_` を付けて置き、`core::cmp::max` などのパス (と未定義の名前) からだけ引く
pub fn __core_min<T: Ord + Copy>(a: T, b: T) -> T {
    if b < a { b } else { a }
}
pub fn __core_max<T: Ord + Copy>(a: T, b: T) -> T {
    if b < a { a } else { b }
}
pub fn __core_swap<T>(a: &mut T, b: &mut T) {
    unsafe {
        let pa = a as *mut T;
        let pb = b as *mut T;
        let t = pa.read();
        pa.write(pb.read());
        pb.write(t);
    }
}
pub fn __core_replace<T>(dest: &mut T, src: T) -> T {
    unsafe {
        let p = dest as *mut T;
        let old = p.read();
        p.write(src);
        old
    }
}
pub fn __core_take<T>(dest: &mut T) -> T {
    __core_replace(dest, __exr_default::<T>())
}
// `ptr::from_ref(r)` / `ptr::from_mut(r)`: the reference as a raw pointer
pub fn __core_from_ref<T: ?Sized>(r: &T) -> *const T {
    r as *const T
}
pub fn __core_from_mut<T: ?Sized>(r: &mut T) -> *mut T {
    r as *mut T
}
// `slice::from_ref(r)` / `slice::from_mut(r)`: a slice of the one value (looked up as `slice_from_ref`, as
// `ptr::from_ref` is the `from_ref` above)
pub fn __core_slice_from_ref<T>(r: &T) -> &[T] {
    unsafe { core::slice::from_raw_parts(r as *const T, 1) }
}
pub fn __core_slice_from_mut<T>(r: &mut T) -> &mut [T] {
    unsafe { core::slice::from_raw_parts_mut(r as *mut T, 1) }
}
// `mem::discriminant(&e)`: the variant's tag, compared / hashed / printed as a number
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct Discriminant<T> {
    d: u64,
    _p: PhantomData<T>,
}
impl<T> Debug for Discriminant<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        write!(f, "Discriminant({})", self.d)
    }
}
pub fn __core_discriminant<T>(v: &T) -> Discriminant<T> {
    Discriminant { d: __exr_tag_of(v), _p: PhantomData }
}
// `std::array::from_fn(|i| ..)`: N from the expected array type
pub fn __exr_array_from_fn<T, const N: usize, F: FnMut(usize) -> T>(mut f: F) -> [T; N] {
    let mut a: [T; N] = unsafe { core::mem::zeroed() };
    let p = &mut a as *mut [T; N] as *mut T;
    let mut i = 0;
    while i < N {
        unsafe { p.add(i).write(f(i)) };
        i += 1;
    }
    a
}
pub fn __core_forget<T>(x: T) {
    let _m = ManuallyDrop::new(x);
}
pub unsafe fn __core_transmute<T, U>(x: T) -> U {
    let m = ManuallyDrop::new(x);
    unsafe { (&m as *const ManuallyDrop<T> as *const U).read() }
}
pub unsafe fn __core_transmute_copy<T, U>(x: &T) -> U {
    unsafe { (x as *const T as *const U).read() }
}
pub fn __core_size_of_val<T>(_x: &T) -> usize {
    core::mem::size_of::<T>()
}
pub fn __core_align_of_val<T>(_x: &T) -> usize {
    core::mem::align_of::<T>()
}
pub unsafe fn __core_drop_in_place<T>(p: *mut T) {
    unsafe { __core_drop(p.read()) }
}
pub unsafe fn __core_read_unaligned<T>(p: *const T) -> T {
    unsafe { p.read() }
}
pub unsafe fn __core_write_unaligned<T>(p: *mut T, v: T) {
    unsafe { p.write(v) }
}
pub unsafe fn __core_uninitialized<T>() -> T {
    unsafe { core::mem::zeroed::<T>() }
}
// (one thread: there is nothing to wait for)
pub fn __core_sleep_ms(_ms: u32) {}
// (`std::future::ready(x)`: futures run at once, so it is the value)
pub fn __core_ready<T>(x: T) -> T {
    x
}
pub unsafe fn __core_read<T>(p: *const T) -> T {
    unsafe { p.read() }
}
pub unsafe fn __core_write<T>(p: *mut T, v: T) {
    unsafe { p.write(v) }
}
// (`ptr::swap`: of two raw pointers, which may be the same. Not `mem::swap`'s two `&mut`, which the borrow check
// would take for two unique borrows (`ptr::swap(test, test)`))
pub unsafe fn __core_ptr_swap<T>(a: *mut T, b: *mut T) {
    unsafe {
        let t = a.read();
        a.write(b.read());
        b.write(t);
    }
}
// `T::default()` / `Default::default()` / derive(Default): 本体は型ごとに codegen が作る
// (0 で埋めてから、手書きの impl Default を持つフィールドはそれを呼ぶ)
fn __exr_default<T>() -> T {
    loop {}
}
pub unsafe fn __core_read_volatile<T: Copy>(p: *const T) -> T {
    unsafe { *p }
}
pub unsafe fn __core_write_volatile<T: Copy>(p: *mut T, v: T) {
    unsafe {
        *p = v;
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub enum Option<T> {
    None,
    Some(T),
}

// `o.iter()` / `o.into_iter()`: 中身が 0 個か 1 個のイテレータ
pub struct OptIter<T> {
    v: Option<T>,
}

impl<T> Iterator for OptIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        self.v.take()
    }
}

impl<T> Option<T> {
    pub fn iter(&self) -> OptIter<&T> {
        OptIter { v: self.as_ref() }
    }
    pub fn into_iter(self) -> OptIter<T> {
        OptIter { v: self }
    }
    pub fn unwrap_or_default(self) -> T {
        match self {
            Some(x) => x,
            None => __exr_default::<T>(),
        }
    }
    pub fn as_deref<G>(&self) -> Option<&str>
    where
        T: __AsStr,
    {
        match self {
            Some(x) => Some(x.__as_str()),
            None => None,
        }
    }
    pub fn expect(self, msg: &str) -> T {
        match self {
            Some(x) => x,
            None => panic!("{}", msg),
        }
    }
    pub fn __flat_prep(&mut self) {}
    pub fn __flat_next(&mut self) -> Option<T> {
        self.take()
    }
    pub fn zip<U>(self, o: Option<U>) -> Option<(T, U)> {
        match (self, o) {
            (Some(a), Some(b)) => Some((a, b)),
            _ => None,
        }
    }
    pub fn map_or_else<U, D: FnOnce() -> U, F: FnOnce(T) -> U>(self, d: D, f: F) -> U {
        match self {
            Some(x) => f(x),
            None => d(),
        }
    }
    pub fn or_else<F: FnOnce() -> Option<T>>(self, f: F) -> Option<T> {
        match self {
            Some(x) => Some(x),
            None => f(),
        }
    }
    pub fn and<U>(self, o: Option<U>) -> Option<U> {
        match self {
            Some(_) => o,
            None => None,
        }
    }
    pub fn get_or_insert_with<F: FnOnce() -> T>(&mut self, f: F) -> &mut T {
        if self.is_none() {
            *self = Some(f());
        }
        match self {
            Some(x) => x,
            None => panic!("unreachable"),
        }
    }
    pub fn insert(&mut self, v: T) -> &mut T {
        *self = Some(v);
        match self {
            Some(x) => x,
            None => panic!("unreachable"),
        }
    }
    pub fn is_none_or<F: FnOnce(T) -> bool>(self, f: F) -> bool {
        match self {
            Some(x) => f(x),
            None => true,
        }
    }
    pub fn is_some(&self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }
    pub fn is_none(&self) -> bool {
        match self {
            Some(_) => false,
            None => true,
        }
    }
    pub fn unwrap(self) -> T {
        match self {
            Some(v) => v,
            None => panic!("called `Option::unwrap()` on a `None` value"),
        }
    }
    // (undefined behavior on None in rustc: a panic here)
    pub unsafe fn unwrap_unchecked(self) -> T {
        match self {
            Some(v) => v,
            None => panic!("called `Option::unwrap_unchecked()` on a `None` value"),
        }
    }
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Some(v) => v,
            None => default,
        }
    }
    pub fn ok_or<E>(self, err: E) -> Result<T, E> {
        match self {
            Some(v) => Ok(v),
            None => Err(err),
        }
    }
    pub fn or(self, other: Option<T>) -> Option<T> {
        match self {
            Some(v) => Some(v),
            None => other,
        }
    }
    pub fn xor(self, other: Option<T>) -> Option<T> {
        match self {
            Some(v) => match other {
                Some(_) => None,
                None => Some(v),
            },
            None => other,
        }
    }
    // 中身を drop せずに入れ替える (生ポインタの read / write は drop しない)
    pub fn take(&mut self) -> Option<T> {
        let p = self as *mut Option<T>;
        unsafe {
            let v = p.read();
            p.write(None);
            v
        }
    }
    pub fn replace(&mut self, value: T) -> Option<T> {
        let p = self as *mut Option<T>;
        unsafe {
            let v = p.read();
            p.write(Some(value));
            v
        }
    }
    pub fn as_ref(&self) -> Option<&T> {
        match self {
            Some(v) => Some(v),
            None => None,
        }
    }
    pub fn as_mut(&mut self) -> Option<&mut T> {
        match self {
            Some(v) => Some(v),
            None => None,
        }
    }
    pub fn map<U, F: FnOnce(T) -> U>(self, f: F) -> Option<U> {
        match self {
            Some(v) => Some(f(v)),
            None => None,
        }
    }
    pub fn and_then<U, F: FnOnce(T) -> Option<U>>(self, f: F) -> Option<U> {
        match self {
            Some(v) => f(v),
            None => None,
        }
    }
    pub fn unwrap_or_else<F: FnOnce() -> T>(self, f: F) -> T {
        match self {
            Some(v) => v,
            None => f(),
        }
    }
    pub fn map_or<U, F: FnOnce(T) -> U>(self, default: U, f: F) -> U {
        match self {
            Some(v) => f(v),
            None => default,
        }
    }
    pub fn is_some_and<F: FnOnce(T) -> bool>(self, f: F) -> bool {
        match self {
            Some(v) => f(v),
            None => false,
        }
    }
    pub fn inspect<F: FnOnce(&T)>(self, f: F) -> Option<T> {
        if let Some(v) = &self {
            f(v);
        }
        self
    }
    pub fn filter<P: FnOnce(&T) -> bool>(self, p: P) -> Option<T> {
        match self {
            Some(v) => {
                if p(&v) {
                    Some(v)
                } else {
                    None
                }
            }
            None => None,
        }
    }
    pub fn ok_or_else<E, F: FnOnce() -> E>(self, f: F) -> Result<T, E> {
        match self {
            Some(v) => Ok(v),
            None => Err(f()),
        }
    }
}

impl<T> Option<&T> {
    pub fn copied(self) -> Option<T> {
        match self {
            Some(v) => Some(*v),
            None => None,
        }
    }
}

impl<T: Clone> Option<&T> {
    pub fn cloned(self) -> Option<T> {
        match self {
            Some(v) => Some(v.clone()),
            None => None,
        }
    }
}

impl<T> Option<Option<T>> {
    pub fn flatten(self) -> Option<T> {
        match self {
            Some(inner) => inner,
            None => None,
        }
    }
}

// `x.clone()` (derive(Clone) / タプル / 配列 / 整数など): 本体は型ごとに codegen が作る (フィールドごとに clone)
fn __exr_clone<T>(x: &T) -> T {
    unsafe { (x as *const T).read() }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    // (`for x in r`: the value of Ok, or none)
    pub fn iter(&self) -> OptIter<&T> {
        OptIter { v: self.as_ref().ok() }
    }
    pub fn into_iter(self) -> OptIter<T> {
        OptIter { v: self.ok() }
    }
    pub fn unwrap_or_default(self) -> T {
        match self {
            Ok(x) => x,
            Err(_) => __exr_default::<T>(),
        }
    }
    pub fn expect(self, msg: &str) -> T {
        match self {
            Ok(x) => x,
            Err(e) => panic!("{}: {:?}", msg, e),
        }
    }
    pub fn is_ok_and<F: FnOnce(T) -> bool>(self, f: F) -> bool {
        match self {
            Ok(x) => f(x),
            Err(_) => false,
        }
    }
    pub fn inspect<F: FnOnce(&T)>(self, f: F) -> Result<T, E> {
        if let Ok(v) = &self {
            f(v);
        }
        self
    }
    pub fn inspect_err<F: FnOnce(&E)>(self, f: F) -> Result<T, E> {
        if let Err(e) = &self {
            f(e);
        }
        self
    }
    pub fn is_err_and<F: FnOnce(E) -> bool>(self, f: F) -> bool {
        match self {
            Ok(_) => false,
            Err(e) => f(e),
        }
    }
    pub fn map_or<U, F: FnOnce(T) -> U>(self, d: U, f: F) -> U {
        match self {
            Ok(x) => f(x),
            Err(_) => d,
        }
    }
    pub fn or_else<F2, O: FnOnce(E) -> Result<T, F2>>(self, o: O) -> Result<T, F2> {
        match self {
            Ok(x) => Ok(x),
            Err(e) => o(e),
        }
    }
    pub fn is_ok(&self) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }
    pub fn is_err(&self) -> bool {
        match self {
            Ok(_) => false,
            Err(_) => true,
        }
    }
    pub fn unwrap(self) -> T {
        match self {
            Ok(v) => v,
            Err(e) => panic!("called `Result::unwrap()` on an `Err` value: {:?}", e),
        }
    }
    // (undefined behavior on Err in rustc: a panic here)
    pub unsafe fn unwrap_unchecked(self) -> T {
        match self {
            Ok(v) => v,
            Err(_) => panic!("called `Result::unwrap_unchecked()` on an `Err` value"),
        }
    }
    pub fn unwrap_err(self) -> E {
        match self {
            Ok(_) => panic!("called `Result::unwrap_err()` on an `Ok` value"),
            Err(e) => e,
        }
    }
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Ok(v) => v,
            Err(_) => default,
        }
    }
    pub fn as_ref(&self) -> Result<&T, &E> {
        match self {
            Ok(x) => Ok(x),
            Err(e) => Err(e),
        }
    }
    pub fn ok(self) -> Option<T> {
        match self {
            Ok(v) => Some(v),
            Err(_) => None,
        }
    }
    pub fn err(self) -> Option<E> {
        match self {
            Ok(_) => None,
            Err(e) => Some(e),
        }
    }
    pub fn map<U, F: FnOnce(T) -> U>(self, f: F) -> Result<U, E> {
        match self {
            Ok(v) => Ok(f(v)),
            Err(e) => Err(e),
        }
    }
    pub fn map_err<G, F: FnOnce(E) -> G>(self, f: F) -> Result<T, G> {
        match self {
            Ok(v) => Ok(v),
            Err(e) => Err(f(e)),
        }
    }
    pub fn and_then<U, F: FnOnce(T) -> Result<U, E>>(self, f: F) -> Result<U, E> {
        match self {
            Ok(v) => f(v),
            Err(e) => Err(e),
        }
    }
    pub fn unwrap_or_else<F: FnOnce(E) -> T>(self, f: F) -> T {
        match self {
            Ok(v) => v,
            Err(e) => f(e),
        }
    }
}
// --- Vec<T> / String (alloc の代わり。libc の realloc / free を使う) -------------------------

unsafe extern "C" {
    #[link_name = "realloc"]
    fn __exr_realloc(p: *mut u8, size: usize) -> *mut u8;
}

unsafe extern "C" {
    #[link_name = "abort"]
    fn __exr_abort();
}

// `realloc` that does not return null: when the allocation fails, the program stops as std's handle_alloc_error
// does (a message, then abort). (realloc(p, 0) may give null: that is not a failure)
unsafe fn __exr_realloc_ok(p: *mut u8, size: usize) -> *mut u8 {
    let q = unsafe { __exr_realloc(p, size) };
    if q.is_null() && size != 0 {
        __exr_err_str::<()>("memory allocation failed\n");
        unsafe { __exr_abort() };
    }
    q
}

unsafe extern "C" {
    #[link_name = "memset"]
    fn __exr_memset(d: *mut u8, c: i32, n: usize) -> *mut u8;
}

unsafe extern "C" {
    #[link_name = "memcpy"]
    fn __exr_memcpy(d: *mut u8, s: *const u8, n: usize) -> *mut u8;
}

unsafe extern "C" {
    #[link_name = "memmove"]
    fn __exr_memmove(d: *mut u8, s: *const u8, n: usize) -> *mut u8;
}

// `std::ptr::copy_nonoverlapping` / `copy` / `write_bytes`: count values of T
pub unsafe fn __core_copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {
    unsafe { __exr_memcpy(dst as *mut u8, src as *const u8, count * core::mem::size_of::<T>()) };
}
pub unsafe fn __core_copy<T>(src: *const T, dst: *mut T, count: usize) {
    unsafe { __exr_memmove(dst as *mut u8, src as *const u8, count * core::mem::size_of::<T>()) };
}
pub unsafe fn __core_write_bytes<T>(dst: *mut T, val: u8, count: usize) {
    unsafe { __exr_memset(dst as *mut u8, val as i32, count * core::mem::size_of::<T>()) };
}

// `core::alloc::Layout`: a size and a power-of-two alignment, the size rounded up to the alignment at most isize::MAX
// (what std's constructors check). (`\x4c` in the texts: a program's own `Layout` renames this one's, word by word)
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct Layout {
    __l_size: usize,
    __l_align: usize,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct LayoutError;

pub type LayoutErr = LayoutError;

impl Layout {
    pub const fn from_size_align(size: usize, align: usize) -> Result<Layout, LayoutError> {
        if align == 0 || align & (align - 1) != 0 || size > isize::MAX as usize - (align - 1) {
            return Err(LayoutError);
        }
        Ok(Layout { __l_size: size, __l_align: align })
    }
    pub const unsafe fn from_size_align_unchecked(size: usize, align: usize) -> Layout {
        Layout { __l_size: size, __l_align: align }
    }
    pub const fn new<T>() -> Layout {
        Layout { __l_size: core::mem::size_of::<T>(), __l_align: core::mem::align_of::<T>() }
    }
    pub fn for_value<T>(t: &T) -> Layout {
        Layout { __l_size: core::mem::size_of_val(t), __l_align: core::mem::align_of_val(t) }
    }
    pub fn array<T>(n: usize) -> Result<Layout, LayoutError> {
        match core::mem::size_of::<T>().checked_mul(n) {
            Some(size) => Layout::from_size_align(size, core::mem::align_of::<T>()),
            None => Err(LayoutError),
        }
    }
    pub const fn size(&self) -> usize {
        self.__l_size
    }
    pub const fn align(&self) -> usize {
        self.__l_align
    }
    pub const fn pad_to_align(&self) -> Layout {
        let m = self.__l_align - 1;
        Layout { __l_size: (self.__l_size + m) & !m, __l_align: self.__l_align }
    }
    pub fn align_to(&self, align: usize) -> Result<Layout, LayoutError> {
        if align == 0 || align & (align - 1) != 0 {
            return Err(LayoutError);
        }
        Layout::from_size_align(self.__l_size, if align > self.__l_align { align } else { self.__l_align })
    }
    pub fn extend(&self, next: Layout) -> Result<(Layout, usize), LayoutError> {
        let m = next.__l_align - 1;
        let offset = (self.__l_size + m) & !m;
        let align = if next.__l_align > self.__l_align { next.__l_align } else { self.__l_align };
        match offset.checked_add(next.__l_size) {
            Some(size) => match Layout::from_size_align(size, align) {
                Ok(l) => Ok((l, offset)),
                Err(e) => Err(e),
            },
            None => Err(LayoutError),
        }
    }
}

// (std's Debug of the alignment: `8 (1 << 3)`)
struct __LayoutAlign(usize);

impl Debug for __LayoutAlign {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        write!(f, "{} (1 << {})", self.0, self.0.trailing_zeros())
    }
}

impl Debug for Layout {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.debug_struct("\x4cayout").field("size", &self.__l_size).field("align", &__LayoutAlign(self.__l_align)).finish()
    }
}

impl Display for LayoutError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.pad("invalid parameters to \x4cayout::from_size_align")
    }
}

unsafe extern "C" {
    #[link_name = "aligned_alloc"]
    fn __exr_aligned_alloc(align: usize, size: usize) -> *mut u8;
}

unsafe extern "C" {
    #[link_name = "calloc"]
    fn __exr_calloc(n: usize, size: usize) -> *mut u8;
}

// `std::alloc::alloc` / `alloc_zeroed` / `realloc` / `dealloc`: libc's allocator, which Box and Vec use too (malloc's
// blocks are aligned to 16; aligned_alloc for a larger alignment). A failure is a null pointer, as std's
pub unsafe fn __core_alloc(layout: Layout) -> *mut u8 {
    let a = layout.__l_align;
    unsafe {
        if a <= 16 {
            __exr_malloc(layout.__l_size)
        } else {
            __exr_aligned_alloc(a, (layout.__l_size + a - 1) & !(a - 1))
        }
    }
}
pub unsafe fn __core_alloc_zeroed(layout: Layout) -> *mut u8 {
    if layout.__l_align <= 16 {
        return unsafe { __exr_calloc(1, layout.__l_size) };
    }
    let p = unsafe { __core_alloc(layout) };
    if !p.is_null() {
        unsafe { __exr_memset(p, 0, layout.__l_size) };
    }
    p
}
pub unsafe fn __core_realloc(ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
    if layout.__l_align <= 16 {
        return unsafe { __exr_realloc(ptr, new_size) };
    }
    let q = unsafe { __core_alloc(Layout { __l_size: new_size, __l_align: layout.__l_align }) };
    if !q.is_null() {
        let n = if new_size < layout.__l_size { new_size } else { layout.__l_size };
        unsafe {
            __exr_memcpy(q, ptr as *const u8, n);
            __exr_free(ptr);
        }
    }
    q
}
pub unsafe fn __core_dealloc(ptr: *mut u8, _layout: Layout) {
    unsafe { __exr_free(ptr) };
}
// (std's message, then abort)
pub fn __core_handle_alloc_error(layout: Layout) -> ! {
    __exr_err_str::<()>("memory allocation of ");
    __exr_err_num::<()>(layout.__l_size as u64);
    __exr_err_str::<()>(" bytes failed\n");
    unsafe { __exr_abort() };
    loop {}
}

// The capacity `Vec::reserve` grows to (twice the old one, or what is needed), or a panic when it does not fit:
// len + extra past usize, or a block past isize::MAX bytes (as std). (Not generic: checked and compiled once,
// not per element type)
fn __exr_vec_new_cap(len: usize, cap: usize, extra: usize, sz: usize) -> usize {
    if extra > usize::MAX - len {
        panic!("capacity overflow");
    }
    let need = len + extra;
    let mut c = if cap == 0 { 4 } else if cap > usize::MAX / 2 { usize::MAX } else { cap * 2 };
    if c < need {
        c = need;
    }
    if sz != 0 && c > isize::MAX as usize / sz {
        if need > isize::MAX as usize / sz {
            panic!("capacity overflow");
        }
        c = need;
    }
    c
}

pub struct Vec<T> {
    ptr: *mut T,
    cap: usize,
    len: usize,
}

impl<T> Vec<T> {
    pub fn new() -> Vec<T> {
        Vec {
            ptr: core::ptr::null_mut(),
            cap: 0,
            len: 0,
        }
    }
    pub fn with_capacity(n: usize) -> Vec<T> {
        let mut v = Vec::new();
        v.reserve(n);
        v
    }
    pub fn reserve(&mut self, extra: usize) {
        // (len <= cap: `len + extra` is not computed unless it fits)
        if extra <= self.cap - self.len {
            return;
        }
        let sz = core::mem::size_of::<T>();
        let c = __exr_vec_new_cap(self.len, self.cap, extra, sz);
        let bytes = if sz == 0 { 1 } else { c * sz };
        self.ptr = unsafe { __exr_realloc_ok(self.ptr as *mut u8, bytes) } as *mut T;
        self.cap = c;
    }
    pub fn try_reserve(&mut self, extra: usize) -> Result<(), TryReserveError> {
        self.reserve(extra);
        Ok(())
    }
    pub fn try_reserve_exact(&mut self, extra: usize) -> Result<(), TryReserveError> {
        self.reserve(extra);
        Ok(())
    }
    pub fn push(&mut self, x: T) {
        if self.len == self.cap {
            self.reserve(1);
        }
        unsafe {
            self.ptr.add(self.len).write(x);
        }
        self.len += 1;
    }
    pub fn pop(&mut self) -> Option<T> {
        if self.len == 0 {
            None
        } else {
            self.len -= 1;
            unsafe { Some(self.ptr.add(self.len).read()) }
        }
    }
    pub fn len(&self) -> usize {
        self.len
    }
    pub fn is_empty(&self) -> bool {
        self.len == 0
    }
    pub fn capacity(&self) -> usize {
        self.cap
    }
    pub fn truncate(&mut self, n: usize) {
        // (drop の要らない要素 (`Vec<u8>` など) は長さを変えるだけ)
        if !core::mem::needs_drop::<T>() {
            if n < self.len {
                self.len = n;
            }
            return;
        }
        while self.len > n {
            self.len -= 1;
            unsafe {
                __exr_drop_in_place(self.ptr.add(self.len));
            }
        }
    }
    pub fn clear(&mut self) {
        self.truncate(0);
    }
    pub fn get(&self, i: usize) -> Option<&T> {
        if i < self.len {
            unsafe { Some(&*self.ptr.add(i)) }
        } else {
            None
        }
    }
    pub fn get_mut(&mut self, i: usize) -> Option<&mut T> {
        if i < self.len {
            unsafe { Some(&mut *self.ptr.add(i)) }
        } else {
            None
        }
    }
    pub fn first(&self) -> Option<&T> {
        self.get(0)
    }
    pub fn last(&self) -> Option<&T> {
        if self.len == 0 { None } else { self.get(self.len - 1) }
    }
    pub fn insert(&mut self, i: usize, x: T) {
        if i > self.len {
            panic!("insertion index is out of bounds");
        }
        if self.len == self.cap {
            self.reserve(1);
        }
        let mut j = self.len;
        while j > i {
            unsafe {
                self.ptr.add(j).write(self.ptr.add(j - 1).read());
            }
            j -= 1;
        }
        unsafe {
            self.ptr.add(i).write(x);
        }
        self.len += 1;
    }
    pub fn remove(&mut self, i: usize) -> T {
        if i >= self.len {
            panic!("removal index is out of bounds");
        }
        let x = unsafe { self.ptr.add(i).read() };
        let mut j = i;
        while j + 1 < self.len {
            unsafe {
                self.ptr.add(j).write(self.ptr.add(j + 1).read());
            }
            j += 1;
        }
        self.len -= 1;
        x
    }
    pub fn swap_remove(&mut self, i: usize) -> T {
        if i >= self.len {
            panic!("swap_remove index is out of bounds");
        }
        let x = unsafe { self.ptr.add(i).read() };
        self.len -= 1;
        if i != self.len {
            unsafe {
                self.ptr.add(i).write(self.ptr.add(self.len).read());
            }
        }
        x
    }
    pub fn swap(&mut self, a: usize, b: usize) {
        if a >= self.len || b >= self.len {
            panic!("index out of bounds");
        }
        unsafe {
            let x = self.ptr.add(a).read();
            let y = self.ptr.add(b).read();
            self.ptr.add(a).write(y);
            self.ptr.add(b).write(x);
        }
    }
    pub fn reverse(&mut self) {
        let mut i = 0;
        while i + 1 < self.len - i {
            let j = self.len - 1 - i;
            self.swap(i, j);
            i += 1;
        }
    }
    // 3 回の反転で回す
    pub fn rotate_left(&mut self, k: usize) {
        let n = self.len;
        // (as std: a count past the length is a caller's error, not taken modulo the length)
        if k > n {
            panic!("assertion failed: mid <= self.len()");
        }
        if n == 0 {
            return;
        }
        let k = k % n;
        self.__rev_range(0, k);
        self.__rev_range(k, n);
        self.__rev_range(0, n);
    }
    pub fn rotate_right(&mut self, k: usize) {
        let n = self.len;
        if k > n {
            panic!("assertion failed: k <= self.len()");
        }
        if n == 0 {
            return;
        }
        self.rotate_left(n - k % n);
    }
    fn __rev_range(&mut self, a: usize, b: usize) {
        let mut i = a;
        let mut j = b;
        while i + 1 < j {
            j -= 1;
            self.swap(i, j);
            i += 1;
        }
    }
    pub fn split_at(&self, mid: usize) -> (&[T], &[T]) {
        if mid > self.len {
            panic!("mid > len");
        }
        unsafe {
            (
                core::slice::from_raw_parts(self.ptr, mid),
                core::slice::from_raw_parts(self.ptr.add(mid), self.len - mid),
            )
        }
    }
    pub fn append(&mut self, other: &mut Vec<T>) {
        self.reserve(other.len);
        let mut i = 0;
        while i < other.len {
            unsafe {
                self.ptr.add(self.len + i).write(other.ptr.add(i).read());
            }
            i += 1;
        }
        self.len += other.len;
        other.len = 0;
    }
    // `v.extend(it)`。イテレータでない引数 (Vec / 配列 / 参照) は codegen が into_iter / iter にする
    pub fn extend<I: Iterator<Item = T>>(&mut self, it: I) {
        let mut it = it;
        while let Some(x) = it.next() {
            self.push(x);
        }
    }
    // 要素の参照のイテレータ (`v.extend(&w)` / `v.extend(w.iter())`。T: Copy)
    pub fn __extend_ref<I: Iterator<Item = &T>>(&mut self, it: I) {
        let mut it = it;
        while let Some(x) = it.next() {
            self.push(*x);
        }
    }
    pub fn retain<F: FnMut(&T) -> bool>(&mut self, f: F) {
        let mut f = f;
        let mut w = 0;
        let mut i = 0;
        while i < self.len {
            unsafe {
                if f(&*self.ptr.add(i)) {
                    if w != i {
                        self.ptr.add(w).write(self.ptr.add(i).read());
                    }
                    w += 1;
                } else {
                    __exr_drop_in_place(self.ptr.add(i));
                }
            }
            i += 1;
        }
        self.len = w;
    }
    pub fn retain_mut<F: FnMut(&mut T) -> bool>(&mut self, f: F) {
        let mut f = f;
        let mut w = 0;
        let mut i = 0;
        while i < self.len {
            unsafe {
                if f(&mut *self.ptr.add(i)) {
                    if w != i {
                        self.ptr.add(w).write(self.ptr.add(i).read());
                    }
                    w += 1;
                } else {
                    __exr_drop_in_place(self.ptr.add(i));
                }
            }
            i += 1;
        }
        self.len = w;
    }
    pub fn dedup_by_key<K: PartialEq, F: FnMut(&mut T) -> K>(&mut self, f: F) {
        let mut f = f;
        if self.len < 2 {
            return;
        }
        let mut w = 1;
        let mut i = 1;
        while i < self.len {
            unsafe {
                let a = f(&mut *self.ptr.add(i));
                let b = f(&mut *self.ptr.add(w - 1));
                if a == b {
                    __exr_drop_in_place(self.ptr.add(i));
                } else {
                    if w != i {
                        self.ptr.add(w).write(self.ptr.add(i).read());
                    }
                    w += 1;
                }
            }
            i += 1;
        }
        self.len = w;
    }
    pub fn split_off(&mut self, at: usize) -> Vec<T> {
        if at > self.len {
            panic!("`at` split index out of bounds");
        }
        let mut r = Vec::with_capacity(self.len - at);
        let mut i = at;
        while i < self.len {
            unsafe {
                r.push(self.ptr.add(i).read());
            }
            i += 1;
        }
        self.len = at;
        r
    }
    // `v.drain(a..b)` (codegen が範囲を (lo, hi) にして呼ぶ)。取り出した要素を持つ IntoIter を返す
    pub fn __drain(&mut self, lo: usize, hi: usize) -> IntoIter<T> {
        if lo > hi || hi > self.len {
            panic!("range end index out of range");
        }
        let mut r = Vec::with_capacity(hi - lo);
        let mut i = lo;
        while i < hi {
            unsafe {
                r.push(self.ptr.add(i).read());
            }
            i += 1;
        }
        let mut j = hi;
        while j < self.len {
            unsafe {
                self.ptr.add(lo + j - hi).write(self.ptr.add(j).read());
            }
            j += 1;
        }
        self.len -= hi - lo;
        r.into_iter()
    }
    pub fn __flat_prep(&mut self) {
        self.reverse();
    }
    pub fn __flat_next(&mut self) -> Option<T> {
        self.pop()
    }
    pub fn first_mut(&mut self) -> Option<&mut T> {
        if self.len == 0 { None } else { Some(unsafe { &mut *self.ptr }) }
    }
    pub fn last_mut(&mut self) -> Option<&mut T> {
        if self.len == 0 { None } else { Some(unsafe { &mut *self.ptr.add(self.len - 1) }) }
    }
    pub fn windows(&self, n: usize) -> Windows<T> {
        __exr_slice_windows(self.as_slice(), n)
    }
    pub fn chunks(&self, n: usize) -> Chunks<T> {
        __exr_slice_chunks(self.as_slice(), n)
    }
    pub fn chunks_exact(&self, n: usize) -> ChunksExact<T> {
        __exr_slice_chunks_exact(self.as_slice(), n)
    }
    pub fn chunks_mut(&mut self, n: usize) -> ChunksMut<T> {
        __exr_slice_chunks_mut(self.as_mut_slice(), n)
    }
    pub fn chunks_exact_mut(&mut self, n: usize) -> ChunksMut<T> {
        __exr_slice_chunks_exact_mut(self.as_mut_slice(), n)
    }
    pub fn as_ptr(&self) -> *const T {
        self.ptr as *const T
    }
    pub fn as_mut_ptr(&mut self) -> *mut T {
        self.ptr
    }
    pub fn as_slice(&self) -> &[T] {
        unsafe { core::slice::from_raw_parts(self.ptr, self.len) }
    }
    pub fn as_mut_slice(&mut self) -> &mut [T] {
        unsafe { core::slice::from_raw_parts_mut(self.ptr, self.len) }
    }
}

impl<T: Copy> Vec<T> {
    pub fn extend_from_slice(&mut self, xs: &[T]) {
        let n = xs.len();
        self.reserve(n);
        // (T: Copy なのでバイト列として写す)
        if n > 0 {
            unsafe {
                __exr_memcpy(self.ptr.add(self.len) as *mut u8, xs.as_ptr() as *const u8, n * core::mem::size_of::<T>());
            }
        }
        self.len += n;
    }
}

// 型の違う比較 (std と同じ組み合わせ): `==` が右辺の型で impl を選ぶ。要素も型が違ってよい (`Vec<String> == [&str; N]`)
fn __exr_seq_eq<T, U>(a: &[T], b: &[U]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if !(a[i] == b[i]) {
            return false;
        }
        i += 1;
    }
    true
}
impl<T, U, const N: usize> PartialEq<[U; N]> for Vec<T> {
    fn eq(&self, other: &[U; N]) -> bool {
        __exr_seq_eq(self.as_slice(), other)
    }
}
impl<T, U, const N: usize> PartialEq<&[U; N]> for Vec<T> {
    fn eq(&self, other: &&[U; N]) -> bool {
        __exr_seq_eq(self.as_slice(), *other)
    }
}
impl<T, U> PartialEq<&[U]> for Vec<T> {
    fn eq(&self, other: &&[U]) -> bool {
        __exr_seq_eq(self.as_slice(), *other)
    }
}
impl<T, U> PartialEq<[U]> for Vec<T> {
    fn eq(&self, other: &[U]) -> bool {
        __exr_seq_eq(self.as_slice(), other)
    }
}
impl<T, U> PartialEq<Vec<U>> for [T] {
    fn eq(&self, other: &Vec<U>) -> bool {
        __exr_seq_eq(self, other.as_slice())
    }
}
impl<T, U> PartialEq<Vec<U>> for Vec<T> {
    fn eq(&self, other: &Vec<U>) -> bool {
        __exr_seq_eq(self.as_slice(), other.as_slice())
    }
}
impl<T, U, const N: usize> PartialEq<[U; N]> for [T] {
    fn eq(&self, other: &[U; N]) -> bool {
        __exr_seq_eq(self, other)
    }
}
impl<T, U, const N: usize> PartialEq<[U]> for [T; N] {
    fn eq(&self, other: &[U]) -> bool {
        __exr_seq_eq(self, other)
    }
}
impl<T, U, const N: usize> PartialEq<&[U]> for [T; N] {
    fn eq(&self, other: &&[U]) -> bool {
        __exr_seq_eq(self, *other)
    }
}
impl<T, U, const N: usize> PartialEq<[U; N]> for [T; N] {
    fn eq(&self, other: &[U; N]) -> bool {
        __exr_seq_eq(self, other)
    }
}

impl<T: PartialEq> Vec<T> {
    pub fn dedup(&mut self) {
        if self.len < 2 {
            return;
        }
        let mut w = 1;
        let mut i = 1;
        while i < self.len {
            unsafe {
                if *self.ptr.add(i) == *self.ptr.add(w - 1) {
                    __exr_drop_in_place(self.ptr.add(i));
                } else {
                    if w != i {
                        self.ptr.add(w).write(self.ptr.add(i).read());
                    }
                    w += 1;
                }
            }
            i += 1;
        }
        self.len = w;
    }
    pub fn contains(&self, x: &T) -> bool {
        let mut i = 0;
        while i < self.len {
            if unsafe { *self.ptr.add(i) == *x } {
                return true;
            }
            i += 1;
        }
        false
    }
    pub fn eq(&self, other: &Vec<T>) -> bool {
        if self.len != other.len {
            return false;
        }
        let mut i = 0;
        while i < self.len {
            if unsafe { *self.ptr.add(i) != *other.ptr.add(i) } {
                return false;
            }
            i += 1;
        }
        true
    }
}

impl<T: Ord> Vec<T> {
    pub fn sort(&mut self) {
        __exr_sort_lt(self.ptr, self.len);
    }
    pub fn sort_unstable(&mut self) {
        self.sort();
    }
    pub fn binary_search(&self, x: &T) -> Result<usize, usize> {
        __exr_bsearch_lt(self.ptr, self.len, x)
    }
}

impl<T> Vec<T> {
    // (the buffer becomes the Box's: a Box<[T]> is its (pointer, length) and frees the pointer)
    pub fn into_boxed_slice(self) -> Box<[T]> {
        let p = self.ptr;
        let n = self.len;
        __core_forget(self);
        unsafe { __core_transmute::<(*mut T, usize), Box<[T]>>((p, n)) }
    }
    pub fn sort_by<F: FnMut(&T, &T) -> Ordering>(&mut self, f: F) {
        let mut f = f;
        __exr_merge_sort(self.ptr, self.len, |a: &T, b: &T| __exr_ord_i32::<()>(&f(a, b)) < 0);
    }
    pub fn sort_unstable_by<F: FnMut(&T, &T) -> Ordering>(&mut self, f: F) {
        self.sort_by(f);
    }
    pub fn sort_by_key<K: Ord, F: FnMut(&T) -> K>(&mut self, f: F) {
        __exr_sort_by_key(self.ptr, self.len, f);
    }
    pub fn sort_unstable_by_key<K: Ord, F: FnMut(&T) -> K>(&mut self, f: F) {
        self.sort_by_key(f);
    }
    pub fn sort_by_cached_key<K: Ord, F: FnMut(&T) -> K>(&mut self, f: F) {
        __exr_sort_cached(self.ptr, self.len, f);
    }
    pub fn binary_search_by<F: FnMut(&T) -> Ordering>(&self, f: F) -> Result<usize, usize> {
        __exr_bsearch_by(self.ptr, self.len, f)
    }
    pub fn binary_search_by_key<B: Ord, F: FnMut(&T) -> B>(&self, b: &B, f: F) -> Result<usize, usize> {
        let mut f = f;
        __exr_bsearch_by(self.ptr, self.len, |e: &T| __exr_cmp_m::<B>(&f(e), b))
    }
}

impl<T: Clone> Vec<T> {
    pub fn clone(&self) -> Vec<T> {
        let mut v = Vec::with_capacity(self.len);
        let mut i = 0;
        while i < self.len {
            v.push(unsafe { (*self.ptr.add(i)).clone() });
            i += 1;
        }
        v
    }
    pub fn resize(&mut self, n: usize, value: T) {
        while self.len > n {
            self.len -= 1;
            unsafe {
                __exr_drop_in_place(self.ptr.add(self.len));
            }
        }
        while self.len < n {
            self.push(value.clone());
        }
    }
    pub fn fill(&mut self, value: T) {
        let mut i = 0;
        while i < self.len {
            unsafe {
                __exr_drop_in_place(self.ptr.add(i));
                self.ptr.add(i).write(value.clone());
            }
            i += 1;
        }
    }
    pub fn to_vec(&self) -> Vec<T> {
        __exr_slice_to_vec(self.as_slice())
    }
}

// windows / chunks (Vec とスライス)
pub struct Windows<T> {
    ptr: *const T,
    len: usize,
    n: usize,
    i: usize,
}

impl<T> Iterator for Windows<T> {
    type Item = &[T];
    fn next(&mut self) -> Option<&[T]> {
        if self.i + self.n <= self.len {
            let s = unsafe { core::slice::from_raw_parts(self.ptr.add(self.i), self.n) };
            self.i += 1;
            Some(s)
        } else {
            None
        }
    }
}

pub struct Chunks<T> {
    ptr: *const T,
    len: usize,
    n: usize,
    i: usize,
}

impl<T> Iterator for Chunks<T> {
    type Item = &[T];
    fn next(&mut self) -> Option<&[T]> {
        if self.i < self.len {
            let k = if self.len - self.i < self.n { self.len - self.i } else { self.n };
            let s = unsafe { core::slice::from_raw_parts(self.ptr.add(self.i), k) };
            self.i += k;
            Some(s)
        } else {
            None
        }
    }
}

fn __exr_slice_split_at<T>(s: &[T], mid: usize) -> (&[T], &[T]) {
    if mid > s.len() {
        panic!("mid > len");
    }
    unsafe {
        (
            core::slice::from_raw_parts(s.as_ptr(), mid),
            core::slice::from_raw_parts(s.as_ptr().add(mid), s.len() - mid),
        )
    }
}

fn __exr_slice_split_at_mut<T>(s: &mut [T], mid: usize) -> (&mut [T], &mut [T]) {
    if mid > s.len() {
        panic!("mid > len");
    }
    let n = s.len();
    let p = s.as_mut_ptr();
    unsafe { (core::slice::from_raw_parts_mut(p, mid), core::slice::from_raw_parts_mut(p.add(mid), n - mid)) }
}

// `s.split_first()` / `s.split_last()`: the end element and the rest, None when s is empty
fn __exr_slice_split_first<T>(s: &[T]) -> Option<(&T, &[T])> {
    if s.len() == 0 {
        return None;
    }
    unsafe { Some((&*s.as_ptr(), core::slice::from_raw_parts(s.as_ptr().add(1), s.len() - 1))) }
}

fn __exr_slice_split_last<T>(s: &[T]) -> Option<(&T, &[T])> {
    let n = s.len();
    if n == 0 {
        return None;
    }
    unsafe { Some((&*s.as_ptr().add(n - 1), core::slice::from_raw_parts(s.as_ptr(), n - 1))) }
}

// `s.splitn(n, |x| ..)`: at most n pieces between the elements pred takes, the last one the rest
pub struct SliceSplitN<T, F> {
    ptr: *const T,
    len: usize,
    n: usize,
    pred: F,
}

impl<T, F: FnMut(&T) -> bool> Iterator for SliceSplitN<T, F> {
    type Item = &[T];
    fn next(&mut self) -> Option<&[T]> {
        if self.n == 0 {
            return None;
        }
        self.n -= 1;
        if self.n > 0 {
            let mut i = 0;
            while i < self.len {
                if (self.pred)(unsafe { &*self.ptr.add(i) }) {
                    let piece = unsafe { core::slice::from_raw_parts(self.ptr, i) };
                    self.ptr = unsafe { self.ptr.add(i + 1) };
                    self.len -= i + 1;
                    return Some(piece);
                }
                i += 1;
            }
            self.n = 0;
        }
        Some(unsafe { core::slice::from_raw_parts(self.ptr, self.len) })
    }
}

fn __exr_slice_splitn<T, F: FnMut(&T) -> bool>(s: &[T], n: usize, pred: F) -> SliceSplitN<T, F> {
    SliceSplitN { ptr: s.as_ptr(), len: s.len(), n: n, pred: pred }
}

fn __exr_slice_windows<T>(s: &[T], n: usize) -> Windows<T> {
    if n == 0 {
        panic!("window size must be non-zero");
    }
    Windows { ptr: s.as_ptr(), len: s.len(), n: n, i: 0 }
}

pub struct ChunksExact<T> {
    ptr: *const T,
    len: usize,
    n: usize,
    i: usize,
}

impl<T> ChunksExact<T> {
    pub fn remainder(&self) -> &[T] {
        let k = self.len - self.len % self.n;
        unsafe { core::slice::from_raw_parts(self.ptr.add(k), self.len - k) }
    }
    // (ExactSizeIterator's: the whole chunks still to come)
    pub fn len(&self) -> usize {
        (self.len - self.i) / self.n
    }
}

impl<T> Iterator for ChunksExact<T> {
    type Item = &[T];
    fn next(&mut self) -> Option<&[T]> {
        if self.i + self.n <= self.len {
            let s = unsafe { core::slice::from_raw_parts(self.ptr.add(self.i), self.n) };
            self.i += self.n;
            Some(s)
        } else {
            None
        }
    }
}

fn __exr_slice_chunks_exact<T>(s: &[T], n: usize) -> ChunksExact<T> {
    if n == 0 {
        panic!("chunk size must be non-zero");
    }
    ChunksExact { ptr: s.as_ptr(), len: s.len(), n: n, i: 0 }
}

// (`s.split_first_chunk::<N>()`: turbofish の N が先頭の型パラメータに当たるように N を先に置く)
fn __exr_slice_split_first_chunk<const N: usize, T>(s: &[T]) -> Option<(&[T; N], &[T])> {
    if s.len() < N {
        return None;
    }
    unsafe { Some((&*(s.as_ptr() as *const [T; N]), core::slice::from_raw_parts(s.as_ptr().add(N), s.len() - N))) }
}

fn __exr_slice_first_chunk<const N: usize, T>(s: &[T]) -> Option<&[T; N]> {
    if s.len() < N {
        return None;
    }
    unsafe { Some(&*(s.as_ptr() as *const [T; N])) }
}

pub struct ChunksMut<T> {
    ptr: *mut T,
    len: usize,
    n: usize,
    i: usize,
    exact: bool,
}

impl<T> Iterator for ChunksMut<T> {
    type Item = &mut [T];
    fn next(&mut self) -> Option<&mut [T]> {
        let left = self.len - self.i;
        if left == 0 || (self.exact && left < self.n) {
            return None;
        }
        let k = if left < self.n { left } else { self.n };
        let s = unsafe { core::slice::from_raw_parts_mut(self.ptr.add(self.i), k) };
        self.i += k;
        Some(s)
    }
}

impl<T> ChunksMut<T> {
    /// (`chunks_exact_mut(n)`'s elements past the last whole chunk)
    pub fn into_remainder(self) -> &mut [T] {
        let k = self.len - self.len % self.n;
        unsafe { core::slice::from_raw_parts_mut(self.ptr.add(k), self.len - k) }
    }
}

// (`chunks_mut` / `chunks_exact_mut`: one iterator type, the exact one stops before a short chunk)
fn __exr_slice_chunks_mut<T>(s: &mut [T], n: usize) -> ChunksMut<T> {
    if n == 0 {
        panic!("chunk size must be non-zero");
    }
    ChunksMut { ptr: s.as_mut_ptr(), len: s.len(), n: n, i: 0, exact: false }
}
fn __exr_slice_chunks_exact_mut<T>(s: &mut [T], n: usize) -> ChunksMut<T> {
    if n == 0 {
        panic!("chunk size must be non-zero");
    }
    ChunksMut { ptr: s.as_mut_ptr(), len: s.len(), n: n, i: 0, exact: true }
}

fn __exr_slice_chunks<T>(s: &[T], n: usize) -> Chunks<T> {
    if n == 0 {
        panic!("chunk size must be non-zero");
    }
    Chunks { ptr: s.as_ptr(), len: s.len(), n: n, i: 0 }
}

fn __exr_slice_copy_from<T: Copy>(d: &mut [T], s: &[T]) {
    if d.len() != s.len() {
        panic!("source slice length ({}) does not match destination slice length ({})", s.len(), d.len());
    }
    let mut i = 0;
    while i < s.len() {
        d[i] = s[i];
        i += 1;
    }
}

fn __exr_slice_clone_from<T: Clone>(d: &mut [T], s: &[T]) {
    if d.len() != s.len() {
        panic!("destination and source slices have different lengths");
    }
    let mut i = 0;
    while i < s.len() {
        d[i] = s[i].clone();
        i += 1;
    }
}

fn __exr_slice_is_sorted<T: PartialOrd>(s: &[T]) -> bool {
    let mut i = 1;
    while i < s.len() {
        if s[i - 1] > s[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn __exr_slice_is_sorted_by<T, F: FnMut(&T, &T) -> bool>(s: &[T], f: F) -> bool {
    let mut f = f;
    let mut i = 1;
    while i < s.len() {
        if !f(&s[i - 1], &s[i]) {
            return false;
        }
        i += 1;
    }
    true
}

fn __exr_slice_is_sorted_by_key<T, K: PartialOrd, F: FnMut(&T) -> K>(s: &[T], f: F) -> bool {
    let mut f = f;
    let mut i = 1;
    while i < s.len() {
        if f(&s[i - 1]) > f(&s[i]) {
            return false;
        }
        i += 1;
    }
    true
}

fn __exr_slice_contains<T: PartialEq>(s: &[T], x: &T) -> bool {
    let mut i = 0;
    while i < s.len() {
        if s[i] == *x {
            return true;
        }
        i += 1;
    }
    false
}

fn __exr_slice_to_vec<T: Clone>(s: &[T]) -> Vec<T> {
    let mut r = Vec::with_capacity(s.len());
    let mut i = 0;
    while i < s.len() {
        r.push(s[i].clone());
        i += 1;
    }
    r
}

// `["a", "b"].join(", ")` / `.concat()` (要素が &str か String。codegen が要素の型で選ぶ)
fn __exr_join_str<G>(s: &[&str], sep: &str) -> String {
    let mut r = String::new();
    let mut i = 0;
    while i < s.len() {
        if i > 0 {
            r.push_str(sep);
        }
        r.push_str(s[i]);
        i += 1;
    }
    r
}

fn __exr_concat_vec<T: Clone>(s: &[Vec<T>]) -> Vec<T> {
    let mut r = Vec::new();
    let mut i = 0;
    while i < s.len() {
        let mut j = 0;
        while j < s[i].len() {
            r.push(s[i][j].clone());
            j += 1;
        }
        i += 1;
    }
    r
}

fn __exr_join_string<G>(s: &[String], sep: &str) -> String {
    let mut r = String::new();
    let mut i = 0;
    while i < s.len() {
        if i > 0 {
            r.push_str(sep);
        }
        r.push_str(s[i].as_str());
        i += 1;
    }
    r
}

// 安定なマージソート (下から上へ)。16 個ずつ挿入ソートしてから、作業領域と交互にマージする。
// 要素は read / write でビット移動するので、Drop を持つ型でも二重解放しない
fn __exr_merge_sort<T, F: FnMut(&T, &T) -> bool>(p: *mut T, n: usize, lt: F) {
    let mut lt = lt;
    let sz = core::mem::size_of::<T>();
    if n < 2 || sz == 0 {
        return;
    }
    let run = 16;
    let mut s = 0;
    while s < n {
        let e = if s + run < n { s + run } else { n };
        let mut i = s + 1;
        while i < e {
            unsafe {
                let x = p.add(i).read();
                let mut j = i;
                while j > s && lt(&x, &*p.add(j - 1)) {
                    p.add(j).write(p.add(j - 1).read());
                    j -= 1;
                }
                p.add(j).write(x);
            }
            i += 1;
        }
        s = e;
    }
    if n <= run {
        return;
    }
    let buf = unsafe { __exr_realloc_ok(0usize as *mut u8, n * sz) } as *mut T;
    let mut src = p;
    let mut dst = buf;
    let mut w = run;
    while w < n {
        let mut lo = 0;
        while lo < n {
            let mid = if lo + w < n { lo + w } else { n };
            let hi = if lo + 2 * w < n { lo + 2 * w } else { n };
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            unsafe {
                while i < mid && j < hi {
                    // 右が真に小さいときだけ右を先に出す (安定)
                    if lt(&*src.add(j), &*src.add(i)) {
                        dst.add(k).write(src.add(j).read());
                        j += 1;
                    } else {
                        dst.add(k).write(src.add(i).read());
                        i += 1;
                    }
                    k += 1;
                }
                while i < mid {
                    dst.add(k).write(src.add(i).read());
                    i += 1;
                    k += 1;
                }
                while j < hi {
                    dst.add(k).write(src.add(j).read());
                    j += 1;
                    k += 1;
                }
            }
            lo = hi;
        }
        let t = src;
        src = dst;
        dst = t;
        w *= 2;
    }
    if src != p {
        let mut i = 0;
        while i < n {
            unsafe {
                p.add(i).write(src.add(i).read());
            }
            i += 1;
        }
    }
    unsafe {
        __exr_free(buf as *mut u8);
    }
}

// `<` で並べる版 (sort / sort_unstable)。比較をクロージャの呼び出しにせず、整数なら命令 1 つにする
fn __exr_merge_sort_lt<T>(p: *mut T, n: usize) {
    let sz = core::mem::size_of::<T>();
    if n < 2 || sz == 0 {
        return;
    }
    let run = 16;
    let mut s = 0;
    while s < n {
        let e = if s + run < n { s + run } else { n };
        let mut i = s + 1;
        while i < e {
            unsafe {
                let x = p.add(i).read();
                let mut j = i;
                while j > s && x < *p.add(j - 1) {
                    p.add(j).write(p.add(j - 1).read());
                    j -= 1;
                }
                p.add(j).write(x);
            }
            i += 1;
        }
        s = e;
    }
    if n <= run {
        return;
    }
    let buf = unsafe { __exr_realloc_ok(0usize as *mut u8, n * sz) } as *mut T;
    let mut src = p;
    let mut dst = buf;
    let mut w = run;
    while w < n {
        let mut lo = 0;
        while lo < n {
            let mid = if lo + w < n { lo + w } else { n };
            let hi = if lo + 2 * w < n { lo + 2 * w } else { n };
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            unsafe {
                while i < mid && j < hi {
                    // 右が真に小さいときだけ右を先に出す (安定)。分岐を使わずに選ぶ (比較の結果は予測できない)
                    let t = (*src.add(j) < *src.add(i)) as usize;
                    dst.add(k).write(src.add(i + (j - i) * t).read());
                    j += t;
                    i += 1 - t;
                    k += 1;
                }
                while i < mid {
                    dst.add(k).write(src.add(i).read());
                    i += 1;
                    k += 1;
                }
                while j < hi {
                    dst.add(k).write(src.add(j).read());
                    j += 1;
                    k += 1;
                }
            }
            lo = hi;
        }
        let t = src;
        src = dst;
        dst = t;
        w *= 2;
    }
    if src != p {
        let mut i = 0;
        while i < n {
            unsafe {
                p.add(i).write(src.add(i).read());
            }
            i += 1;
        }
    }
    unsafe {
        __exr_free(buf as *mut u8);
    }
}

// 整数のキーを、符号なしの大小と同じ順の u64 にする (符号つきは符号ビットを反転)
fn __exr_radix_key<K>(k: &K) -> u64 {
    let sz: usize = core::mem::size_of::<K>();
    let p = k as *const K;
    let v: u64 = unsafe {
        if sz == 8 {
            *(p as *const u64)
        } else if sz == 4 {
            *(p as *const u32) as u64
        } else if sz == 2 {
            *(p as *const u16) as u64
        } else {
            *(p as *const u8) as u64
        }
    };
    if __exr_int_kind::<K>() == 2 {
        // (符号の拡張をせずに上位ビットを反転: 幅 sz の中での符号ビット)
        v ^ (1u64 << ((8 * sz - 1) as u64))
    } else {
        v
    }
}

// __exr_radix_key の逆 (キーから整数の値を書き戻す)
fn __exr_radix_unkey<K>(v: u64, out: *mut K) {
    let sz: usize = core::mem::size_of::<K>();
    let v = if __exr_int_kind::<K>() == 2 { v ^ (1u64 << ((8 * sz - 1) as u64)) } else { v };
    unsafe {
        if sz == 8 {
            *(out as *mut u64) = v;
        } else if sz == 4 {
            *(out as *mut u32) = v as u32;
        } else if sz == 2 {
            *(out as *mut u16) = v as u16;
        } else {
            *(out as *mut u8) = v as u8;
        }
    }
}

// 安定な LSD 基数ソート: keys の順に (keys と) vals を並べる。全要素で同じバイトの桁は飛ばす
fn __exr_radix_sort<T>(keys: *mut u64, vals: *mut T, n: usize, with_vals: bool) {
    let sz = core::mem::size_of::<T>();
    let kb = unsafe { __exr_realloc_ok(0usize as *mut u8, n * 8) } as *mut u64;
    let vb = if with_vals && sz > 0 { (unsafe { __exr_realloc_ok(0usize as *mut u8, n * sz) }) as *mut T } else { vals };
    let mut diff: u64 = 0;
    let k0 = unsafe { *keys };
    let mut i: usize = 0;
    while i < n {
        diff |= unsafe { *keys.add(i) } ^ k0;
        i += 1;
    }
    let (mut ks, mut kd, mut vs, mut vd) = (keys, kb, vals, vb);
    let mut count = [0usize; 256];
    let cp = count.as_mut_ptr();
    let mut shift: u64 = 0;
    while shift < 64 {
        if (diff >> shift) & 0xFF != 0 {
            let mut c: usize = 0;
            while c < 256 {
                unsafe {
                    *cp.add(c) = 0;
                }
                c += 1;
            }
            i = 0;
            while i < n {
                unsafe {
                    let d = ((*ks.add(i) >> shift) & 0xFF) as usize;
                    *cp.add(d) += 1;
                }
                i += 1;
            }
            let mut sum: usize = 0;
            c = 0;
            while c < 256 {
                unsafe {
                    let t = *cp.add(c);
                    *cp.add(c) = sum;
                    sum += t;
                }
                c += 1;
            }
            i = 0;
            while i < n {
                unsafe {
                    let k = *ks.add(i);
                    let d = ((k >> shift) & 0xFF) as usize;
                    let at = *cp.add(d);
                    *cp.add(d) = at + 1;
                    *kd.add(at) = k;
                }
                i += 1;
            }
            // (値も並べ替えるなら、同じ行き先にもう 1 回: ループの中で分岐しない)
            if with_vals && sz > 0 {
                c = 0;
                let mut s2: usize = 0;
                while c < 256 {
                    unsafe {
                        let t = *cp.add(c);
                        *cp.add(c) = s2;
                        s2 = t;
                    }
                    c += 1;
                }
                i = 0;
                while i < n {
                    unsafe {
                        let d = ((*ks.add(i) >> shift) & 0xFF) as usize;
                        let at = *cp.add(d);
                        *cp.add(d) = at + 1;
                        vd.add(at).write(vs.add(i).read());
                    }
                    i += 1;
                }
            }
            let t = ks;
            ks = kd;
            kd = t;
            let tv = vs;
            vs = vd;
            vd = tv;
        }
        shift += 8;
    }
    // (奇数回の並べ替えなら、結果は作業領域にある: 元に戻す)
    if ks != keys {
        unsafe {
            __exr_memcpy(keys as *mut u8, ks as *const u8, n * 8);
            if with_vals && sz > 0 {
                __exr_memcpy(vals as *mut u8, vs as *const u8, n * sz);
            }
        }
    }
    unsafe {
        __exr_free(kb as *mut u8);
        if with_vals && sz > 0 {
            __exr_free(vb as *mut u8);
        }
    }
}

// sort_by_key: キーが 64 bit 以下の整数なら、キーを要素ごとに 1 回だけ計算して安定な基数ソート
// (std は比較ごとにキーの関数を呼ぶので、キーの関数の呼ばれる回数は std と違う)
fn __exr_sort_by_key<T, K: Ord, F: FnMut(&T) -> K>(p: *mut T, n: usize, f: F) {
    let mut f = f;
    if __exr_int_kind::<K>() == 0 || n < 64 {
        __exr_merge_sort_key(p, n, f);
        return;
    }
    let keys = unsafe { __exr_realloc_ok(0usize as *mut u8, n * 8) } as *mut u64;
    let mut i: usize = 0;
    while i < n {
        let k = f(unsafe { &*p.add(i) });
        unsafe {
            *keys.add(i) = __exr_radix_key(&k);
        }
        i += 1;
    }
    __exr_radix_sort(keys, p, n, true);
    unsafe {
        __exr_free(keys as *mut u8);
    }
}

// sort (`<` の順): 要素が 64 bit 以下の整数なら基数ソート (等しい整数は区別できないので安定かどうかは見えない)
fn __exr_sort_lt<T>(p: *mut T, n: usize) {
    if __exr_int_kind::<T>() == 0 || n < 64 {
        __exr_merge_sort_lt(p, n);
        return;
    }
    let keys = unsafe { __exr_realloc_ok(0usize as *mut u8, n * 8) } as *mut u64;
    let mut i: usize = 0;
    while i < n {
        unsafe {
            *keys.add(i) = __exr_radix_key(&*p.add(i));
        }
        i += 1;
    }
    __exr_radix_sort(keys, p, n, false);
    i = 0;
    while i < n {
        unsafe {
            __exr_radix_unkey(*keys.add(i), p.add(i));
        }
        i += 1;
    }
    unsafe {
        __exr_free(keys as *mut u8);
    }
}

// キーで並べる版 (sort_by_key): 比較ごとにキーの関数を直接 2 回呼ぶ (比較のクロージャを挟まない)
fn __exr_merge_sort_key<T, K: Ord, F: FnMut(&T) -> K>(p: *mut T, n: usize, f: F) {
    let mut f = f;
    let sz = core::mem::size_of::<T>();
    if n < 2 || sz == 0 {
        return;
    }
    let run = 16;
    let mut s = 0;
    while s < n {
        let e = if s + run < n { s + run } else { n };
        let mut i = s + 1;
        while i < e {
            unsafe {
                let x = p.add(i).read();
                let mut j = i;
                while j > s && f(&x) < f(&*p.add(j - 1)) {
                    p.add(j).write(p.add(j - 1).read());
                    j -= 1;
                }
                p.add(j).write(x);
            }
            i += 1;
        }
        s = e;
    }
    if n <= run {
        return;
    }
    let buf = unsafe { __exr_realloc_ok(0usize as *mut u8, n * sz) } as *mut T;
    let mut src = p;
    let mut dst = buf;
    let mut w = run;
    while w < n {
        let mut lo = 0;
        while lo < n {
            let mid = if lo + w < n { lo + w } else { n };
            let hi = if lo + 2 * w < n { lo + 2 * w } else { n };
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            unsafe {
                while i < mid && j < hi {
                    // 右が真に小さいときだけ右を先に出す (安定)。分岐を使わずに選ぶ (比較の結果は予測できない)
                    let t = (f(&*src.add(j)) < f(&*src.add(i))) as usize;
                    dst.add(k).write(src.add(i + (j - i) * t).read());
                    j += t;
                    i += 1 - t;
                    k += 1;
                }
                while i < mid {
                    dst.add(k).write(src.add(i).read());
                    i += 1;
                    k += 1;
                }
                while j < hi {
                    dst.add(k).write(src.add(j).read());
                    j += 1;
                    k += 1;
                }
            }
            lo = hi;
        }
        let t = src;
        src = dst;
        dst = t;
        w *= 2;
    }
    if src != p {
        let mut i = 0;
        while i < n {
            unsafe {
                p.add(i).write(src.add(i).read());
            }
            i += 1;
        }
    }
    unsafe {
        __exr_free(buf as *mut u8);
    }
}

// キーを 1 要素 1 回だけ計算して (前から順に)、添字をキーで安定にソートしてから並べ替える
fn __exr_sort_cached<T, K: Ord, F: FnMut(&T) -> K>(p: *mut T, n: usize, f: F) {
    let mut f = f;
    if n < 2 {
        return;
    }
    let mut keys: Vec<K> = Vec::with_capacity(n);
    let mut idx: Vec<usize> = Vec::with_capacity(n);
    let mut i = 0;
    while i < n {
        keys.push(f(unsafe { &*p.add(i) }));
        idx.push(i);
        i += 1;
    }
    let kp = keys.ptr;
    __exr_merge_sort(idx.ptr, n, |a: &usize, b: &usize| {
        let c = unsafe { __exr_cmp::<K>(&*kp.add(*a), &*kp.add(*b)) };
        c < 0
    });
    let sz = core::mem::size_of::<T>();
    if sz == 0 {
        return;
    }
    let buf = unsafe { __exr_realloc_ok(0usize as *mut u8, n * sz) } as *mut T;
    i = 0;
    while i < n {
        unsafe {
            buf.add(i).write(p.add(*idx.ptr.add(i)).read());
        }
        i += 1;
    }
    i = 0;
    while i < n {
        unsafe {
            p.add(i).write(buf.add(i).read());
        }
        i += 1;
    }
    unsafe {
        __exr_free(buf as *mut u8);
    }
}

// std と同じ二分探索 (同じ値が並ぶときに返す位置も std に合わせる)
// binary_search: `<=` と `==` で直接比べる (__exr_bsearch_by と同じ位置を返す)
fn __exr_bsearch_lt<T>(p: *mut T, n: usize, x: &T) -> Result<usize, usize> {
    let mut size = n;
    if size == 0 {
        return Err(0);
    }
    let mut base = 0;
    while size > 1 {
        let half = size / 2;
        let mid = base + half;
        if unsafe { *p.add(mid) <= *x } {
            base = mid;
        }
        size -= half;
    }
    let e = unsafe { &*p.add(base) };
    if *e == *x {
        Ok(base)
    } else if *e < *x {
        Err(base + 1)
    } else {
        Err(base)
    }
}

fn __exr_bsearch_by<T, F: FnMut(&T) -> Ordering>(p: *mut T, n: usize, f: F) -> Result<usize, usize> {
    let mut f = f;
    let mut size = n;
    if size == 0 {
        return Err(0);
    }
    let mut base = 0;
    while size > 1 {
        let half = size / 2;
        let mid = base + half;
        let c = __exr_ord_i32::<()>(&f(unsafe { &*p.add(mid) }));
        if c <= 0 {
            base = mid;
        }
        size -= half;
    }
    let c = __exr_ord_i32::<()>(&f(unsafe { &*p.add(base) }));
    if c == 0 {
        Ok(base)
    } else if c < 0 {
        Err(base + 1)
    } else {
        Err(base)
    }
}

// 配列・スライスの sort / binary_search (codegen が `a.sort()` をこれにする)
fn __exr_slice_reverse<T>(s: &mut [T]) {
    let n = s.len();
    let p = s.as_mut_ptr();
    let mut i = 0;
    while i + 1 < n - i {
        unsafe {
            let x = p.add(i).read();
            p.add(i).write(p.add(n - 1 - i).read());
            p.add(n - 1 - i).write(x);
        }
        i += 1;
    }
}
fn __exr_slice_fill<T: Clone>(s: &mut [T], x: T) {
    let n = s.len();
    let p = s.as_mut_ptr();
    let mut i = 0;
    while i < n {
        unsafe {
            *p.add(i) = x.clone();
        }
        i += 1;
    }
}
fn __exr_slice_rotate_left<T>(s: &mut [T], k: usize) {
    let n = s.len();
    if n == 0 {
        return;
    }
    let k = k % n;
    __exr_slice_reverse(&mut s[..k]);
    __exr_slice_reverse(&mut s[k..]);
    __exr_slice_reverse(s);
}
fn __exr_slice_rotate_right<T>(s: &mut [T], k: usize) {
    let n = s.len();
    if n == 0 {
        return;
    }
    __exr_slice_rotate_left(s, n - k % n);
}
fn __exr_slice_sort<T: Ord>(s: &mut [T]) {
    __exr_sort_lt(s.as_mut_ptr(), s.len());
}
fn __exr_slice_sort_by<T, F: FnMut(&T, &T) -> Ordering>(s: &mut [T], f: F) {
    let mut f = f;
    __exr_merge_sort(s.as_mut_ptr(), s.len(), |a: &T, b: &T| __exr_ord_i32::<()>(&f(a, b)) < 0);
}
fn __exr_slice_sort_by_key<T, K: Ord, F: FnMut(&T) -> K>(s: &mut [T], f: F) {
    __exr_sort_by_key(s.as_mut_ptr(), s.len(), f);
}
fn __exr_slice_sort_by_cached_key<T, K: Ord, F: FnMut(&T) -> K>(s: &mut [T], f: F) {
    __exr_sort_cached(s.as_mut_ptr(), s.len(), f);
}
fn __exr_slice_bsearch<T: Ord>(s: &[T], x: &T) -> Result<usize, usize> {
    __exr_bsearch_lt(s.as_ptr() as *mut T, s.len(), x)
}
fn __exr_slice_bsearch_by<T, F: FnMut(&T) -> Ordering>(s: &[T], f: F) -> Result<usize, usize> {
    __exr_bsearch_by(s.as_ptr() as *mut T, s.len(), f)
}
fn __exr_slice_bsearch_by_key<T, B: Ord, F: FnMut(&T) -> B>(s: &[T], b: &B, f: F) -> Result<usize, usize> {
    let mut f = f;
    __exr_bsearch_by(s.as_ptr() as *mut T, s.len(), |e: &T| __exr_cmp_m::<B>(&f(e), b))
}

// Ord::clamp (`x.clamp(lo, hi)`。lo > hi なら panic)
fn __exr_clamp<T>(x: T, lo: T, hi: T) -> T {
    if __exr_cmp::<T>(&lo, &hi) > 0 {
        panic!("assertion failed: min <= max");
    }
    if __exr_cmp::<T>(&x, &lo) < 0 {
        lo
    } else if __exr_cmp::<T>(&x, &hi) > 0 {
        hi
    } else {
        x
    }
}

impl<T> Drop for Vec<T> {
    fn drop(&mut self) {
        self.clear();
        if !self.ptr.is_null() {
            unsafe {
                __exr_free(self.ptr as *mut u8);
            }
        }
    }
}

pub struct String {
    vec: Vec<u8>,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Utf8Error {
    valid_up_to: usize,
    error_len: Option<u8>,
}

impl Utf8Error {
    pub fn valid_up_to(&self) -> usize {
        self.valid_up_to
    }
    pub fn error_len(&self) -> Option<usize> {
        match self.error_len {
            Some(n) => Some(n as usize),
            None => None,
        }
    }
}

impl Display for Utf8Error {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        match self.error_len {
            Some(n) => write!(f, "invalid utf-8 sequence of {} bytes from index {}", n, self.valid_up_to),
            None => write!(f, "incomplete utf-8 byte sequence from index {}", self.valid_up_to),
        }
    }
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct FromUtf8Error {
    bytes: Vec<u8>,
    error: Utf8Error,
}

impl FromUtf8Error {
    pub fn into_bytes(self) -> Vec<u8> {
        self.bytes
    }
    pub fn utf8_error(&self) -> Utf8Error {
        self.error
    }
}

impl Display for FromUtf8Error {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        write!(f, "{}", self.error)
    }
}

// UTF-8 の検査 (std と同じく、過長な符号化・サロゲート・0x10FFFF 超えは不正)
fn __exr_utf8_check<G>(b: &[u8]) -> Result<(), Utf8Error> {
    let mut i = 0;
    while i < b.len() {
        let c = b[i];
        if c < 0x80 {
            i += 1;
            continue;
        }
        let w = if c >= 0xC2 && c <= 0xDF {
            2
        } else if c >= 0xE0 && c <= 0xEF {
            3
        } else if c >= 0xF0 && c <= 0xF4 {
            4
        } else {
            return Err(Utf8Error { valid_up_to: i, error_len: Some(1) });
        };
        // 2 バイト目の範囲は先頭で決まる
        let (lo, hi) = if c == 0xE0 {
            (0xA0, 0xBF)
        } else if c == 0xED {
            (0x80, 0x9F)
        } else if c == 0xF0 {
            (0x90, 0xBF)
        } else if c == 0xF4 {
            (0x80, 0x8F)
        } else {
            (0x80, 0xBF)
        };
        let mut k = 1;
        while k < w {
            if i + k >= b.len() {
                return Err(Utf8Error { valid_up_to: i, error_len: None });
            }
            let d = b[i + k];
            let ok = if k == 1 { d >= lo && d <= hi } else { d >= 0x80 && d <= 0xBF };
            if !ok {
                return Err(Utf8Error { valid_up_to: i, error_len: Some(k as u8) });
            }
            k += 1;
        }
        i += w;
    }
    Ok(())
}

// `std::str::from_utf8(&bytes)`
fn __core_from_utf8<G>(b: &[u8]) -> Result<&str, Utf8Error> {
    match __exr_utf8_check::<()>(b) {
        Ok(()) => Ok(unsafe { core::str::from_utf8_unchecked(b) }),
        Err(e) => Err(e),
    }
}

impl String {
    // 要素が char / &char / &str / String のどれでも (codegen の __push_piece が型で選ぶ)
    pub fn extend<I: Iterator>(&mut self, it: I) {
        let mut it = it;
        while let Some(x) = it.next() {
            self.__push_piece(x);
        }
    }
    pub fn new() -> String {
        String { vec: Vec::new() }
    }
    pub fn with_capacity(n: usize) -> String {
        String {
            vec: Vec::with_capacity(n),
        }
    }
    pub fn from(s: &str) -> String {
        let mut r = String::with_capacity(s.len());
        r.push_str(s);
        r
    }
    // UTF-8 として正しければ、そのバイト列を持つ String
    // (std は Cow<str> を返す。ここでは String: 読むだけなら同じように使える)
    // 不正な部分は std と同じく、壊れた列ごとに U+FFFD 1 つにする (末尾の途中で切れた列も 1 つ)
    pub fn from_utf8_lossy(v: &[u8]) -> String {
        let mut out = String::new();
        let mut rest = v;
        loop {
            match __exr_utf8_check::<()>(rest) {
                Ok(()) => {
                    out.vec.extend_from_slice(rest);
                    return out;
                }
                Err(e) => {
                    out.vec.extend_from_slice(&rest[..e.valid_up_to]);
                    out.push_str("\u{FFFD}");
                    match e.error_len {
                        Some(n) => rest = &rest[e.valid_up_to + n as usize..],
                        None => return out,
                    }
                }
            }
        }
    }
    pub fn from_utf8(v: Vec<u8>) -> Result<String, FromUtf8Error> {
        match __exr_utf8_check::<()>(v.as_slice()) {
            Ok(()) => Ok(String { vec: v }),
            Err(e) => Err(FromUtf8Error { bytes: v, error: e }),
        }
    }
    pub fn push_str(&mut self, s: &str) {
        self.vec.extend_from_slice(s.as_bytes());
    }
    // UTF-8 に符号化して足す
    pub fn push(&mut self, c: char) {
        let c = c as u32;
        if c < 0x80 {
            self.vec.push(c as u8);
        } else if c < 0x800 {
            self.vec.push(0xC0 | (c >> 6) as u8);
            self.vec.push(0x80 | (c & 0x3F) as u8);
        } else if c < 0x10000 {
            self.vec.push(0xE0 | (c >> 12) as u8);
            self.vec.push(0x80 | ((c >> 6) & 0x3F) as u8);
            self.vec.push(0x80 | (c & 0x3F) as u8);
        } else {
            self.vec.push(0xF0 | (c >> 18) as u8);
            self.vec.push(0x80 | ((c >> 12) & 0x3F) as u8);
            self.vec.push(0x80 | ((c >> 6) & 0x3F) as u8);
            self.vec.push(0x80 | (c & 0x3F) as u8);
        }
    }
    pub fn len(&self) -> usize {
        self.vec.len()
    }
    pub fn is_empty(&self) -> bool {
        self.vec.is_empty()
    }
    pub fn capacity(&self) -> usize {
        self.vec.capacity()
    }
    pub fn clear(&mut self) {
        self.vec.clear();
    }
    pub fn truncate(&mut self, n: usize) {
        // (a byte inside a char: the String would no longer be UTF-8)
        if n < self.vec.len && (unsafe { *self.vec.ptr.add(n) } & 0xC0) == 0x80 {
            panic!("assertion failed: self.is_char_boundary(n)");
        }
        self.vec.truncate(n);
    }
    pub fn as_bytes(&self) -> &[u8] {
        self.vec.as_slice()
    }
    pub fn insert<G>(&mut self, idx: usize, c: char) {
        let mut t = String::new();
        t.push(c);
        self.insert_str::<()>(idx, t.as_str());
    }
    pub fn insert_str<G>(&mut self, idx: usize, s: &str) {
        let n = s.len();
        let old = self.vec.len;
        if idx > old {
            panic!("insertion index is out of bounds");
        }
        // (a byte inside a char: the String would no longer be UTF-8)
        if idx < self.vec.len && (unsafe { *self.vec.ptr.add(idx) } & 0xC0) == 0x80 {
            panic!("assertion failed: self.is_char_boundary(idx)");
        }
        self.vec.reserve(n);
        unsafe {
            let p = self.vec.ptr;
            let mut i = old;
            while i > idx {
                i -= 1;
                *p.add(i + n) = *p.add(i);
            }
            let q = s.as_ptr();
            let mut j = 0;
            while j < n {
                *p.add(idx + j) = *q.add(j);
                j += 1;
            }
        }
        self.vec.len = old + n;
    }
    pub fn remove<G>(&mut self, idx: usize) -> char {
        if idx >= self.vec.len {
            panic!("cannot remove a char from the end of a string");
        }
        // (a byte inside a char: the String would no longer be UTF-8)
        if idx < self.vec.len && (unsafe { *self.vec.ptr.add(idx) } & 0xC0) == 0x80 {
            panic!("assertion failed: self.is_char_boundary(idx)");
        }
        let (c, n) = __exr_decode_at::<()>(self.vec.ptr as *const u8, idx);
        unsafe {
            let p = self.vec.ptr;
            let mut i = idx;
            while i + n < self.vec.len {
                *p.add(i) = *p.add(i + n);
                i += 1;
            }
        }
        self.vec.len -= n;
        c
    }
    pub fn pop<G>(&mut self) -> Option<char> {
        if self.vec.len == 0 {
            return None;
        }
        let mut i = self.vec.len - 1;
        while i > 0 && unsafe { *self.vec.ptr.add(i) } >= 0x80 && unsafe { *self.vec.ptr.add(i) } < 0xC0 {
            i -= 1;
        }
        Some(self.remove::<()>(i))
    }
    pub fn retain<F: FnMut(char) -> bool>(&mut self, f: F) {
        let mut f = f;
        let mut r = String::with_capacity(self.vec.len);
        let mut i = 0;
        while i < self.vec.len {
            let (c, n) = __exr_decode_at::<()>(self.vec.ptr as *const u8, i);
            if f(c) {
                r.push(c);
            }
            i += n;
        }
        let t = self.vec.ptr;
        let tc = self.vec.cap;
        self.vec.ptr = r.vec.ptr;
        self.vec.cap = r.vec.cap;
        self.vec.len = r.vec.len;
        r.vec.ptr = t;
        r.vec.cap = tc;
        r.vec.len = 0;
    }
    // `s + "x"` / `s += "x"` (codegen が演算子をこのメソッドにする)
    pub fn add<G>(self, t: &str) -> String {
        let mut s = self;
        s.push_str(t);
        s
    }
    pub fn add_assign<G>(&mut self, t: &str) {
        self.push_str(t);
    }
    // (`String::from_utf8_lossy(..)` は String を返すので、Cow の into_owned / to_mut はそのまま)
    pub fn into_owned(self) -> String {
        self
    }
    pub fn into_bytes(self) -> Vec<u8> {
        self.vec
    }
    pub fn replace_range(&mut self, r: Range<usize>, with: &str) {
        let b = self.as_bytes();
        if r.start > r.end || r.end > b.len() {
            panic!("range end index {} out of range for slice of length {}", r.end, b.len());
        }
        if (r.start < b.len() && (b[r.start] & 0xC0) == 0x80) || (r.end < b.len() && (b[r.end] & 0xC0) == 0x80) {
            panic!("assertion failed: self.is_char_boundary(n)");
        }
        let mut v: Vec<u8> = Vec::with_capacity(b.len() - (r.end - r.start) + with.len());
        v.extend_from_slice(&b[..r.start]);
        v.extend_from_slice(with.as_bytes());
        v.extend_from_slice(&b[r.end..]);
        self.vec = v;
    }
    pub fn as_str(&self) -> &str {
        unsafe { core::str::from_utf8_unchecked(self.vec.as_slice()) }
    }
    pub fn as_mut_str(&mut self) -> &mut str {
        unsafe { &mut *(self.vec.as_mut_slice() as *mut [u8] as *mut str) }
    }
    pub fn clone(&self) -> String {
        String {
            vec: self.vec.clone(),
        }
    }
    pub fn eq(&self, other: &String) -> bool {
        self.vec.eq(&other.vec)
    }
}
// --- Iterator ------------------------------------------------------------------------------
// (このファイルは zustc だけがコンパイルする。アダプタの struct には、関連型を決めるための
//  使わない型パラメータを持たせている: `Map<I, F, B>` の B など)

// (std's default len, for `impl ExactSizeIterator for X {}`: size_hint's lower bound, which std asserts is also the
// upper one, in every build. Each impl gets its own instance, so `self.size_hint()` is the type's)
pub trait ExactSizeIterator: Iterator {
    fn len(&self) -> usize {
        let (lower, upper) = self.size_hint();
        match upper {
            Some(u) if u == lower => {}
            Some(u) => panic!("assertion `left == right` failed\n  left: Some({})\n right: Some({})", u, lower),
            None => panic!("assertion `left == right` failed\n  left: None\n right: Some({})", lower),
        }
        lower
    }
}

// (the trait, for a program's `impl DoubleEndedIterator for X`: the prelude's own iterators keep next_back as a method of
// each type, which `rev()` calls by name)
pub trait DoubleEndedIterator: Iterator {
    fn next_back(&mut self) -> Option<Self::Item>;
}

// (a marker: the default method only lets the selection find the trait)
pub trait FusedIterator {
    fn __fused_mark(&self) {}
}

pub trait Iterator {
    type Item;
    fn next(&mut self) -> Option<Self::Item>;
    fn map<B, F: FnMut(Self::Item) -> B>(self, f: F) -> Map<Self, F, B> {
        Map { iter: self, f: f }
    }
    fn filter<P: FnMut(&Self::Item) -> bool>(self, p: P) -> Filter<Self, P> {
        Filter { iter: self, p: p }
    }
    fn filter_map<B, F: FnMut(Self::Item) -> Option<B>>(self, f: F) -> FilterMap<Self, F, B> {
        FilterMap { iter: self, f: f }
    }
    fn enumerate(self) -> Enumerate<Self> {
        Enumerate { iter: self, n: 0 }
    }
    fn take(self, n: usize) -> Take<Self> {
        Take { iter: self, n: n }
    }
    fn skip(self, n: usize) -> Skip<Self> {
        Skip { iter: self, n: n }
    }
    fn take_while<P: FnMut(&Self::Item) -> bool>(self, p: P) -> TakeWhile<Self, P> {
        TakeWhile { iter: self, p: p, done: false }
    }
    fn zip<U: Iterator>(self, other: U) -> Zip<Self, U> {
        Zip { a: self, b: other }
    }
    fn chain<U: Iterator<Item = Self::Item>>(self, other: U) -> Chain<Self, U> {
        Chain { a: self, b: other, first: true }
    }
    fn copied<T>(self) -> Copied<Self, T>
    where
        Self: Iterator<Item = &T>,
    {
        Copied { iter: self }
    }
    fn cloned<T>(self) -> Cloned<Self, T>
    where
        Self: Iterator<Item = &T>,
    {
        Cloned { iter: self }
    }
    fn flat_map<U, B, F: FnMut(Self::Item) -> U>(self, f: F) -> FlatMap<Self, F, U, B>
    where
        U: __Flat<Item = B>,
    {
        FlatMap { iter: self, f: f, cur: None }
    }
    fn flatten<U, B>(self) -> Flatten<Self, U, B>
    where
        Self: Iterator<Item = U>,
        U: __Flat<Item = B>,
    {
        Flatten { iter: self, cur: None }
    }
    // (flat_map / flatten の中身として回すとき: イテレータはそのまま)
    fn __flat_prep(&mut self) {}
    fn __flat_next(&mut self) -> Option<Self::Item> {
        self.next()
    }
    fn by_ref(&mut self) -> &mut Self {
        self
    }
    fn fuse(self) -> Fuse<Self> {
        Fuse { iter: Some(self) }
    }
    fn rev(self) -> Rev<Self> {
        Rev { iter: self }
    }
    fn step_by(self, step: usize) -> StepBy<Self> {
        if step == 0 {
            panic!("assertion failed: step != 0");
        }
        StepBy { iter: self, step: step, first: true }
    }
    fn peekable<T>(self) -> Peekable<Self, T>
    where
        Self: Iterator<Item = T>,
    {
        Peekable { iter: self, peeked: None, has: false }
    }
    fn skip_while<P: FnMut(&Self::Item) -> bool>(self, p: P) -> SkipWhile<Self, P> {
        SkipWhile { iter: self, p: p, done: false }
    }
    fn scan<St, B, F: FnMut(&mut St, Self::Item) -> Option<B>>(self, init: St, f: F) -> Scan<Self, St, F, B> {
        Scan { iter: self, st: init, f: f }
    }
    fn inspect<F: FnMut(&Self::Item)>(self, f: F) -> Inspect<Self, F> {
        Inspect { iter: self, f: f }
    }
    fn count(self) -> usize {
        let mut it = self;
        let mut n = 0;
        while let Some(_) = it.next() {
            n += 1;
        }
        n
    }
    // (Item = S の制約は型推論の手がかり: `let s: i64 = (1..=10).sum();` の 1 を i64 にする)
    // (std と同じく、呼び出し側のオーバーフロー検査の設定に従う)
    #[rustc_inherit_overflow_checks]
    fn sum<S>(self) -> S
    where
        Self: Iterator<Item = S>,
    {
        let mut it = self;
        let mut acc: S = 0;
        while let Some(x) = it.next() {
            acc = acc + x;
        }
        acc
    }
    #[rustc_inherit_overflow_checks]
    fn product<S>(self) -> S
    where
        Self: Iterator<Item = S>,
    {
        let mut it = self;
        let mut acc: S = 1;
        while let Some(x) = it.next() {
            acc = acc * x;
        }
        acc
    }
    fn fold<B, F: FnMut(B, Self::Item) -> B>(self, init: B, f: F) -> B {
        let mut it = self;
        let mut f = f;
        let mut acc = init;
        while let Some(x) = it.next() {
            acc = f(acc, x);
        }
        acc
    }
    fn for_each<F: FnMut(Self::Item)>(self, f: F) {
        let mut it = self;
        let mut f = f;
        while let Some(x) = it.next() {
            f(x);
        }
    }
    fn any<F: FnMut(Self::Item) -> bool>(&mut self, f: F) -> bool {
        let mut f = f;
        while let Some(x) = self.next() {
            if f(x) {
                return true;
            }
        }
        false
    }
    fn all<F: FnMut(Self::Item) -> bool>(&mut self, f: F) -> bool {
        let mut f = f;
        while let Some(x) = self.next() {
            if !f(x) {
                return false;
            }
        }
        true
    }
    fn find<P: FnMut(&Self::Item) -> bool>(&mut self, p: P) -> Option<Self::Item> {
        let mut p = p;
        while let Some(x) = self.next() {
            if p(&x) {
                return Some(x);
            }
        }
        None
    }
    fn find_map<B, F: FnMut(Self::Item) -> Option<B>>(&mut self, f: F) -> Option<B> {
        let mut f = f;
        while let Some(x) = self.next() {
            if let Some(y) = f(x) {
                return Some(y);
            }
        }
        None
    }
    fn position<P: FnMut(Self::Item) -> bool>(&mut self, p: P) -> Option<usize> {
        let mut p = p;
        let mut i = 0;
        while let Some(x) = self.next() {
            if p(x) {
                return Some(i);
            }
            i += 1;
        }
        None
    }
    // (要素が `&T` で受け手が `Vec<T>` なら中身を写す: codegen が `__push_auto` を push か push(*x) にする)
    fn partition<T, F: FnMut(&Self::Item) -> bool>(self, f: F) -> (Vec<T>, Vec<T>) {
        let mut it = self;
        let mut f = f;
        let mut a: Vec<T> = Vec::new();
        let mut b: Vec<T> = Vec::new();
        while let Some(x) = it.next() {
            if f(&x) {
                a.__push_auto(x);
            } else {
                b.__push_auto(x);
            }
        }
        (a, b)
    }
    // `it.unzip()` of (a, b) pairs: the a's and the b's
    fn unzip<A, B>(self) -> (Vec<A>, Vec<B>) {
        let mut it = self;
        let mut a: Vec<A> = Vec::new();
        let mut b: Vec<B> = Vec::new();
        while let Some((x, y)) = it.next() {
            a.push(x);
            b.push(y);
        }
        (a, b)
    }
    // 2 つの列が同じ要素を同じ順に持つか
    fn eq<I: Iterator>(self, other: I) -> bool {
        let mut a = self;
        let mut b = other;
        loop {
            match (a.next(), b.next()) {
                (Some(x), Some(y)) => {
                    if x != y {
                        return false;
                    }
                }
                (None, None) => return true,
                _ => return false,
            }
        }
    }
    // 終わったら最初から (元のイテレータを複製しておく)
    fn cycle(self) -> Cycle<Self> {
        Cycle { orig: __exr_clone(&self), cur: self }
    }
    // (前から全部見て、最後に当たった位置)
    fn rposition<P: FnMut(Self::Item) -> bool>(&mut self, p: P) -> Option<usize> {
        let mut p = p;
        let mut i = 0;
        let mut r = None;
        while let Some(x) = self.next() {
            if p(x) {
                r = Some(i);
            }
            i += 1;
        }
        r
    }
    fn last(self) -> Option<Self::Item> {
        let mut it = self;
        let mut r = None;
        while let Some(x) = it.next() {
            r = Some(x);
        }
        r
    }
    fn nth(&mut self, n: usize) -> Option<Self::Item> {
        let mut i = 0;
        while let Some(x) = self.next() {
            if i == n {
                return Some(x);
            }
            i += 1;
        }
        None
    }
    fn max(self) -> Option<Self::Item> {
        let mut it = self;
        let mut r = it.next();
        while let Some(x) = it.next() {
            let bigger = match &r {
                Some(m) => x >= *m,
                None => true,
            };
            if bigger {
                r = Some(x);
            }
        }
        r
    }
    fn min(self) -> Option<Self::Item> {
        let mut it = self;
        let mut r = it.next();
        while let Some(x) = it.next() {
            let smaller = match &r {
                Some(m) => x < *m,
                None => true,
            };
            if smaller {
                r = Some(x);
            }
        }
        r
    }
    fn collect<C: __FromIter>(self) -> C {
        <C as __FromIter>::__from_iter(self)
    }
    fn max_by_key<B: Ord, F: FnMut(&Self::Item) -> B>(self, f: F) -> Option<Self::Item> {
        let mut it = self;
        let mut f = f;
        let mut best = match it.next() {
            Some(x) => x,
            None => return None,
        };
        let mut bk = f(&best);
        while let Some(x) = it.next() {
            let k = f(&x);
            if __exr_cmp::<B>(&k, &bk) >= 0 {
                best = x;
                bk = k;
            }
        }
        Some(best)
    }
    fn min_by_key<B: Ord, F: FnMut(&Self::Item) -> B>(self, f: F) -> Option<Self::Item> {
        let mut it = self;
        let mut f = f;
        let mut best = match it.next() {
            Some(x) => x,
            None => return None,
        };
        let mut bk = f(&best);
        while let Some(x) = it.next() {
            let k = f(&x);
            if __exr_cmp::<B>(&k, &bk) < 0 {
                best = x;
                bk = k;
            }
        }
        Some(best)
    }
    fn max_by<F: FnMut(&Self::Item, &Self::Item) -> Ordering>(self, f: F) -> Option<Self::Item> {
        let mut it = self;
        let mut f = f;
        let mut best = match it.next() {
            Some(x) => x,
            None => return None,
        };
        while let Some(x) = it.next() {
            if __exr_ord_i32::<()>(&f(&x, &best)) >= 0 {
                best = x;
            }
        }
        Some(best)
    }
    fn min_by<F: FnMut(&Self::Item, &Self::Item) -> Ordering>(self, f: F) -> Option<Self::Item> {
        let mut it = self;
        let mut f = f;
        let mut best = match it.next() {
            Some(x) => x,
            None => return None,
        };
        while let Some(x) = it.next() {
            if __exr_ord_i32::<()>(&f(&x, &best)) < 0 {
                best = x;
            }
        }
        Some(best)
    }
}

pub trait __FromIter {
    fn __from_iter<I: Iterator>(it: I) -> Self;
}

impl<T> __FromIter for Vec<T> {
    fn __from_iter<I: Iterator>(it: I) -> Vec<T> {
        let mut it = it;
        let mut v = Vec::new();
        while let Some(x) = it.next() {
            v.push(x);
        }
        v
    }
}

// `Option<Vec<T>>` / `Result<Vec<T>, E>`: 途中で None / Err があればそれ
impl<T> __FromIter for Option<Vec<T>> {
    fn __from_iter<I: Iterator>(it: I) -> Option<Vec<T>> {
        let mut it = it;
        let mut v = Vec::new();
        while let Some(x) = it.next() {
            match x {
                Some(y) => v.push(y),
                None => return None,
            }
        }
        Some(v)
    }
}

impl<T, E> __FromIter for Result<Vec<T>, E> {
    fn __from_iter<I: Iterator>(it: I) -> Result<Vec<T>, E> {
        let mut it = it;
        let mut v = Vec::new();
        while let Some(x) = it.next() {
            match x {
                Ok(y) => v.push(y),
                Err(e) => return Err(e),
            }
        }
        Ok(v)
    }
}

impl __FromIter for String {
    fn __from_iter<I: Iterator>(it: I) -> String {
        let mut it = it;
        let mut s = String::new();
        while let Some(c) = it.next() {
            // (要素が char なら push、&str / String なら push_str。codegen が要素の型で選ぶ)
            s.__push_piece(c);
        }
        s
    }
}

pub struct Map<I, F, B> {
    iter: I,
    f: F,
}

impl<I: Iterator, F: FnMut(I::Item) -> B, B> Iterator for Map<I, F, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        match self.iter.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

pub struct Filter<I, P> {
    iter: I,
    p: P,
}

impl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for Filter<I, P> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        while let Some(x) = self.iter.next() {
            if (self.p)(&x) {
                return Some(x);
            }
        }
        None
    }
}

pub struct FilterMap<I, F, B> {
    iter: I,
    f: F,
}

impl<I: Iterator, F: FnMut(I::Item) -> Option<B>, B> Iterator for FilterMap<I, F, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        while let Some(x) = self.iter.next() {
            if let Some(y) = (self.f)(x) {
                return Some(y);
            }
        }
        None
    }
}

pub struct Enumerate<I> {
    iter: I,
    n: usize,
}

impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (usize, I::Item);
    fn next(&mut self) -> Option<(usize, I::Item)> {
        match self.iter.next() {
            Some(x) => {
                let i = self.n;
                self.n += 1;
                Some((i, x))
            }
            None => None,
        }
    }
}

pub struct Take<I> {
    iter: I,
    n: usize,
}

impl<I: Iterator> Iterator for Take<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.n == 0 {
            return None;
        }
        self.n -= 1;
        self.iter.next()
    }
}

// `std::iter::repeat` / `once` / `empty` / `repeat_with` / `successors`
pub struct __IterRepeat<T> {
    v: T,
}
// (no `T: Clone` on the impl: the bound is checked where `repeat` is called)
impl<T> Iterator for __IterRepeat<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        Some(self.v.clone())
    }
}
pub fn __core_repeat<T: Clone>(v: T) -> __IterRepeat<T> {
    __IterRepeat { v: v }
}
pub type Repeat<T> = __IterRepeat<T>;
pub struct __IterOnce<T> {
    v: Option<T>,
}
impl<T> Iterator for __IterOnce<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        self.v.take()
    }
}
pub fn __core_once<T>(v: T) -> __IterOnce<T> {
    __IterOnce { v: Some(v) }
}
pub struct __IterEmpty<T> {
    _p: PhantomData<T>,
}
impl<T> Iterator for __IterEmpty<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        None
    }
}
pub type Empty<T> = __IterEmpty<T>;
pub fn __core_empty<T>() -> __IterEmpty<T> {
    __IterEmpty { _p: PhantomData }
}
pub struct __IterRepeatWith<F> {
    f: F,
}
impl<T, F: FnMut() -> T> Iterator for __IterRepeatWith<F> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        Some((self.f)())
    }
}
pub fn __core_repeat_with<T, F: FnMut() -> T>(f: F) -> __IterRepeatWith<F> {
    __IterRepeatWith { f: f }
}
pub struct __IterSuccessors<T, F> {
    next: Option<T>,
    f: F,
}
impl<T, F: FnMut(&T) -> Option<T>> Iterator for __IterSuccessors<T, F> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        let cur = self.next.take()?;
        self.next = (self.f)(&cur);
        Some(cur)
    }
}
pub fn __core_successors<T, F: FnMut(&T) -> Option<T>>(first: Option<T>, f: F) -> __IterSuccessors<T, F> {
    __IterSuccessors { next: first, f: f }
}

pub struct Fuse<I> {
    iter: Option<I>,
}
impl<I: Iterator> Iterator for Fuse<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        let r = match &mut self.iter {
            Some(it) => it.next(),
            None => return None,
        };
        if r.is_none() {
            self.iter = None;
        }
        r
    }
}

pub struct Skip<I> {
    iter: I,
    n: usize,
}

impl<I: Iterator> Iterator for Skip<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        while self.n > 0 {
            self.n -= 1;
            if self.iter.next().is_none() {
                return None;
            }
        }
        self.iter.next()
    }
}

pub struct TakeWhile<I, P> {
    iter: I,
    p: P,
    done: bool,
}

impl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for TakeWhile<I, P> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.done {
            return None;
        }
        match self.iter.next() {
            Some(x) => {
                if (self.p)(&x) {
                    Some(x)
                } else {
                    self.done = true;
                    None
                }
            }
            None => None,
        }
    }
}

pub struct Zip<A, B> {
    a: A,
    b: B,
}

impl<A: Iterator, B: Iterator> Iterator for Zip<A, B> {
    type Item = (A::Item, B::Item);
    fn next(&mut self) -> Option<(A::Item, B::Item)> {
        match self.a.next() {
            Some(x) => match self.b.next() {
                Some(y) => Some((x, y)),
                None => None,
            },
            None => None,
        }
    }
}

pub struct Chain<A, B> {
    a: A,
    b: B,
    first: bool,
}

impl<A: Iterator, B: Iterator> Iterator for Chain<A, B> {
    type Item = A::Item;
    fn next(&mut self) -> Option<A::Item> {
        if self.first {
            match self.a.next() {
                Some(x) => return Some(x),
                None => self.first = false,
            }
        }
        self.b.next()
    }
}

// flat_map / flatten: 中身 (Vec / Option / イテレータ) を順に回す。IntoIterator の代わりに __Flat
pub trait __Flat {
    type Item;
    fn __flat_mark(&self) {}
}

// (impl はメソッドから選ばれるので印のメソッドを持たせる)
impl<T> __Flat for Vec<T> {
    type Item = T;
    fn __flat_mark(&self) {}
}

impl<T> __Flat for Option<T> {
    type Item = T;
    fn __flat_mark(&self) {}
}

pub struct FlatMap<I, F, U, B> {
    iter: I,
    f: F,
    cur: Option<U>,
}

impl<I: Iterator, F: FnMut(I::Item) -> U, U, B> Iterator for FlatMap<I, F, U, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        loop {
            if let Some(u) = &mut self.cur {
                if let Some(x) = u.__flat_next() {
                    return Some(x);
                }
            }
            match self.iter.next() {
                Some(a) => {
                    let mut u = (self.f)(a);
                    u.__flat_prep();
                    self.cur = Some(u);
                }
                None => return None,
            }
        }
    }
}

pub struct Flatten<I, U, B> {
    iter: I,
    cur: Option<U>,
}

impl<I: Iterator, U, B> Iterator for Flatten<I, U, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        loop {
            if let Some(u) = &mut self.cur {
                if let Some(x) = u.__flat_next() {
                    return Some(x);
                }
            }
            match self.iter.next() {
                Some(a) => {
                    let mut u = a;
                    u.__flat_prep();
                    self.cur = Some(u);
                }
                None => return None,
            }
        }
    }
}

// 参照の列 (&Vec<T> / &[T] / &[T; N]) の flatten: 中身を参照で順に (`it.flat_map(|x| x.iter())` と同じ)
pub struct FlattenRef<I, T> {
    iter: I,
    cur: Option<Iter<T>>,
}

impl<I: Iterator, T> Iterator for FlattenRef<I, T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        loop {
            if let Some(c) = &mut self.cur {
                if let Some(x) = c.next() {
                    return Some(x);
                }
            }
            match self.iter.next() {
                Some(a) => self.cur = Some(__exr_slice_iter(&a[..])),
                None => return None,
            }
        }
    }
}

fn __exr_flatten_ref<I: Iterator, T>(it: I) -> FlattenRef<I, T> {
    FlattenRef { iter: it, cur: None }
}

pub struct Cycle<I> {
    orig: I,
    cur: I,
}

impl<I: Iterator> Iterator for Cycle<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        match self.cur.next() {
            Some(x) => Some(x),
            None => {
                self.cur = __exr_clone(&self.orig);
                self.cur.next()
            }
        }
    }
}

// rev(): 後ろから (next_back を持つイテレータだけ)
pub struct Rev<I> {
    iter: I,
}

impl<I: Iterator> Iterator for Rev<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        self.iter.next_back()
    }
}

impl<I: Iterator> Rev<I> {
    pub fn next_back(&mut self) -> Option<I::Item> {
        self.iter.next()
    }
}

pub struct StepBy<I> {
    iter: I,
    step: usize,
    first: bool,
}

impl<I: Iterator> Iterator for StepBy<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.first {
            self.first = false;
            self.iter.next()
        } else {
            self.iter.nth(self.step - 1)
        }
    }
}

pub struct Peekable<I, T> {
    iter: I,
    peeked: Option<T>,
    has: bool,
}

impl<I: Iterator, T> Iterator for Peekable<I, T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        if self.has {
            self.has = false;
            self.peeked.take()
        } else {
            self.iter.next()
        }
    }
}

impl<I: Iterator, T> Peekable<I, T> {
    pub fn peek(&mut self) -> Option<&T> {
        if !self.has {
            self.peeked = self.iter.next();
            self.has = true;
        }
        self.peeked.as_ref()
    }
    pub fn next_if<F: FnOnce(&T) -> bool>(&mut self, f: F) -> Option<T> {
        let ok = match self.peek() {
            Some(x) => f(x),
            None => false,
        };
        if ok { self.next() } else { None }
    }
}

pub struct SkipWhile<I, P> {
    iter: I,
    p: P,
    done: bool,
}

impl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for SkipWhile<I, P> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        loop {
            let x = self.iter.next()?;
            if self.done || !(self.p)(&x) {
                self.done = true;
                return Some(x);
            }
        }
    }
}

pub struct Scan<I, St, F, B> {
    iter: I,
    st: St,
    f: F,
}

impl<I: Iterator, St, F: FnMut(&mut St, I::Item) -> Option<B>, B> Iterator for Scan<I, St, F, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        match self.iter.next() {
            Some(x) => (self.f)(&mut self.st, x),
            None => None,
        }
    }
}

pub struct Inspect<I, F> {
    iter: I,
    f: F,
}

impl<I: Iterator, F: FnMut(&I::Item)> Iterator for Inspect<I, F> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        let x = self.iter.next()?;
        (self.f)(&x);
        Some(x)
    }
}

// 後ろからの next (rev() 用。DoubleEndedIterator の代わりに各型のメソッドとして持つ)
impl<I: Iterator, F: FnMut(I::Item) -> B, B> Map<I, F, B> {
    pub fn next_back(&mut self) -> Option<B> {
        match self.iter.next_back() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

impl<I: Iterator, P: FnMut(&I::Item) -> bool> Filter<I, P> {
    pub fn next_back(&mut self) -> Option<I::Item> {
        while let Some(x) = self.iter.next_back() {
            if (self.p)(&x) {
                return Some(x);
            }
        }
        None
    }
}

impl<A: Iterator, B: Iterator> Chain<A, B> {
    pub fn next_back(&mut self) -> Option<A::Item> {
        match self.b.next_back() {
            Some(x) => Some(x),
            None => self.a.next_back(),
        }
    }
}

impl<I: Iterator, T: Copy> Copied<I, T> {
    pub fn next_back(&mut self) -> Option<T> {
        match self.iter.next_back() {
            Some(x) => Some(*x),
            None => None,
        }
    }
}

pub struct Copied<I, T> {
    iter: I,
}

pub struct Cloned<I, T> {
    iter: I,
}

impl<I: Iterator, T> Iterator for Cloned<I, T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        match self.iter.next() {
            Some(x) => Some(x.clone()),
            None => None,
        }
    }
}

impl<I: Iterator, T> Cloned<I, T> {
    pub fn next_back(&mut self) -> Option<T> {
        match self.iter.next_back() {
            Some(x) => Some(x.clone()),
            None => None,
        }
    }
}

impl<I: Iterator, T: Copy> Iterator for Copied<I, T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        match self.iter.next() {
            Some(x) => Some(*x),
            None => None,
        }
    }
}

// `a..b` / `a..=b` を値として使ったとき (for で直接回すときは codegen が数える)
pub struct Range<T> {
    pub start: T,
    pub end: T,
}

impl<T: Copy + Ord> Iterator for Range<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        if self.start < self.end {
            let v = self.start;
            self.start = v + 1;
            Some(v)
        } else {
            None
        }
    }
}

// BTreeMap::range の添字の範囲 [a, b)
impl<T> Range<T> {
    pub fn __bt_span<V>(&self, m: &BTreeMap<T, V>) -> (usize, usize) {
        (m.bt_find(&self.start).0, m.bt_find(&self.end).0)
    }
}

impl<T> RangeInclusive<T> {
    pub fn __bt_span<V>(&self, m: &BTreeMap<T, V>) -> (usize, usize) {
        let (i, found) = m.bt_find(&self.end);
        (m.bt_find(&self.start).0, if found { i + 1 } else { i })
    }
}

impl<T> RangeFrom<T> {
    pub fn __bt_span<V>(&self, m: &BTreeMap<T, V>) -> (usize, usize) {
        (m.bt_find(&self.start).0, m.len())
    }
}

// `(1..)`: 終わりのない範囲
pub struct RangeFrom<T> {
    pub start: T,
}

impl<T: Copy + Ord> Iterator for RangeFrom<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        let v = self.start;
        self.start = v + 1;
        Some(v)
    }
}

// `..b` / `..=b` / `..` as types (`RangeTo<usize>` in a signature)
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct RangeTo<T> {
    pub end: T,
}

impl<T: Copy + Ord> RangeTo<T> {
    pub fn contains(&self, x: &T) -> bool {
        *x < self.end
    }
}

#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct RangeToInclusive<T> {
    pub end: T,
}

impl<T: Copy + Ord> RangeToInclusive<T> {
    pub fn contains(&self, x: &T) -> bool {
        *x <= self.end
    }
}

#[derive(Clone, Copy, PartialEq, Eq, Hash, Default)]
pub struct RangeFull;

impl<T: Copy + Ord> Range<T> {
    pub fn contains(&self, x: &T) -> bool {
        self.start <= *x && *x < self.end
    }
    pub fn is_empty(&self) -> bool {
        !(self.start < self.end)
    }
    pub fn next_back(&mut self) -> Option<T> {
        if self.start < self.end {
            self.end = self.end - 1;
            Some(self.end)
        } else {
            None
        }
    }
}

pub struct RangeInclusive<T> {
    pub start: T,
    pub end: T,
    pub done: bool,
}

impl<T: Copy + Ord> RangeInclusive<T> {
    pub fn contains(&self, x: &T) -> bool {
        self.start <= *x && *x <= self.end
    }
    pub fn is_empty(&self) -> bool {
        self.done || !(self.start <= self.end)
    }
    pub fn next_back(&mut self) -> Option<T> {
        if self.done || self.start > self.end {
            return None;
        }
        let v = self.end;
        if v == self.start {
            self.done = true;
        } else {
            self.end = v - 1;
        }
        Some(v)
    }
}

impl<T: Copy + Ord> Iterator for RangeInclusive<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        if self.done || self.start > self.end {
            return None;
        }
        let v = self.start;
        if v == self.end {
            self.done = true;
        } else {
            self.start = v + 1;
        }
        Some(v)
    }
}

// スライス・配列・Vec の iter() / iter_mut() / into_iter()
pub struct Iter<T> {
    ptr: *const T,
    len: usize,
    i: usize,
}

impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        if self.i < self.len {
            let p = unsafe { &*self.ptr.add(self.i) };
            self.i += 1;
            Some(p)
        } else {
            None
        }
    }
}

impl<T> Iter<T> {
    pub fn len(&self) -> usize {
        self.len - self.i
    }
    // (Iterator's, exact as std's for a slice)
    pub fn size_hint(&self) -> (usize, Option<usize>) {
        (self.len - self.i, Some(self.len - self.i))
    }
    pub fn as_slice(&self) -> &[T] {
        unsafe { core::slice::from_raw_parts(self.ptr.add(self.i), self.len - self.i) }
    }
    pub fn next_back(&mut self) -> Option<&T> {
        if self.i < self.len {
            self.len -= 1;
            Some(unsafe { &*self.ptr.add(self.len) })
        } else {
            None
        }
    }
}

pub struct IterMut<T> {
    ptr: *mut T,
    len: usize,
    i: usize,
}

impl<T> IterMut<T> {
    pub fn len(&self) -> usize {
        self.len - self.i
    }
    pub fn next_back(&mut self) -> Option<&mut T> {
        if self.i < self.len {
            self.len -= 1;
            Some(unsafe { &mut *self.ptr.add(self.len) })
        } else {
            None
        }
    }
}

impl<T> Iterator for IterMut<T> {
    type Item = &mut T;
    fn next(&mut self) -> Option<&mut T> {
        if self.i < self.len {
            let p = unsafe { &mut *self.ptr.add(self.i) };
            self.i += 1;
            Some(p)
        } else {
            None
        }
    }
}

fn __exr_slice_iter<T>(s: &[T]) -> Iter<T> {
    Iter {
        ptr: s.as_ptr(),
        len: s.len(),
        i: 0,
    }
}

fn __exr_slice_iter_mut<T>(s: &mut [T]) -> IterMut<T> {
    IterMut {
        ptr: s.as_mut_ptr(),
        len: s.len(),
        i: 0,
    }
}

pub struct IntoIter<T> {
    v: Vec<T>,
    i: usize,
}

impl<T> Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        if self.i < self.v.len {
            let x = unsafe { self.v.ptr.add(self.i).read() };
            self.i += 1;
            Some(x)
        } else {
            None
        }
    }
}

impl<T> IntoIter<T> {
    pub fn len(&self) -> usize {
        self.v.len - self.i
    }
    pub fn next_back(&mut self) -> Option<T> {
        if self.i < self.v.len {
            self.v.len -= 1;
            Some(unsafe { self.v.ptr.add(self.v.len).read() })
        } else {
            None
        }
    }
}

impl<T> Drop for IntoIter<T> {
    // 取り出していない要素を drop する (バッファは Vec の drop が解放する)
    fn drop(&mut self) {
        while self.i < self.v.len {
            unsafe {
                __exr_drop_in_place(self.v.ptr.add(self.i));
            }
            self.i += 1;
        }
        self.v.len = 0;
    }
}

impl<T> Vec<T> {
    pub fn iter(&self) -> Iter<T> {
        Iter {
            ptr: self.ptr as *const T,
            len: self.len,
            i: 0,
        }
    }
    pub fn iter_mut(&mut self) -> IterMut<T> {
        IterMut {
            ptr: self.ptr,
            len: self.len,
            i: 0,
        }
    }
    pub fn into_iter(self) -> IntoIter<T> {
        IntoIter { v: self, i: 0 }
    }
}

impl String {
    pub fn chars(&self) -> Chars {
        Chars {
            ptr: self.vec.ptr as *const u8,
            len: self.vec.len,
            i: 0,
        }
    }
    pub fn bytes(&self) -> Copied<Iter<u8>, u8> {
        Copied {
            iter: __exr_slice_iter(self.as_bytes()),
        }
    }
}

// UTF-8 を char に復号しながら回す
pub struct Chars {
    ptr: *const u8,
    len: usize,
    i: usize,
}

impl Iterator for Chars {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        if self.i >= self.len {
            return None;
        }
        let b0 = unsafe { *self.ptr.add(self.i) } as u32;
        let (c, n) = if b0 < 0x80 {
            (b0, 1)
        } else if b0 < 0xE0 {
            ((b0 & 0x1F) << 6 | (unsafe { *self.ptr.add(self.i + 1) } as u32 & 0x3F), 2)
        } else if b0 < 0xF0 {
            (
                (b0 & 0x0F) << 12
                    | (unsafe { *self.ptr.add(self.i + 1) } as u32 & 0x3F) << 6
                    | (unsafe { *self.ptr.add(self.i + 2) } as u32 & 0x3F),
                3,
            )
        } else {
            (
                (b0 & 0x07) << 18
                    | (unsafe { *self.ptr.add(self.i + 1) } as u32 & 0x3F) << 12
                    | (unsafe { *self.ptr.add(self.i + 2) } as u32 & 0x3F) << 6
                    | (unsafe { *self.ptr.add(self.i + 3) } as u32 & 0x3F),
                4,
            )
        };
        self.i += n;
        Some(unsafe { __exr_char_from_u32(c) })
    }
}

impl Chars {
    // まだ読んでいない残り
    pub fn as_str(&self) -> &str {
        __exr_sub::<()>(unsafe { self.ptr.add(self.i) }, self.len - self.i)
    }
    pub fn next_back(&mut self) -> Option<char> {
        if self.i >= self.len {
            return None;
        }
        let mut j = self.len - 1;
        while j > self.i && unsafe { *self.ptr.add(j) } >= 0x80 && unsafe { *self.ptr.add(j) } < 0xC0 {
            j -= 1;
        }
        let (c, _) = __exr_decode_at::<()>(self.ptr, j);
        self.len = j;
        Some(c)
    }
    // (DoubleEndedIterator's: the characters from the back)
    pub fn rfold<B, F: FnMut(B, char) -> B>(self, init: B, f: F) -> B {
        let mut it = self;
        let mut f = f;
        let mut acc = init;
        while let Some(c) = it.next_back() {
            acc = f(acc, c);
        }
        acc
    }
}

fn __exr_str_chars<G>(s: &str) -> Chars {
    Chars {
        ptr: s.as_ptr(),
        len: s.len(),
        i: 0,
    }
}
// --- 書式化 (format! / println! / write! と Display / Debug) ----------------------------------
// マクロは codegen が展開し、値ごとに `__exr_display::<T>` / `__exr_debug::<T>` (型ごとに codegen が
// 本体を作る) を呼ぶ。数値・文字列の書き出しとパディング、Debug の整形はここの関数が行う

// `std::fmt::Error`: a unit struct, as std's (`Err(fmt::Error)`)
pub struct __FmtError;

pub struct Formatter {
    buf: &mut String,
    // 書式指定 ({:>8} / {:08.3x} など)
    width: usize,
    fill_c: char,
    // 0 = 指定なし, 1 = <, 2 = >, 3 = ^
    align: u8,
    zero: bool,
    plus: bool,
    alt: bool,
    prec: usize,
    has_prec: bool,
    // 0 = {} / {:?}, 1 = x, 2 = X, 3 = b, 4 = o
    radix: u8,
    // {:#?} のインデントの深さ
    indent: usize,
}

pub trait Display {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError>;
}

// (`&0 as &dyn Display`: the vtable entry for a type the compiler formats itself)
fn __exr_dyn_display<T: Display>(x: &T, f: &mut Formatter) -> Result<(), __FmtError> {
    write!(f, "{}", x)
}
fn __exr_dyn_debug<T: Debug>(x: &T, f: &mut Formatter) -> Result<(), __FmtError> {
    write!(f, "{:?}", x)
}

pub trait Debug {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError>;
}

// (`fmt::Pointer`: zustc formats `{:p}` of a reference / pointer itself; `{:p}` of a type of the program's calls its
// impl)
pub trait Pointer {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError>;
}

// `f.debug_struct("P").field("x", &self.x).finish()` などのビルダー (derive(Debug) と同じ部品で書く)
pub struct DebugStruct {
    f: *mut Formatter,
    n: usize,
    kind: u8,
}

impl DebugStruct {
    pub fn field<T>(&mut self, name: &str, v: &T) -> &mut DebugStruct {
        let f = unsafe { &mut *self.f };
        __exr_dbg_item::<()>(f, self.n, name);
        __exr_debug(v, f);
        __exr_dbg_item_end::<()>(f);
        self.n += 1;
        self
    }
    pub fn finish(&mut self) -> Result<(), __FmtError> {
        __exr_dbg_end::<()>(unsafe { &mut *self.f }, self.n, self.kind, false);
        Ok(())
    }
    pub fn finish_non_exhaustive(&mut self) -> Result<(), __FmtError> {
        let f = unsafe { &mut *self.f };
        // (std's: `Name { .. }` with no fields, in `{:#?}` too; a pretty one's `..` has no comma after it)
        if self.n == 0 {
            if f.alt {
                f.indent -= 1;
                f.buf.pop_byte();
                f.buf.push(' ');
            }
            f.buf.push_str(".. }");
            return Ok(());
        }
        __exr_dbg_item::<()>(f, self.n, "");
        f.buf.push_str("..");
        if f.alt {
            f.buf.push('\n');
        }
        __exr_dbg_end::<()>(f, self.n + 1, self.kind, false);
        Ok(())
    }
}

// debug_tuple / debug_list / debug_set (名前のない要素)
pub struct DebugTuple {
    f: *mut Formatter,
    n: usize,
    kind: u8,
}

impl DebugTuple {
    pub fn field<T>(&mut self, v: &T) -> &mut DebugTuple {
        self.entry(v)
    }
    pub fn entry<T>(&mut self, v: &T) -> &mut DebugTuple {
        let f = unsafe { &mut *self.f };
        __exr_dbg_item::<()>(f, self.n, "");
        __exr_debug(v, f);
        __exr_dbg_item_end::<()>(f);
        self.n += 1;
        self
    }
    pub fn entries<I: Iterator>(&mut self, it: I) -> &mut DebugTuple {
        let mut it = it;
        while let Some(x) = it.next() {
            self.entry(&x);
        }
        self
    }
    pub fn finish(&mut self) -> Result<(), __FmtError> {
        __exr_dbg_end::<()>(unsafe { &mut *self.f }, self.n, self.kind, false);
        Ok(())
    }
}

pub struct DebugMap {
    f: *mut Formatter,
    n: usize,
}

impl DebugMap {
    pub fn entry<K, V>(&mut self, k: &K, v: &V) -> &mut DebugMap {
        let f = unsafe { &mut *self.f };
        __exr_dbg_item::<()>(f, self.n, "");
        __exr_debug(k, f);
        f.buf.push_str(": ");
        __exr_debug(v, f);
        __exr_dbg_item_end::<()>(f);
        self.n += 1;
        self
    }
    pub fn entries<K, V, I: Iterator<Item = (K, V)>>(&mut self, it: I) -> &mut DebugMap {
        let mut it = it;
        while let Some((k, v)) = it.next() {
            self.entry(&k, &v);
        }
        self
    }
    pub fn finish(&mut self) -> Result<(), __FmtError> {
        __exr_dbg_end::<()>(unsafe { &mut *self.f }, self.n, 3, false);
        Ok(())
    }
}

impl Formatter {
    pub fn debug_struct(&mut self, name: &str) -> DebugStruct {
        __exr_dbg_begin::<()>(self, name, 0);
        DebugStruct { f: self as *mut Formatter, n: 0, kind: 0 }
    }
    pub fn debug_tuple(&mut self, name: &str) -> DebugTuple {
        __exr_dbg_begin::<()>(self, name, 1);
        DebugTuple { f: self as *mut Formatter, n: 0, kind: 1 }
    }
    pub fn debug_list(&mut self) -> DebugTuple {
        __exr_dbg_begin::<()>(self, "", 2);
        DebugTuple { f: self as *mut Formatter, n: 0, kind: 2 }
    }
    pub fn debug_set(&mut self) -> DebugTuple {
        __exr_dbg_begin::<()>(self, "", 3);
        DebugTuple { f: self as *mut Formatter, n: 0, kind: 3 }
    }
    pub fn debug_map(&mut self) -> DebugMap {
        __exr_dbg_begin::<()>(self, "", 3);
        DebugMap { f: self as *mut Formatter, n: 0 }
    }
    // 書式指定を読む
    pub fn alternate(&self) -> bool {
        self.alt
    }
    pub fn sign_plus(&self) -> bool {
        self.plus
    }
    pub fn width(&self) -> Option<usize> {
        if self.width > 0 { Some(self.width) } else { None }
    }
    pub fn precision(&self) -> Option<usize> {
        if self.has_prec { Some(self.prec) } else { None }
    }
    // 幅・精度・寄せを効かせて文字列を書く
    pub fn pad(&mut self, s: &str) -> Result<(), __FmtError> {
        __exr_fmt_str::<()>(self, s);
        Ok(())
    }
    pub fn write_str(&mut self, s: &str) -> Result<(), __FmtError> {
        self.buf.push_str(s);
        Ok(())
    }
    pub fn write_char(&mut self, c: char) -> Result<(), __FmtError> {
        self.buf.push(c);
        Ok(())
    }
}

// format! の書き込み先: 書く長さの見積もりだけ先に確保した String
fn __exr_string_cap<G>(n: usize) -> String {
    let mut s = String::new();
    s.vec.reserve(n);
    s
}

fn __exr_formatter<G>(buf: &mut String) -> Formatter {
    Formatter {
        buf: buf,
        width: 0,
        fill_c: ' ',
        align: 0,
        zero: false,
        plus: false,
        alt: false,
        prec: 0,
        has_prec: false,
        radix: 0,
        indent: 0,
    }
}

fn __exr_fmt_spec<G>(
    f: &mut Formatter,
    width: usize,
    fill_c: char,
    align: u8,
    flags: u8,
    prec: usize,
    has_prec: bool,
    radix: u8,
) {
    f.width = width;
    f.fill_c = fill_c;
    f.align = align;
    f.zero = flags & 1 != 0;
    f.plus = flags & 2 != 0;
    f.alt = flags & 4 != 0;
    f.prec = prec;
    f.has_prec = has_prec;
    f.radix = radix;
}

// (a program's `write!(f, ..)` into a Formatter: a Formatter of its own over the same String, with no spec of its own,
// as std's `f.write_fmt(args)`; the indent of `{:#?}` is kept)
fn __exr_sub_formatter<G>(f: &mut Formatter) -> Formatter {
    let mut g = __exr_formatter::<()>(&mut *f.buf);
    g.indent = f.indent;
    g
}

fn __exr_fmt_lit<G>(f: &mut Formatter, s: &str) {
    f.buf.push_str(s);
}

// `{:?}` of a raw pointer: its address in hex (`0x7ffd..`), padded as a string
fn __exr_fmt_ptr<G>(f: &mut Formatter, a: usize) {
    let mut d: Vec<u8> = Vec::new();
    let mut v = a;
    loop {
        let x = (v % 16) as u8;
        d.push(if x < 10 { b'0' + x } else { b'a' + x - 10 });
        v /= 16;
        if v == 0 {
            break;
        }
    }
    let mut s = String::from(if f.plus { "+0x" } else { "0x" });
    let lead = s.len();
    let mut i = d.len();
    while i > 0 {
        i -= 1;
        s.push(d[i] as char);
    }
    // (`{:#p}` / `{:#?}`: zero-extended to the pointer's width, as std writes it; `{:010p}`: the zeros after `0x` (and
    // `+`))
    if f.alt {
        let (w, z) = (f.width, f.zero);
        if w == 0 {
            f.width = 2 + 2 * core::mem::size_of::<usize>();
        }
        f.zero = true;
        __exr_pad_lead::<()>(f, &s, lead);
        f.width = w;
        f.zero = z;
        return;
    }
    __exr_pad_lead::<()>(f, &s, lead);
}

// a number's text with `{:0w}`: the zeros after its first `lead` bytes (`0x`), as std pads a pointer; without the 0
// flag, __exr_pad's fill and alignment
fn __exr_pad_lead<G>(f: &mut Formatter, s: &str, lead: usize) {
    let sb = s.as_bytes();
    if !f.zero || f.width <= sb.len() {
        __exr_pad::<()>(f, s, 2);
        return;
    }
    f.buf.push_str(&s[..lead]);
    let mut z = f.width - sb.len();
    while z > 0 {
        f.buf.push('0');
        z -= 1;
    }
    f.buf.push_str(&s[lead..]);
}

// `{:p}` of a pointer to a `dyn`: `Pointer { addr: 0x.., metadata: DynMetadata(0x..) }`, the address and the vtable's
// each with the spec's width and flags, as std writes it (`{:#p}`: on lines)
fn __exr_fmt_dyn_ptr<G>(f: &mut Formatter, a: usize, vt: usize) {
    if f.alt {
        f.buf.push_str("Pointer {\n");
        f.indent += 1;
        __exr_indent::<()>(f);
        f.buf.push_str("addr: ");
        __exr_fmt_ptr::<()>(f, a);
        f.buf.push_str(",\n");
        __exr_indent::<()>(f);
        f.buf.push_str("metadata: DynMetadata(\n");
        f.indent += 1;
        __exr_indent::<()>(f);
        __exr_fmt_ptr::<()>(f, vt);
        f.buf.push_str(",\n");
        f.indent -= 1;
        __exr_indent::<()>(f);
        f.buf.push_str("),\n");
        f.indent -= 1;
        __exr_indent::<()>(f);
        f.buf.push('}');
    } else {
        f.buf.push_str("Pointer { addr: ");
        __exr_fmt_ptr::<()>(f, a);
        f.buf.push_str(", metadata: DynMetadata(");
        __exr_fmt_ptr::<()>(f, vt);
        f.buf.push_str(") }");
    }
}

// `{:p}` of a pointer to a slice / str: `Pointer { addr: 0x.., metadata: 5 }`, its address and length each with the
// spec's width and flags, as std writes it (`{:#p}`: on lines, the address zero-extended)
fn __exr_fmt_fat_ptr<G>(f: &mut Formatter, a: usize, n: usize) {
    let r = f.radix;
    let alt = f.alt;
    if alt {
        f.buf.push_str("Pointer {\n");
        f.indent += 1;
        __exr_indent::<()>(f);
        f.buf.push_str("addr: ");
    } else {
        f.buf.push_str("Pointer { addr: ");
    }
    __exr_fmt_ptr::<()>(f, a);
    if alt {
        f.buf.push_str(",\n");
        __exr_indent::<()>(f);
        f.buf.push_str("metadata: ");
    } else {
        f.buf.push_str(", metadata: ");
    }
    f.radix = 0;
    f.alt = false;
    __exr_fmt_int::<()>(f, n as u64, false);
    f.radix = r;
    f.alt = alt;
    if alt {
        f.buf.push_str(",\n");
        f.indent -= 1;
        __exr_indent::<()>(f);
        f.buf.push('}');
    } else {
        f.buf.push_str(" }");
    }
}

// 幅に足りない分を fill で埋める (既定の寄せは def_align)
fn __exr_pad<G>(f: &mut Formatter, s: &str, def_align: u8) {
    // 文字数 (UTF-8 の継続バイトは数えない)
    let mut n = 0;
    for &b in s.as_bytes() {
        if b & 0xC0 != 0x80 {
            n += 1;
        }
    }
    if n >= f.width {
        f.buf.push_str(s);
        return;
    }
    let pad = f.width - n;
    let align = if f.align == 0 { def_align } else { f.align };
    let (l, r) = if align == 1 {
        (0, pad)
    } else if align == 2 {
        (pad, 0)
    } else {
        (pad / 2, pad - pad / 2)
    };
    let mut i = 0;
    while i < l {
        f.buf.push(f.fill_c);
        i += 1;
    }
    f.buf.push_str(s);
    let mut i = 0;
    while i < r {
        f.buf.push(f.fill_c);
        i += 1;
    }
}

fn __exr_fmt_str<G>(f: &mut Formatter, s: &str) {
    if f.has_prec {
        // 精度は文字数での切り詰め
        let mut t = String::new();
        let mut n = 0;
        for &b in s.as_bytes() {
            if b & 0xC0 != 0x80 {
                if n == f.prec {
                    break;
                }
                n += 1;
            }
            t.vec.push(b);
        }
        __exr_pad::<()>(f, t.as_str(), 1);
    } else if f.width == 0 {
        f.buf.push_str(s);
    } else {
        __exr_pad::<()>(f, s, 1);
    }
}

fn __exr_fmt_base<G>(f: &Formatter) -> u64 {
    if f.radix == 1 || f.radix == 2 {
        16
    } else if f.radix == 3 {
        2
    } else if f.radix == 4 {
        8
    } else {
        10
    }
}

fn __exr_fmt_int<G>(f: &mut Formatter, mag: u64, neg: bool) {
    // 10 進で幅も符号の指定もない (`{}` の大半): 桁を後ろから詰め、まとめて足す (10 の割り算は掛け算になる)
    if f.radix == 0 && !f.plus && f.width == 0 {
        let mut d = [0u8; 24];
        let p = d.as_mut_ptr();
        let mut k: usize = 24;
        let mut v = mag;
        loop {
            k -= 1;
            unsafe {
                *p.add(k) = b'0' + (v % 10) as u8;
            }
            v /= 10;
            if v == 0 {
                break;
            }
        }
        if neg {
            k -= 1;
            unsafe {
                *p.add(k) = b'-';
            }
        }
        f.buf.vec.extend_from_slice(unsafe { core::slice::from_raw_parts(p.add(k) as *const u8, 24 - k) });
        return;
    }
    let base = __exr_fmt_base::<()>(f);
    let mut digits = [0u8; 64];
    let mut n = 0;
    let mut v = mag;
    loop {
        let d = (v % base) as u8;
        digits[n] = if d < 10 {
            b'0' + d
        } else if f.radix == 2 {
            b'A' + d - 10
        } else {
            b'a' + d - 10
        };
        n += 1;
        v /= base;
        if v == 0 {
            break;
        }
    }
    let mut s = String::new();
    if neg {
        s.push('-');
    } else if f.plus {
        s.push('+');
    }
    if f.alt {
        if base == 16 {
            s.push_str("0x");
        } else if base == 2 {
            s.push_str("0b");
        } else if base == 8 {
            s.push_str("0o");
        }
    }
    let prefix = s.len();
    // `{:05}`: 符号と 0x の後ろを 0 で埋める
    if f.zero && f.width > prefix + n {
        let mut z = f.width - prefix - n;
        while z > 0 {
            s.push('0');
            z -= 1;
        }
    }
    while n > 0 {
        n -= 1;
        s.push(digits[n] as char);
    }
    if f.zero {
        f.buf.push_str(s.as_str());
    } else {
        __exr_pad::<()>(f, s.as_str(), 2);
    }
}

// 128 bit: 64 bit に収まるまで、下の桁を base^k ずつ割り出す
fn __exr_fmt_int128<G>(f: &mut Formatter, mag: u128, neg: bool) {
    if mag >> 64 == 0 {
        __exr_fmt_int::<()>(f, mag as u64, neg);
        return;
    }
    let base = __exr_fmt_base::<()>(f);
    // (base^k が u64 に収まる最大の k)
    let mut k = 0;
    let mut chunk: u64 = 1;
    while chunk <= u64::MAX / base {
        chunk *= base;
        k += 1;
    }
    let mut digits = [0u8; 128];
    let mut n = 0;
    let mut v = mag;
    while v >> 64 != 0 {
        let mut lo = __exr_udiv128::<()>(v, chunk as u128, true) as u64;
        v = __exr_udiv128::<()>(v, chunk as u128, false);
        let mut i = 0;
        while i < k {
            let d = (lo % base) as u8;
            digits[n] = if d < 10 {
                b'0' + d
            } else if f.radix == 2 {
                b'A' + d - 10
            } else {
                b'a' + d - 10
            };
            n += 1;
            lo /= base;
            i += 1;
        }
    }
    let mut w = v as u64;
    while w != 0 {
        let d = (w % base) as u8;
        digits[n] = if d < 10 {
            b'0' + d
        } else if f.radix == 2 {
            b'A' + d - 10
        } else {
            b'a' + d - 10
        };
        n += 1;
        w /= base;
    }
    __exr_fmt_digits::<()>(f, &digits, n, neg, base);
}

// 整数の平方根 (2 bit ずつ決める)
fn __exr_ilog10<G>(n: u128) -> u32 {
    if n == 0 {
        panic!("argument of integer logarithm must be positive");
    }
    let mut v = n;
    let mut k = 0;
    while v >= 10 {
        v /= 10;
        k += 1;
    }
    k
}

// (the same for u128, and for i128 after its sign is checked)
fn __exr_isqrt128<G>(n: u128) -> u128 {
    let mut x = n;
    let mut r: u128 = 0;
    let mut b: u128 = 1 << 126;
    while b > x {
        b >>= 2;
    }
    while b != 0 {
        if x >= r + b {
            x -= r + b;
            r = (r >> 1) + b;
        } else {
            r >>= 1;
        }
        b >>= 2;
    }
    r
}

fn __exr_isqrt<G>(n: u64) -> u64 {
    let mut x = n;
    let mut r: u64 = 0;
    let mut b: u64 = 1 << 62;
    while b > x {
        b >>= 2;
    }
    while b != 0 {
        if x >= r + b {
            x -= r + b;
            r = (r >> 1) + b;
        } else {
            r >>= 1;
        }
        b >>= 2;
    }
    r
}

// 128 bit の除算 (rem なら剰余)。上位がなければ 64 bit で割る
fn __exr_udiv128<G>(a: u128, b: u128, rem: bool) -> u128 {
    if b == 0 {
        if rem {
            panic!("attempt to calculate the remainder with a divisor of zero");
        }
        panic!("attempt to divide by zero");
    }
    if (a | b) >> 64 == 0 {
        let x = a as u64;
        let y = b as u64;
        return if rem { (x % y) as u128 } else { (x / y) as u128 };
    }
    if b > a {
        return if rem { a } else { 0 };
    }
    let shift = b.leading_zeros() - a.leading_zeros();
    let mut d = b << shift;
    let mut q: u128 = 0;
    let mut r = a;
    let mut i = shift + 1;
    while i > 0 {
        q <<= 1;
        if r >= d {
            r -= d;
            q |= 1;
        }
        d >>= 1;
        i -= 1;
    }
    if rem { r } else { q }
}

fn __exr_sdiv128<G>(a: i128, b: i128, rem: bool) -> i128 {
    if b == -1 && a == i128::MIN {
        if rem {
            panic!("attempt to calculate the remainder with overflow");
        }
        panic!("attempt to divide with overflow");
    }
    let ua = if a < 0 { !(a as u128) + 1 } else { a as u128 };
    let ub = if b < 0 { !(b as u128) + 1 } else { b as u128 };
    let r = __exr_udiv128::<()>(ua, ub, rem) as i128;
    // 商の符号は両方の符号、剰余の符号は a の符号
    if (rem && a < 0) || (!rem && (a < 0) != (b < 0)) { -r } else { r }
}

// 128 bit 整数 → 浮動小数点 (単精度なら f32 で丸めた値を f64 で返す)。
// 上位 64 bit を取り出し、落とすビットは最下位に 1 bit (sticky) として残すと、丸めが 1 回で済む
fn __exr_u128_to_f<G>(x: u128, signed: bool, single: bool) -> f64 {
    let neg = signed && x >> 127 == 1;
    let m = if neg { !x + 1 } else { x };
    let hi = (m >> 64) as u64;
    let r = if hi == 0 {
        let v = m as u64;
        if single { (v as f32) as f64 } else { v as f64 }
    } else {
        let s = 64 - hi.leading_zeros();
        let mut top = (m >> s) as u64;
        if m & ((1u128 << s) - 1) != 0 {
            top |= 1;
        }
        let t = if single { (top as f32) as f64 } else { top as f64 };
        t * 2.0f64.powi(s as i32)
    };
    if neg { -r } else { r }
}

// 浮動小数点 → 128 bit 整数 (飽和、NaN は 0)。ビット列で返す
fn __exr_f_to_u128<G>(x: f64, signed: bool) -> u128 {
    if x != x {
        return 0;
    }
    let two64 = 18446744073709551616.0;
    let neg = x < 0.0;
    let a = if neg { -x } else { x };
    if signed {
        if a >= 170141183460469231731687303715884105728.0 {
            return if neg { 1u128 << 127 } else { (1u128 << 127) - 1 };
        }
    } else {
        if neg {
            return 0;
        }
        if a >= 340282366920938463463374607431768211456.0 {
            return !0;
        }
    }
    let m = if a < two64 {
        (a as u64) as u128
    } else {
        let hi = (a / two64) as u64;
        let lo = (a - (hi as f64) * two64) as u64;
        ((hi as u128) << 64) | lo as u128
    };
    if neg { !m + 1 } else { m }
}

fn __exr_fmt_digits<G>(f: &mut Formatter, digits: &[u8; 128], n: usize, neg: bool, base: u64) {
    let mut n = n;
    let mut s = String::new();
    if neg {
        s.push('-');
    } else if f.plus {
        s.push('+');
    }
    if f.alt {
        if base == 16 {
            s.push_str("0x");
        } else if base == 2 {
            s.push_str("0b");
        } else if base == 8 {
            s.push_str("0o");
        }
    }
    let prefix = s.len();
    // `{:05}`: 符号と 0x の後ろを 0 で埋める
    if f.zero && f.width > prefix + n {
        let mut z = f.width - prefix - n;
        while z > 0 {
            s.push('0');
            z -= 1;
        }
    }
    while n > 0 {
        n -= 1;
        s.push(digits[n] as char);
    }
    if f.zero {
        f.buf.push_str(s.as_str());
    } else {
        __exr_pad::<()>(f, s.as_str(), 2);
    }
}

