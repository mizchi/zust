// (what codegen calls for `{:b}` / `{:o}` / `{:x}` / `{:X}` / `{:e}` / `{:E}` of a value that is no number: the trait's fmt)
fn __exr_fmt_binary<T: Binary>(x: &T, f: &mut Formatter) {
    let _ = Binary::fmt(x, f);
}
fn __exr_fmt_octal<T: Octal>(x: &T, f: &mut Formatter) {
    let _ = Octal::fmt(x, f);
}
