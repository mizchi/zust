}
impl __Radix for u8 {
    fn from_str_radix(s: &str, radix: u32) -> Result<u8, ParseIntError> {
        match __exr_parse_radix::<()>(s, radix, false, 255, 0) {
            Ok((_, v)) => Ok(v as u8),
            Err(e) => Err(e),
        }
    }
}
impl __Radix for u16 {
    fn from_str_radix(s: &str, radix: u32) -> Result<u16, ParseIntError> {
