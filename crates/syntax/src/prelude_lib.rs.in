        __exr_atomic_rmw(self.__p(), |old: bool| !(old && x))
    }
    pub fn compare_and_swap(&self, cur: bool, new: bool, _o: __AtOrd_) -> bool {
        __exr_atomic_cas(self.__p(), cur, new)
    }
    pub fn fetch_update<F: FnMut(bool) -> Option<bool>>(&self, _s: __AtOrd_, _f: __AtOrd_, f: F) -> Result<bool, bool> {
        __exr_atomic_try_rmw(self.__p(), f)
    }
    pub fn try_update<F: FnMut(bool) -> Option<bool>>(&self, s: __AtOrd_, f: __AtOrd_, g: F) -> Result<bool, bool> {
        self.fetch_update(s, f, g)
    }
    pub fn update<F: FnMut(bool) -> bool>(&self, _s: __AtOrd_, _f: __AtOrd_, f: F) -> bool {
        __exr_atomic_rmw(self.__p(), f)
    }
    pub fn fetch_not(&self, _o: __AtOrd_) -> bool {
        __exr_atomic_rmw(self.__p(), |old: bool| !old)
    }
}

impl Debug for AtomicBool {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_debug(&self.load(__AtOrd_::Relaxed), f);
        Ok(())
    }
}

pub struct AtomicPtr<T> {
    v: *mut T,
}

impl<T> AtomicPtr<T> {
    pub const fn new(v: *mut T) -> AtomicPtr<T> {
        AtomicPtr { v }
    }
    fn __p(&self) -> *mut *mut T {
        &self.v as *const *mut T as *mut *mut T
    }
    // (as an address: the intrinsics take integers and pointers alike, and a usize needs no PartialEq of `*mut T`)
    fn __pu(&self) -> *mut usize {
        &self.v as *const *mut T as *mut usize
    }
    pub fn load(&self, _o: __AtOrd_) -> *mut T {
        __exr_atomic_load(self.__p())
    }
    pub fn store(&self, x: *mut T, _o: __AtOrd_) {
        __exr_atomic_store(self.__p(), x)
    }
    pub fn swap(&self, x: *mut T, _o: __AtOrd_) -> *mut T {
        __exr_atomic_xchg(self.__p(), x)
    }
    pub fn compare_exchange(&self, cur: *mut T, new: *mut T, _s: __AtOrd_, _f: __AtOrd_) -> Result<*mut T, *mut T> {
        let old = __exr_atomic_cas(self.__pu(), cur as usize, new as usize) as *mut T;
        if old == cur { Ok(old) } else { Err(old) }
    }
    pub fn compare_exchange_weak(&self, cur: *mut T, new: *mut T, s: __AtOrd_, f: __AtOrd_) -> Result<*mut T, *mut T> {
        self.compare_exchange(cur, new, s, f)
    }
    pub fn get_mut(&mut self) -> &mut *mut T {
        &mut self.v
    }
    pub fn into_inner(self) -> *mut T {
        self.v
    }
    pub fn compare_and_swap(&self, cur: *mut T, new: *mut T, _o: __AtOrd_) -> *mut T {
        __exr_atomic_cas(self.__pu(), cur as usize, new as usize) as *mut T
    }
    pub fn fetch_update<F: FnMut(*mut T) -> Option<*mut T>>(&self, _s: __AtOrd_, _f: __AtOrd_, mut f: F) -> Result<*mut T, *mut T> {
        match __exr_atomic_try_rmw(self.__pu(), |old: usize| match f(old as *mut T) {
            Some(x) => Some(x as usize),
            None => None,
        }) {
            Ok(x) => Ok(x as *mut T),
            Err(x) => Err(x as *mut T),
        }
    }
    pub fn try_update<F: FnMut(*mut T) -> Option<*mut T>>(&self, s: __AtOrd_, f: __AtOrd_, g: F) -> Result<*mut T, *mut T> {
        self.fetch_update(s, f, g)
    }
    pub fn update<F: FnMut(*mut T) -> *mut T>(&self, _s: __AtOrd_, _f: __AtOrd_, mut f: F) -> *mut T {
        __exr_atomic_rmw(self.__pu(), |old: usize| f(old as *mut T) as usize) as *mut T
    }
    pub fn fetch_ptr_add(&self, n: usize, _o: __AtOrd_) -> *mut T {
        __exr_atomic_xadd(self.__pu(), n.wrapping_mul(core::mem::size_of::<T>())) as *mut T
    }
    pub fn fetch_ptr_sub(&self, n: usize, _o: __AtOrd_) -> *mut T {
        __exr_atomic_xadd(self.__pu(), (0usize).wrapping_sub(n.wrapping_mul(core::mem::size_of::<T>()))) as *mut T
    }
    pub fn fetch_byte_add(&self, n: usize, _o: __AtOrd_) -> *mut T {
        __exr_atomic_xadd(self.__pu(), n) as *mut T
    }
    pub fn fetch_byte_sub(&self, n: usize, _o: __AtOrd_) -> *mut T {
        __exr_atomic_xadd(self.__pu(), (0usize).wrapping_sub(n)) as *mut T
    }
    pub fn fetch_or(&self, n: usize, _o: __AtOrd_) -> *mut T {
        __exr_atomic_rmw(self.__pu(), |old: usize| old | n) as *mut T
    }
    pub fn fetch_and(&self, n: usize, _o: __AtOrd_) -> *mut T {
        __exr_atomic_rmw(self.__pu(), |old: usize| old & n) as *mut T
    }
    pub fn fetch_xor(&self, n: usize, _o: __AtOrd_) -> *mut T {
        __exr_atomic_rmw(self.__pu(), |old: usize| old ^ n) as *mut T
    }
}

// `std::thread`: OS threads, as std's on Linux. `spawn` starts a pthread with a 2 MiB stack, which runs the closure
// and leaves its value in a packet that it and the JoinHandle share; `join` waits for the thread (pthread_join) and
// takes the value. A thread is never switched by the runtime: the kernel runs them in parallel, so everything they
// share goes through atomic instructions and futexes (Arc, the atomics, park, Mutex, Condvar, RwLock, Once, OnceLock,
// the channels), with std's state machines. A panic in a spawned thread prints its message (as thread '<unnamed>'),
// runs the thread's thread_local! drops and ends the thread, whose `join` gives Err. There is no unwinding: the
// thread's other values are not dropped, and a Mutex it holds stays locked (std's is unlocked, poisoned).
// (formal/tla/ArcDrop.tla is the check Arc's count follows)
// (one function per extern block: the prelude is cut down to what a program uses, block by block)
unsafe extern "C" {
    #[link_name = "pthread_create"]
    fn __exr_pthread_create(t: *mut u64, attr: *const u8, f: extern "C" fn(*mut u8) -> *mut u8, arg: *mut u8) -> i32;
}
unsafe extern "C" {
    #[link_name = "pthread_join"]
    fn __exr_pthread_join(t: u64, ret: *mut *mut u8) -> i32;
}
unsafe extern "C" {
    #[link_name = "pthread_detach"]
    fn __exr_pthread_detach(t: u64) -> i32;
}
unsafe extern "C" {
    #[link_name = "pthread_exit"]
    fn __exr_pthread_exit(r: *mut u8);
}
unsafe extern "C" {
    #[link_name = "pthread_attr_init"]
    fn __exr_pthread_attr_init(a: *mut u8) -> i32;
}
unsafe extern "C" {
    #[link_name = "pthread_attr_setstacksize"]
    fn __exr_pthread_attr_setstacksize(a: *mut u8, n: usize) -> i32;
}
unsafe extern "C" {
    #[link_name = "pthread_key_create"]
    fn __exr_pthread_key_create(k: *mut u32, dtor: *const u8) -> i32;
}
unsafe extern "C" {
    #[link_name = "pthread_getspecific"]
    fn __exr_pthread_getspecific(k: u32) -> *mut u8;
}
unsafe extern "C" {
    #[link_name = "pthread_setspecific"]
    fn __exr_pthread_setspecific(k: u32, v: *mut u8) -> i32;
}
unsafe extern "C" {
    #[link_name = "sched_yield"]
    fn __exr_sched_yield() -> i32;
}
unsafe extern "C" {
    #[link_name = "syscall"]
    fn __exr_syscall(n: i64, a: *mut u32, op: i32, v: u32, t: usize, b: usize, c: u32) -> i64;
}

// futex(2) on a u32 (the private ops: no other process shares it): wait while *p is v (a wakeup may be spurious, so
// the caller checks again), and wake up to n waiters
fn __exr_futex_wait(p: *mut u32, v: u32) {
    unsafe {
        __exr_syscall(202, p, 128, v, 0, 0, 0);
    }
}
fn __exr_futex_wake(p: *mut u32, n: u32) {
    unsafe {
        __exr_syscall(202, p, 129, n, 0, 0, 0);
    }
}
// (as __exr_futex_wait, for at most ts (seconds, nanoseconds))
fn __exr_futex_wait_for(p: *mut u32, v: u32, ts: &[i64; 2]) {
    unsafe {
        __exr_syscall(202, p, 128, v, ts as *const [i64; 2] as usize, 0, 0);
    }
}
fn __exr_futex_wake_all(p: *mut u32) {
    __exr_futex_wake(p, 2147483647);
}

// A thread's shared part: each Thread points to it, and so does the thread itself while it runs (the last of them
// frees it; the main thread's is a static)
struct __ThreadInner {
    refs: usize,
    id: u64,
    // (a Builder's name)
    name: Option<String>,
    // (the parker, std's futex one: 0 empty, 1 notified, u32::MAX parked)
    park: u32,
}

// The head of the packet a spawned thread leaves its value in (`__Packet<T>` starts with it)
struct __PacketHead {
    // (the JoinHandle and the thread: the last of the two to let go frees it)
    refs: usize,
    // (0 running, 1 done, 2 panicked)
    state: u32,
}

struct __Packet<T> {
    h: __PacketHead,
    val: Option<T>,
}

// What a thread keeps for itself (pthread_getspecific of __EXR_TLS_KEY in a spawned thread; the main thread's is
// __EXR_MAIN_CTX)
struct __ThreadCtx {
    th: *mut __ThreadInner,
    // (the packet while the thread still holds it: a panic marks it and lets it go)
    packet: *mut __PacketHead,
    run: Option<Box<dyn FnMut()>>,
    // (the thread_local! values made on this thread, by key (1 once destroyed), their drops, and the keys in the order
    // the values were made: they are dropped newest first)
    tls: Vec<*mut u8>,
    tls_drop: Vec<Option<fn(*mut u8)>>,
    tls_order: Vec<usize>,
    // (the thread_local! values are being dropped: a panic now aborts, as std's)
    ending: bool,
    // (the states of the Onces whose closures this thread runs: a panic poisons them, so the threads that wait wake)
    onces: Vec<*mut u32>,
}

static mut __EXR_MAIN_THREAD: __ThreadInner = __ThreadInner { refs: 1, id: 1, name: None, park: 0 };
static mut __EXR_MAIN_CTX: *mut __ThreadCtx = 0usize as *mut __ThreadCtx;
// (the key of the spawned threads' contexts, made by the first spawn: before it there is only the main thread)
static mut __EXR_TLS_KEY: u32 = 0;
static mut __EXR_TLS_READY: u32 = 0;
// (std numbers its ThreadIds from 1 in the order the threads are made: the main thread is 1)
static mut __EXR_NEXT_TID: u64 = 2;

fn __exr_alloc_ok(n: usize) -> *mut u8 {
    let p = unsafe { __exr_malloc(n) };
    if p.is_null() {
        __exr_err_str::<()>("memory allocation failed\n");
        unsafe { __exr_abort() };
    }
    p
}

fn __exr_new_ctx(th: *mut __ThreadInner) -> *mut __ThreadCtx {
    let c = __exr_alloc_ok(core::mem::size_of::<__ThreadCtx>()) as *mut __ThreadCtx;
    unsafe {
        c.write(__ThreadCtx {
            th: th,
            packet: 0usize as *mut __PacketHead,
            run: None,
            tls: Vec::new(),
            tls_drop: Vec::new(),
            tls_order: Vec::new(),
            ending: false,
            onces: Vec::new(),
        });
    }
    c
}

// (this thread's context; the main thread's is made at its first use)
fn __exr_thread_ctx() -> *mut __ThreadCtx {
    unsafe {
        if __exr_atomic_load(&mut __EXR_TLS_READY as *mut u32) != 0 {
            let c = __exr_pthread_getspecific(__EXR_TLS_KEY) as *mut __ThreadCtx;
            if !c.is_null() {
                return c;
            }
        }
        // (only the main thread gets here: a spawned thread sets its context before it runs anything)
        if __EXR_MAIN_CTX.is_null() {
            __EXR_MAIN_CTX = __exr_new_ctx(&mut __EXR_MAIN_THREAD as *mut __ThreadInner);
        }
        __EXR_MAIN_CTX
    }
}

// (runs the thread_local! drops of a thread that ends, newest first, and frees its context. As std's: a value whose
// drop has begun cannot be reached again (its `with` panics, its `try_with` gives Err), one first made by a drop is
// dropped too, and a drop that panics aborts the program)
fn __exr_thread_end(c: *mut __ThreadCtx) {
    unsafe {
        (*c).ending = true;
        loop {
            let k = match (*c).tls_order.pop() {
                Some(k) => k,
                None => break,
            };
            let p = (*c).tls[k];
            (*c).tls[k] = 1usize as *mut u8;
            if let Some(d) = (*c).tls_drop[k] {
                d(p);
            }
            __exr_free(p);
        }
        __exr_thread_release((*c).th);
        __exr_drop_in_place(c);
        __exr_free(c as *mut u8);
        __exr_pthread_setspecific(__EXR_TLS_KEY, 0usize as *mut u8);
    }
}

// A thread_local!'s key (lexer::expand_thread_local): its number among the program's thread_local! values, given at
// its first use on any thread (0: none yet). Each thread keeps its own value of each, made at its first use there
pub struct __TlsKey {
    __tk: usize,
}

impl __TlsKey {
    pub const fn new() -> __TlsKey {
        __TlsKey { __tk: 0 }
    }
}

static mut __EXR_TLS_NEXT: usize = 1;

fn __exr_tls_drop<T>(p: *mut u8) {
    __exr_drop_in_place(p as *mut Option<T>);
}

// `std::thread::AccessError`: the Err of a thread_local!'s `try_with` once the thread's value is being dropped
pub struct AccessError {
    __ae: u8,
}

impl Debug for AccessError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str("AccessError");
        Ok(())
    }
}

impl Display for AccessError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.pad("already destroyed")
    }
}

// (the name thread_local!'s expansion uses: a program's own `AccessError` renames the prelude's, not this)
pub type __TlsAccessError = AccessError;

pub fn __exr_access_error() -> AccessError {
    AccessError { __ae: 0 }
}

// (`with` on a thread_local! whose value is being dropped or was)
pub fn __exr_tls_destroyed() -> ! {
    panic!("cannot access a Thread Local Storage value during or after destruction: AccessError");
}

// (this thread's value of the key: None until the thread_local!'s `with` sets it; null once its drop has begun. A
// spawned thread drops its values when it ends; the main thread's live to the end of the program)
pub fn __exr_tls_slot<T>(k: &__TlsKey) -> *mut Option<T> {
    let kp = &k.__tk as *const usize as *mut usize;
    let mut i = __exr_atomic_load(kp);
    if i == 0 {
        let n = __exr_atomic_xadd(unsafe { &mut __EXR_TLS_NEXT as *mut usize }, 1);
        let seen = __exr_atomic_cas(kp, 0, n);
        i = if seen == 0 { n } else { seen };
    }
    let c = __exr_thread_ctx();
    unsafe {
        while (*c).tls.len() < i {
            (*c).tls.push(0usize as *mut u8);
            (*c).tls_drop.push(None);
        }
        let mut p = (*c).tls[i - 1];
        // (destroyed: none)
        if p as usize == 1 {
            return 0usize as *mut Option<T>;
        }
        if p.is_null() {
            p = __exr_alloc_ok(core::mem::size_of::<Option<T>>());
            (p as *mut Option<T>).write(None);
            (*c).tls[i - 1] = p;
        }
        p as *mut Option<T>
    }
}

// (the value of the key has been made on this thread: its drop is registered now, after its initializer, as std's
// lazy thread-locals do, so a value another one's initializer made first is dropped after it)
pub fn __exr_tls_made<T>(k: &__TlsKey) {
    let i = __exr_atomic_load(&k.__tk as *const usize as *mut usize);
    let c = __exr_thread_ctx();
    unsafe {
        if (*c).tls_drop[i - 1].is_none() {
            (*c).tls_drop[i - 1] = Some(__exr_tls_drop::<T>);
            (*c).tls_order.push(i - 1);
        }
    }
}

// (whether a panic has been reported)
static mut __EXR_PANICKED: u32 = 0;

// __EXR_THREAD_HOOK (set by the first spawn). 0: "thread '<unnamed>' panicked" in a spawned thread ('main' in the
// main one); 2 / 3: the lock of stdout; 4: std's note on RUST_BACKTRACE, with the first panic only, then a spawned
// thread's panic marks its packet, runs its thread_local! drops and ends the thread (pthread_exit, which does not
// return); the main thread's goes on to exit(101)
fn __exr_thread_hook(q: u32) -> bool {
    unsafe {
        let c = __exr_pthread_getspecific(__EXR_TLS_KEY) as *mut __ThreadCtx;
        if q == 2 {
            __exr_out_take();
            return true;
        }
        if q == 3 {
            __exr_out_give();
            return true;
        }
        if q == 0 {
            if c.is_null() {
                __exr_err_str::<()>("\nthread 'main' panicked");
            } else {
                __exr_err_str::<()>("\nthread '");
                match &(*(*c).th).name {
                    Some(n) => __exr_err_str::<()>(n.as_str()),
                    None => __exr_err_str::<()>("<unnamed>"),
                }
                __exr_err_str::<()>("' panicked");
            }
            return true;
        }
        if __exr_atomic_xchg(&mut __EXR_PANICKED as *mut u32, 1) == 0 {
            __exr_err_str::<()>("\nnote: run with `RUST_BACKTRACE=1` environment variable to display a backtrace\n");
        } else {
            __exr_err_str::<()>("\n");
        }
        if c.is_null() {
            return false;
        }
        if (*c).ending {
            __exr_err_str::<()>("fatal runtime error: thread local panicked on drop, aborting\n");
            __exr_abort();
        }
        // (a StdoutLock it holds is let go, as std's guard would be on unwinding)
        if __exr_atomic_load(&mut __EXR_OUT_OWNER as *mut usize) == c as usize {
            __EXR_OUT_DEPTH = 0;
            __exr_atomic_store(&mut __EXR_OUT_OWNER as *mut usize, 0);
            __exr_unlock(&mut __EXR_OUT_LOCK as *mut u32);
        }
        // (the Onces this thread was running: poisoned, and their waiters woken)
        while let Some(o) = (*c).onces.pop() {
            __exr_atomic_store(o, 4);
            __exr_futex_wake_all(o);
        }
        let pk = (*c).packet;
        if !pk.is_null() {
            (*c).packet = 0usize as *mut __PacketHead;
            __exr_atomic_store(&mut (*pk).state as *mut u32, 2);
            // (a panic comes before the value is written: the packet holds None, which needs no drop)
            if __exr_atomic_xadd(&mut (*pk).refs as *mut usize, 18446744073709551615) == 1 {
                __exr_free(pk as *mut u8);
            }
        }
        __exr_thread_end(c);
        __exr_pthread_exit(0usize as *mut u8);
    }
    true
}

// (__EXR_ONCE_HOOK: a spawned thread's Once begun (true) or done (false), for its panic to poison)
fn __exr_once_track(o: *mut u32, begin: bool) {
    unsafe {
        let c = __exr_pthread_getspecific(__EXR_TLS_KEY) as *mut __ThreadCtx;
        if c.is_null() {
            return;
        }
        if begin {
            (*c).onces.push(o);
        } else {
            let mut k = (*c).onces.len();
            while k > 0 {
                k -= 1;
                if (*c).onces[k] == o {
                    (*c).onces.remove(k);
                    break;
                }
            }
        }
    }
}

// (the first spawn, on the only thread there is: no other one can race it)
// (0, or what pthread_key_create failed with (EAGAIN: no key is left): the spawn fails with it)
fn __exr_threads_init() -> i32 {
    unsafe {
        if __EXR_TLS_READY == 0 {
            let e = __exr_pthread_key_create(&mut __EXR_TLS_KEY as *mut u32, 0usize as *const u8);
            if e != 0 {
                return e;
            }
            __EXR_THREAD_HOOK = Some(__exr_thread_hook);
            __EXR_ONCE_HOOK = Some(__exr_once_track);
            __exr_atomic_store(&mut __EXR_TLS_READY as *mut u32, 1);
        }
    }
    0
}

extern "C" fn __exr_thread_start(arg: *mut u8) -> *mut u8 {
    unsafe {
        let c = arg as *mut __ThreadCtx;
        // (without its context the thread could not tell itself from the main thread: std aborts on such a failure)
        if __exr_pthread_setspecific(__EXR_TLS_KEY, arg) != 0 {
            __exr_err_str::<()>("fatal runtime error: failed to set a thread's context, aborting\n");
            __exr_abort();
        }
        {
            let mut f = (*c).run.take().unwrap();
            f();
        }
        __exr_thread_end(c);
    }
    0usize as *mut u8
}

fn __exr_thread_retain(th: *mut __ThreadInner) -> Thread {
    unsafe {
        __exr_atomic_xadd(&mut (*th).refs as *mut usize, 1);
    }
    Thread { __th: th }
}

fn __exr_thread_release(th: *mut __ThreadInner) {
    unsafe {
        if __exr_atomic_xadd(&mut (*th).refs as *mut usize, 18446744073709551615) == 1 && (*th).id != 1 {
            __exr_drop_in_place(th);
            __exr_free(th as *mut u8);
        }
    }
}

// (the packet's drop, by the last of the thread and the JoinHandle)
fn __exr_packet_release<T>(pk: *mut __Packet<T>) {
    unsafe {
        if __exr_atomic_xadd(&mut (*pk).h.refs as *mut usize, 18446744073709551615) == 1 {
            __exr_drop_in_place(&mut (*pk).val as *mut Option<T>);
            __exr_free(pk as *mut u8);
        }
    }
}

pub struct JoinHandle<T> {
    pk: *mut __Packet<T>,
    // (the pthread_t)
    pt: u64,
    th: Thread,
}

// The Err of a join whose thread panicked (std's is the panic's payload, a `Box<dyn Any + Send>`, which prints so)
pub struct __ThreadPanic {
    __tp_n: u8,
}

impl Debug for __ThreadPanic {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str("Any { .. }");
        Ok(())
    }
}

impl<T> JoinHandle<T> {
    pub fn join(self) -> Result<T, __ThreadPanic> {
        let pk = self.pk;
        let th = self.th.__th;
        unsafe {
            __exr_pthread_join(self.pt, 0usize as *mut *mut u8);
        }
        __core_forget(self);
        __exr_thread_release(th);
        let vp = unsafe { &mut (*pk).val as *mut Option<T> };
        let v = unsafe { vp.read() };
        unsafe { vp.write(None) };
        __exr_packet_release(pk);
        match v {
            Some(x) => Ok(x),
            None => Err(__ThreadPanic { __tp_n: 0 }),
        }
    }
    pub fn is_finished(&self) -> bool {
        unsafe { __exr_atomic_load(&mut (*self.pk).h.state as *mut u32) != 0 }
    }
    pub fn thread(&self) -> &Thread {
        &self.th
    }
}

// `std::os::unix::thread::RawPthread` / `JoinHandleExt`: a JoinHandle's pthread_t (an unsigned long on Linux)
pub type RawPthread = u64;

pub trait JoinHandleExt {
    fn as_pthread_t(&self) -> RawPthread;
    fn into_pthread_t(self) -> RawPthread;
}

impl<T> JoinHandleExt for JoinHandle<T> {
    fn as_pthread_t(&self) -> RawPthread {
        self.pt
    }
    // (as std's: the handle is given up, neither joined nor detached, so the caller may join the pthread_t)
    fn into_pthread_t(self) -> RawPthread {
        let (pt, pk, th) = (self.pt, self.pk, self.th.__th);
        __core_forget(self);
        __exr_thread_release(th);
        __exr_packet_release(pk);
        pt
    }
}

// (a handle dropped without join: the thread is detached, and runs on alone)
impl<T> Drop for JoinHandle<T> {
    fn drop(&mut self) {
        // (null: moved out of a closure's captures)
        if self.pk.is_null() {
            return;
        }
        unsafe {
            __exr_pthread_detach(self.pt);
        }
        __exr_packet_release(self.pk);
    }
}

pub fn __core_spawn<T, F: FnOnce() -> T>(f: F) -> JoinHandle<T> {
    match __exr_spawn(f, None, 2097152) {
        Ok(h) => h,
        Err(r) => panic!("failed to spawn thread: Os {{ code: {}, kind: WouldBlock, message: \"Resource temporarily unavailable\" }}", r),
    }
}

// (a thread with a name and a stack of `stack` bytes (in whole pages, as std rounds it, and at least 64 KiB: above
// glibc's minimum, as a margin); Err: what pthread_create gave)
fn __exr_spawn<T, F: FnOnce() -> T>(f: F, name: Option<String>, stack: usize) -> Result<JoinHandle<T>, i32> {
    let e = __exr_threads_init();
    if e != 0 {
        return Err(e);
    }
    let pk = __exr_alloc_ok(core::mem::size_of::<__Packet<T>>()) as *mut __Packet<T>;
    unsafe {
        pk.write(__Packet { h: __PacketHead { refs: 2, state: 0 }, val: None });
    }
    let th = __exr_alloc_ok(core::mem::size_of::<__ThreadInner>()) as *mut __ThreadInner;
    unsafe {
        th.write(__ThreadInner { refs: 2, id: __exr_atomic_xadd(&mut __EXR_NEXT_TID as *mut u64, 1), name: name, park: 0 });
    }
    let mut f = Some(f);
    let run: Box<dyn FnMut()> = Box::new(move || {
        if let Some(g) = f.take() {
            let v = g();
            unsafe {
                (&mut (*pk).val as *mut Option<T>).write(Some(v));
                __exr_atomic_store(&mut (*pk).h.state as *mut u32, 1);
                (*__exr_thread_ctx()).packet = 0usize as *mut __PacketHead;
            }
            __exr_packet_release(pk);
        }
    });
    let c = __exr_new_ctx(th);
    unsafe {
        (*c).packet = pk as *mut __PacketHead;
        (*c).run = Some(run);
    }
    let mut pt: u64 = 0;
    // (a pthread_attr_t: 56 bytes in glibc on x86-64. 2 MiB of stack by default, as std's)
    let mut attr = [0u64; 8];
    // (a size whose rounding would overflow is the largest whole number of pages: pthread_create fails on it then)
    let size = if stack < 65536 {
        65536
    } else if stack > 18446744073709551615 - 4095 {
        18446744073709551615 / 4096 * 4096
    } else {
        (stack + 4095) / 4096 * 4096
    };
    // (a size the attribute refuses fails the spawn, as pthread_create's error would)
    let r = unsafe {
        __exr_pthread_attr_init(attr.as_mut_ptr() as *mut u8);
        let e = __exr_pthread_attr_setstacksize(attr.as_mut_ptr() as *mut u8, size);
        if e != 0 { e } else { __exr_pthread_create(&mut pt, attr.as_ptr() as *const u8, __exr_thread_start, c as *mut u8) }
    };
    if r != 0 {
        // (no thread holds them: the closure (and its captures), the context, the packet and the Thread go now)
        unsafe {
            __exr_drop_in_place(c);
            __exr_free(c as *mut u8);
            __exr_free(pk as *mut u8);
            __exr_drop_in_place(th);
            __exr_free(th as *mut u8);
        }
        return Err(r);
    }
    Ok(JoinHandle { pk: pk, pt: pt, th: Thread { __th: th } })
}

// `std::thread::Builder`: a thread's name and stack size before it is spawned
pub struct Builder {
    __b_name: Option<String>,
    __b_stack: usize,
}

impl Builder {
    pub fn new() -> Builder {
        Builder { __b_name: None, __b_stack: 2097152 }
    }
    pub fn name(self, name: String) -> Builder {
        Builder { __b_name: Some(name), __b_stack: self.__b_stack }
    }
    pub fn stack_size(self, size: usize) -> Builder {
        Builder { __b_name: self.__b_name, __b_stack: size }
    }
    pub fn spawn<T, F: FnOnce() -> T>(self, f: F) -> Result<JoinHandle<T>, IoError> {
        match __exr_spawn(f, self.__b_name, self.__b_stack) {
            Ok(h) => Ok(h),
            Err(r) => Err(IoError::from_raw_os_error(r)),
        }
    }
}

pub fn __core_yield_now() {
    unsafe {
        __exr_sched_yield();
    }
}
// (`thread::panicking()`: a panic does not unwind, so no drop ever runs while panicking)
pub fn __core_panicking() -> bool { false }

// `std::thread::Thread`: a handle to a thread, a pointer to its shared part. `park` waits on the thread's futex for
// a token that `unpark` leaves (std's parker). (`\x54` in the Debug name, as `\x4c` in Layout's: a program's own
// `Thread` renames this one, word by word)
pub struct Thread {
    __th: *mut __ThreadInner,
}

// (an inherent clone, as Rc's: one more reference to the shared part)
impl Thread {
    pub fn clone(&self) -> Thread {
        __exr_thread_retain(self.__th)
    }
}

impl Drop for Thread {
    fn drop(&mut self) {
        // (null: moved out of a closure's captures)
        if self.__th.is_null() {
            return;
        }
        __exr_thread_release(self.__th);
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct ThreadId(u64);

impl Thread {
    pub fn id(&self) -> ThreadId {
        ThreadId(unsafe { (*self.__th).id })
    }
    // (the main thread's, or a Builder's)
    pub fn name(&self) -> Option<&str> {
        if unsafe { (*self.__th).id } == 1 {
            return Some("main");
        }
        match unsafe { &(*self.__th).name } {
            Some(n) => Some(n.as_str()),
            None => None,
        }
    }
    pub fn unpark(&self) {
        let p = unsafe { &mut (*self.__th).park as *mut u32 };
        if __exr_atomic_xchg(p, 1) == 4294967295 {
            __exr_futex_wake(p, 1);
        }
    }
}

impl Debug for Thread {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.debug_struct("\x54hread").field("id", &self.id()).field("name", &self.name()).finish_non_exhaustive()
    }
}

pub fn __core_current() -> Thread {
    __exr_thread_retain(unsafe { (*__exr_thread_ctx()).th })
}

// (std's: the token, if unpark left one, else wait for it. A park nothing unparks waits forever, as std's)
pub fn __core_park() {
    let p = unsafe { &mut (*(*__exr_thread_ctx()).th).park as *mut u32 };
    // (notified -> empty: the token taken; empty -> parked)
    if __exr_atomic_xadd(p, 4294967295) == 1 {
        return;
    }
    loop {
        __exr_futex_wait(p, 4294967295);
        if __exr_atomic_cas(p, 1, 0) == 1 {
            return;
        }
    }
}

// (as park, waiting at most d: one wait, as std's, so it may return early; a token is taken either way)
pub fn __core_park_timeout(d: Duration) {
    let p = unsafe { &mut (*(*__exr_thread_ctx()).th).park as *mut u32 };
    if __exr_atomic_xadd(p, 4294967295) == 1 {
        return;
    }
    // (seconds past i64's range are its largest, as in recv_timeout)
    let ts = [if d.secs > 9223372036854775807 { 9223372036854775807 } else { d.secs as i64 }, d.nanos as i64];
    __exr_futex_wait_for(p, 4294967295, &ts);
    __exr_atomic_xchg(p, 0);
}

/// `std::fmt::Arguments`: a formatted text (`format_args!` makes a String here, so this holds one)
#[derive(Clone)]
pub struct Arguments<'a> {
    __args_s: String,
    __args_p: PhantomData<&'a ()>,
}

impl<'a> Arguments<'a> {
    pub fn as_str(&self) -> Option<&'static str> {
        None
    }
}

impl<'a> Display for Arguments<'a> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str(&self.__args_s);
        Ok(())
    }
}

impl<'a> Debug for Arguments<'a> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str(&self.__args_s);
        Ok(())
    }
}

/// `std::ops::ControlFlow`: go on with a C, or stop early with a B
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub enum ControlFlow<B, C = ()> {
    Continue(C),
    Break(B),
}

impl<B, C> ControlFlow<B, C> {
    pub fn is_break(&self) -> bool {
        match self {
            ControlFlow::Break(_) => true,
            ControlFlow::Continue(_) => false,
        }
    }
    pub fn is_continue(&self) -> bool {
        !self.is_break()
    }
    pub fn break_value(self) -> Option<B> {
        match self {
            ControlFlow::Break(b) => Some(b),
            ControlFlow::Continue(_) => None,
        }
    }
    pub fn continue_value(self) -> Option<C> {
        match self {
            ControlFlow::Continue(c) => Some(c),
            ControlFlow::Break(_) => None,
        }
    }
    pub fn map_break<T, F: FnOnce(B) -> T>(self, f: F) -> ControlFlow<T, C> {
        match self {
            ControlFlow::Break(b) => ControlFlow::Break(f(b)),
            ControlFlow::Continue(c) => ControlFlow::Continue(c),
        }
    }
    pub fn map_continue<T, F: FnOnce(C) -> T>(self, f: F) -> ControlFlow<B, T> {
        match self {
            ControlFlow::Continue(c) => ControlFlow::Continue(f(c)),
            ControlFlow::Break(b) => ControlFlow::Break(b),
        }
    }
}

/// `std::ops::Bound`: one end of a range
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub enum Bound<T> {
    Included(T),
    Excluded(T),
    Unbounded,
}

impl<T> Bound<T> {
    pub fn as_ref(&self) -> Bound<&T> {
        match self {
            Bound::Included(x) => Bound::Included(x),
            Bound::Excluded(x) => Bound::Excluded(x),
            Bound::Unbounded => Bound::Unbounded,
        }
    }
    pub fn map<U, F: FnOnce(T) -> U>(self, f: F) -> Bound<U> {
        match self {
            Bound::Included(x) => Bound::Included(f(x)),
            Bound::Excluded(x) => Bound::Excluded(f(x)),
            Bound::Unbounded => Bound::Unbounded,
        }
    }
}

// `std::time::SystemTime`: the time since UNIX_EPOCH (arithmetic and comparison; no clock is read here, so no `now`)
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct SystemTime {
    __st_d: Duration,
}

pub const UNIX_EPOCH: SystemTime = SystemTime { __st_d: Duration { secs: 0, nanos: 0 } };

/// `duration_since` of an earlier time: how much later it is
#[derive(Clone, Debug)]
pub struct SystemTimeError(Duration);

impl SystemTimeError {
    pub fn duration(&self) -> Duration {
        self.0
    }
}

impl Display for SystemTimeError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.pad("second time provided was later than self")
    }
}

impl SystemTime {
    pub const UNIX_EPOCH: SystemTime = SystemTime { __st_d: Duration { secs: 0, nanos: 0 } };
    pub fn duration_since(&self, earlier: SystemTime) -> Result<Duration, SystemTimeError> {
        match self.__st_d.checked_sub(earlier.__st_d) {
            Some(d) => Ok(d),
            None => Err(SystemTimeError(earlier.__st_d.checked_sub(self.__st_d).unwrap_or(Duration::ZERO))),
        }
    }
    pub fn checked_add(&self, d: Duration) -> Option<SystemTime> {
        match self.__st_d.checked_add(d) {
            Some(t) => Some(SystemTime { __st_d: t }),
            None => None,
        }
    }
    pub fn checked_sub(&self, d: Duration) -> Option<SystemTime> {
        match self.__st_d.checked_sub(d) {
            Some(t) => Some(SystemTime { __st_d: t }),
            None => None,
        }
    }
}

impl Debug for SystemTime {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        let s = format!("SystemTime {{ tv_sec: {}, tv_nsec: {} }}", self.__st_d.as_secs(), self.__st_d.subsec_nanos());
        f.pad(&s)
    }
}

// (`UNIX_EPOCH + Duration::from_secs(n)`: a time moved by a duration, with std's panics)
impl Add<Duration> for SystemTime {
    type Output = SystemTime;
    fn add(self, d: Duration) -> SystemTime {
        self.checked_add(d).expect("overflow when adding duration to instant")
    }
}
impl Sub<Duration> for SystemTime {
    type Output = SystemTime;
    fn sub(self, d: Duration) -> SystemTime {
        self.checked_sub(d).expect("overflow when subtracting duration from instant")
    }
}
impl AddAssign<Duration> for SystemTime {
    fn add_assign(&mut self, d: Duration) {
        *self = *self + d;
    }
}
impl SubAssign<Duration> for SystemTime {
    fn sub_assign(&mut self, d: Duration) {
        *self = *self - d;
    }
}

// `std::time::Duration` (seconds and nanoseconds, as std)
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]
pub struct Duration {
    secs: u64,
    nanos: u32,
}

impl Duration {
    pub const ZERO: Duration = Duration { secs: 0, nanos: 0 };
    pub const MAX: Duration = Duration { secs: 18446744073709551615, nanos: 999999999 };
    pub const SECOND: Duration = Duration { secs: 1, nanos: 0 };
    pub const MILLISECOND: Duration = Duration { secs: 0, nanos: 1000000 };
    pub const MICROSECOND: Duration = Duration { secs: 0, nanos: 1000 };
    pub const NANOSECOND: Duration = Duration { secs: 0, nanos: 1 };
    pub const fn new(secs: u64, nanos: u32) -> Duration {
        let extra = (nanos / 1000000000) as u64;
        Duration { secs: secs + extra, nanos: nanos % 1000000000 }
    }
    pub const fn from_secs(secs: u64) -> Duration {
        Duration { secs: secs, nanos: 0 }
    }
    pub const fn from_millis(ms: u64) -> Duration {
        Duration { secs: ms / 1000, nanos: ((ms % 1000) * 1000000) as u32 }
    }
    pub const fn from_micros(us: u64) -> Duration {
        Duration { secs: us / 1000000, nanos: ((us % 1000000) * 1000) as u32 }
    }
    pub const fn from_nanos(ns: u64) -> Duration {
        Duration { secs: ns / 1000000000, nanos: (ns % 1000000000) as u32 }
    }
    pub fn from_secs_f64(s: f64) -> Duration {
        let secs = s as u64;
        Duration { secs: secs, nanos: ((s - secs as f64) * 1000000000.0) as u32 }
    }
    pub fn from_secs_f32(s: f32) -> Duration {
        Duration::from_secs_f64(s as f64)
    }
    pub const fn is_zero(&self) -> bool {
        self.secs == 0 && self.nanos == 0
    }
    pub const fn as_secs(&self) -> u64 {
        self.secs
    }
    pub const fn subsec_millis(&self) -> u32 {
        self.nanos / 1000000
    }
    pub const fn subsec_micros(&self) -> u32 {
        self.nanos / 1000
    }
    pub const fn subsec_nanos(&self) -> u32 {
        self.nanos
    }
    pub const fn as_millis(&self) -> u128 {
        self.secs as u128 * 1000 + (self.nanos / 1000000) as u128
    }
    pub const fn as_micros(&self) -> u128 {
        self.secs as u128 * 1000000 + (self.nanos / 1000) as u128
    }
    pub const fn as_nanos(&self) -> u128 {
        self.secs as u128 * 1000000000 + self.nanos as u128
    }
    pub fn as_secs_f64(&self) -> f64 {
        self.secs as f64 + self.nanos as f64 / 1000000000.0
    }
    pub fn as_secs_f32(&self) -> f32 {
        self.as_secs_f64() as f32
    }
    pub fn checked_add(self, rhs: Duration) -> Option<Duration> {
        let mut nanos = self.nanos + rhs.nanos;
        let mut carry = 0u64;
        if nanos >= 1000000000 {
            nanos -= 1000000000;
            carry = 1;
        }
        match self.secs.checked_add(rhs.secs) {
            Some(s) => match s.checked_add(carry) {
                Some(s) => Some(Duration { secs: s, nanos: nanos }),
                None => None,
            },
            None => None,
        }
    }
    pub fn checked_sub(self, rhs: Duration) -> Option<Duration> {
        if self < rhs {
            return None;
        }
        if self.nanos >= rhs.nanos {
            Some(Duration { secs: self.secs - rhs.secs, nanos: self.nanos - rhs.nanos })
        } else {
            Some(Duration { secs: self.secs - rhs.secs - 1, nanos: self.nanos + 1000000000 - rhs.nanos })
        }
    }
    pub fn saturating_add(self, rhs: Duration) -> Duration {
        match self.checked_add(rhs) {
            Some(d) => d,
            None => Duration::MAX,
        }
    }
    pub fn saturating_sub(self, rhs: Duration) -> Duration {
        match self.checked_sub(rhs) {
            Some(d) => d,
            None => Duration::ZERO,
        }
    }
    pub fn checked_mul(self, rhs: u32) -> Option<Duration> {
        let n = self.nanos as u64 * rhs as u64;
        match self.secs.checked_mul(rhs as u64) {
            Some(s) => match s.checked_add(n / 1000000000) {
                Some(s) => Some(Duration { secs: s, nanos: (n % 1000000000) as u32 }),
                None => None,
            },
            None => None,
        }
    }
    pub fn checked_div(self, rhs: u32) -> Option<Duration> {
        if rhs == 0 {
            return None;
        }
        let secs = self.secs / rhs as u64;
        let carry = self.secs - secs * rhs as u64;
        let extra = carry * 1000000000 / rhs as u64;
        let nanos = self.nanos / rhs + extra as u32;
        Some(Duration::new(secs, nanos))
    }
    pub fn abs_diff(self, other: Duration) -> Duration {
        if self < other { other.checked_sub(self).unwrap() } else { self.checked_sub(other).unwrap() }
    }
}

// (as std: `1.5s` / `2ms` / `10.000001µs` / `7ns`; the precision of `{:.2?}` is not honored)
impl Debug for Duration {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        let (int, mut frac, mut div, unit) = if self.secs > 0 {
            (self.secs, self.nanos, 100000000u32, "s")
        } else if self.nanos >= 1000000 {
            ((self.nanos / 1000000) as u64, self.nanos % 1000000, 100000u32, "ms")
        } else if self.nanos >= 1000 {
            ((self.nanos / 1000) as u64, self.nanos % 1000, 100u32, "µs")
        } else {
            (self.nanos as u64, 0, 0u32, "ns")
        };
        __exr_debug(&int, f);
        if frac > 0 {
            __exr_fmt_str::<()>(f, ".");
            while frac > 0 && div > 0 {
                let d = frac / div;
                __exr_debug(&d, f);
                frac = frac % div;
                div = div / 10;
            }
        }
        __exr_fmt_str::<()>(f, unit);
        Ok(())
    }
}

impl Add for Duration {
    type Output = Duration;
    fn add(self, rhs: Duration) -> Duration {
        self.checked_add(rhs).expect("overflow when adding durations")
    }
}
impl Sub for Duration {
    type Output = Duration;
    fn sub(self, rhs: Duration) -> Duration {
        self.checked_sub(rhs).expect("overflow when subtracting durations")
    }
}
impl AddAssign for Duration {
    fn add_assign(&mut self, rhs: Duration) {
        *self = *self + rhs;
    }
}
impl SubAssign for Duration {
    fn sub_assign(&mut self, rhs: Duration) {
        *self = *self - rhs;
    }
}
impl Mul<u32> for Duration {
    type Output = Duration;
    fn mul(self, rhs: u32) -> Duration {
        self.checked_mul(rhs).expect("overflow when multiplying duration by scalar")
    }
}
impl Div<u32> for Duration {
    type Output = Duration;
    fn div(self, rhs: u32) -> Duration {
        self.checked_div(rhs).expect("divide by zero error when dividing duration by scalar")
    }
}

unsafe extern "C" {
    #[link_name = "nanosleep"]
    fn __exr_nanosleep(req: *const [i64; 2], rem: *mut [i64; 2]) -> i32;
}

pub fn __core_sleep(d: Duration) {
    let req = [d.secs as i64, d.nanos as i64];
    let mut rem = [0i64, 0i64];
    unsafe {
        __exr_nanosleep(&req, &mut rem);
    }
}

// `std::sync::mpsc`: a queue under a futex Mutex, with a Condvar that both ends wait on. `recv` waits for a value
// while a sender is left (with none, Err: every sender hung up); `send` fails once the receiver is gone, and a
// sync_channel's waits while the queue is full (with bound 0, until its value is received)
struct __Chan<T> {
    m: u32,
    cv: u32,
    // (how many threads wait on cv: a send or a receive wakes them only when there are some)
    nw: u32,
    q: VecDeque<T>,
    senders: usize,
    rx: bool,
    // (a sync_channel's bound; usize::MAX for a channel)
    cap: usize,
    sent: u64,
    recvd: u64,
}

pub struct __Sndr<T> {
    c: Arc<__Chan<T>>,
}

// std's errors of the channels: a send's to a receiver that is gone (the value comes back; its Debug does not need
// T's), a recv's when every sender is gone, a try_recv's
pub struct SendError<T>(pub T);

impl<T> Debug for SendError<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str("SendError { .. }");
        Ok(())
    }
}

impl<T> Display for SendError<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.pad("sending on a closed channel")
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct RecvError;

impl Display for RecvError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.pad("receiving on a closed channel")
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum TryRecvError {
    Empty,
    Disconnected,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum RecvTimeoutError {
    Timeout,
    Disconnected,
}

impl Display for RecvTimeoutError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        match self {
            RecvTimeoutError::Timeout => f.pad("timed out waiting on channel"),
            RecvTimeoutError::Disconnected => f.pad("channel is empty and sending half is closed"),
        }
    }
}

impl Display for TryRecvError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        match self {
            TryRecvError::Empty => f.pad("receiving on an empty channel"),
            TryRecvError::Disconnected => f.pad("receiving on an empty and disconnected channel"),
        }
    }
}

pub struct __SyncSndr<T> {
    c: Arc<__Chan<T>>,
}

pub struct __Rcvr__<T> {
    c: Arc<__Chan<T>>,
}

fn __exr_chan<T>(cap: usize) -> Arc<__Chan<T>> {
    Arc::new(__Chan { m: 0, cv: 0, nw: 0, q: VecDeque::new(), senders: 1, rx: true, cap: cap, sent: 0, recvd: 0 })
}

fn __exr_chan_p<T>(c: &Arc<__Chan<T>>) -> *mut __Chan<T> {
    c.as_ref() as *const __Chan<T> as *mut __Chan<T>
}

// (with the channel's lock held: wait for a change, the lock let go meanwhile)
fn __exr_chan_wait<T>(c: *mut __Chan<T>) {
    unsafe {
        let cv = &mut (*c).cv as *mut u32;
        let m = &mut (*c).m as *mut u32;
        (*c).nw += 1;
        let n = __exr_atomic_load(cv);
        __exr_unlock(m);
        __exr_futex_wait(cv, n);
        __exr_lock(m);
        (*c).nw -= 1;
    }
}

unsafe extern "C" {
    #[link_name = "clock_gettime"]
    fn __exr_clock_gettime(clk: i32, ts: *mut [i64; 2]) -> i32;
}

// (CLOCK_MONOTONIC, in nanoseconds; u128::MAX when the read fails: under a lock, taken as the deadline reached, so the
// wait ends and the lock is let go)
fn __exr_mono_ns_or_max() -> u128 {
    let mut ts = [0i64, 0i64];
    if unsafe { __exr_clock_gettime(1, &mut ts) } != 0 {
        return 340282366920938463463374607431768211455;
    }
    ts[0] as u128 * 1000000000 + ts[1] as u128
}

// (the first read, before any lock: one that fails panics, as std's `Instant::now`, as no deadline could be set)
fn __exr_mono_ns() -> u128 {
    let t = __exr_mono_ns_or_max();
    if t == 340282366920938463463374607431768211455 {
        panic!("clock_gettime(CLOCK_MONOTONIC) failed");
    }
    t
}

// (as __exr_chan_wait, until the monotonic clock reads `end` at the latest)
fn __exr_chan_wait_until<T>(c: *mut __Chan<T>, end: u128) {
    let now = __exr_mono_ns_or_max();
    if now >= end {
        return;
    }
    let left = end - now;
    // (seconds past i64's range (`Duration::MAX`) are its largest: a negative timespec would make the wait fail at once)
    let secs = left / 1000000000;
    let ts = [if secs > 9223372036854775807 { 9223372036854775807 } else { secs as i64 }, (left % 1000000000) as i64];
    unsafe {
        let cv = &mut (*c).cv as *mut u32;
        let m = &mut (*c).m as *mut u32;
        (*c).nw += 1;
        let n = __exr_atomic_load(cv);
        __exr_unlock(m);
        __exr_futex_wait_for(cv, n, &ts);
        __exr_lock(m);
        (*c).nw -= 1;
    }
}

fn __exr_chan_notify<T>(c: *mut __Chan<T>) {
    unsafe {
        if (*c).nw != 0 {
            let cv = &mut (*c).cv as *mut u32;
            __exr_atomic_xadd(cv, 1);
            __exr_futex_wake_all(cv);
        }
    }
}

fn __exr_chan_send<T>(c: *mut __Chan<T>, v: T) -> Result<(), T> {
    unsafe {
        let m = &mut (*c).m as *mut u32;
        __exr_lock(m);
        if (*c).cap != 18446744073709551615 {
            let room = if (*c).cap == 0 { 1 } else { (*c).cap };
            while (*c).rx && (*c).q.len() >= room {
                __exr_chan_wait(c);
            }
        }
        if !(*c).rx {
            __exr_unlock(m);
            return Err(v);
        }
        (*c).q.push_back(v);
        (*c).sent += 1;
        let ticket = (*c).sent;
        __exr_chan_notify(c);
        if (*c).cap == 0 {
            while (*c).rx && (*c).recvd < ticket {
                __exr_chan_wait(c);
            }
            // (the receiver went before it took this one: it is still the queue's one value, and the send fails with it)
            if (*c).recvd < ticket {
                if let Some(v) = (*c).q.pop_back() {
                    __exr_unlock(m);
                    return Err(v);
                }
            }
        }
        __exr_unlock(m);
        Ok(())
    }
}

// (the next value; Err when there is none (wait: and no sender is left): Err(true) when no sender is left, decided
// under the same lock as the queue was found empty)
fn __exr_chan_recv<T>(c: *mut __Chan<T>, wait: bool) -> Result<T, bool> {
    unsafe {
        let m = &mut (*c).m as *mut u32;
        __exr_lock(m);
        loop {
            if let Some(v) = (*c).q.pop_front() {
                (*c).recvd += 1;
                __exr_chan_notify(c);
                __exr_unlock(m);
                return Ok(v);
            }
            let gone = (*c).senders == 0;
            if !wait || gone {
                __exr_unlock(m);
                return Err(gone);
            }
            __exr_chan_wait(c);
        }
    }
}

fn __exr_chan_sender<T>(c: &Arc<__Chan<T>>, delta: isize) {
    let p = __exr_chan_p(c);
    unsafe {
        let m = &mut (*p).m as *mut u32;
        __exr_lock(m);
        if delta > 0 {
            (*p).senders += 1;
        } else {
            (*p).senders -= 1;
            // (the last sender: a receiver that waits gets Err)
            if (*p).senders == 0 {
                __exr_chan_notify(p);
            }
        }
        __exr_unlock(m);
    }
}

pub fn __core_channel<T>() -> (__Sndr<T>, __Rcvr__<T>) {
    let c = __exr_chan(18446744073709551615);
    (__Sndr { c: c.clone() }, __Rcvr__ { c })
}

pub fn __core_sync_channel<T>(n: usize) -> (__SyncSndr<T>, __Rcvr__<T>) {
    let c = __exr_chan(n);
    (__SyncSndr { c: c.clone() }, __Rcvr__ { c })
}

impl<T> __Sndr<T> {
    pub fn send(&self, v: T) -> Result<(), SendError<T>> {
        match __exr_chan_send(__exr_chan_p(&self.c), v) {
            Ok(()) => Ok(()),
            Err(v) => Err(SendError(v)),
        }
    }
    pub fn clone(&self) -> __Sndr<T> {
        __exr_chan_sender(&self.c, 1);
        __Sndr { c: self.c.clone() }
    }
}

impl<T> Drop for __Sndr<T> {
    fn drop(&mut self) {
        // (a null Arc: this end was moved out of a closure's captures, which codegen zeroes)
        if self.c.p as usize == 0 {
            return;
        }
        __exr_chan_sender(&self.c, -1);
    }
}

impl<T> __SyncSndr<T> {
    pub fn send(&self, v: T) -> Result<(), SendError<T>> {
        match __exr_chan_send(__exr_chan_p(&self.c), v) {
            Ok(()) => Ok(()),
            Err(v) => Err(SendError(v)),
        }
    }
    pub fn clone(&self) -> __SyncSndr<T> {
        __exr_chan_sender(&self.c, 1);
        __SyncSndr { c: self.c.clone() }
    }
}

impl<T> Drop for __SyncSndr<T> {
    fn drop(&mut self) {
        if self.c.p as usize == 0 {
            return;
        }
        __exr_chan_sender(&self.c, -1);
    }
}

impl<T> __Rcvr__<T> {
    pub fn recv(&self) -> Result<T, RecvError> {
        match __exr_chan_recv(__exr_chan_p(&self.c), true) {
            Ok(v) => Ok(v),
            Err(_) => Err(RecvError),
        }
    }
    // (Empty while a sender is left, else Disconnected)
    pub fn try_recv(&self) -> Result<T, TryRecvError> {
        match __exr_chan_recv(__exr_chan_p(&self.c), false) {
            Ok(v) => Ok(v),
            Err(gone) => Err(if gone { TryRecvError::Disconnected } else { TryRecvError::Empty }),
        }
    }
    // (Timeout when no value comes within d while a sender is left)
    // (recv's loop with a deadline on the monotonic clock: here, so that a program that never calls it needs no clock)
    pub fn recv_timeout(&self, d: Duration) -> Result<T, RecvTimeoutError> {
        let end = __exr_mono_ns() + d.secs as u128 * 1000000000 + d.nanos as u128;
        let c = __exr_chan_p(&self.c);
        unsafe {
            let m = &mut (*c).m as *mut u32;
            __exr_lock(m);
            loop {
                if let Some(v) = (*c).q.pop_front() {
                    (*c).recvd += 1;
                    __exr_chan_notify(c);
                    __exr_unlock(m);
                    return Ok(v);
                }
                if (*c).senders == 0 {
                    __exr_unlock(m);
                    return Err(RecvTimeoutError::Disconnected);
                }
                if __exr_mono_ns_or_max() >= end {
                    __exr_unlock(m);
                    return Err(RecvTimeoutError::Timeout);
                }
                __exr_chan_wait_until(c, end);
            }
        }
    }
    pub fn iter(&self) -> __RecvIter<T> {
        __RecvIter { c: self.c.clone(), wait: true }
    }
    pub fn try_iter(&self) -> __RecvIter<T> {
        __RecvIter { c: self.c.clone(), wait: false }
    }
    // (the receiver itself: it stays while the iterator does)
    pub fn into_iter(self) -> __RecvIntoIter<T> {
        __RecvIntoIter { r: self }
    }
}

pub struct __RecvIntoIter<T> {
    r: __Rcvr__<T>,
}

impl<T> Iterator for __RecvIntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        self.r.recv().ok()
    }
}

// (the receiver gone: a send fails, and a sender waiting on a full sync_channel wakes to fail)
impl<T> Drop for __Rcvr__<T> {
    fn drop(&mut self) {
        if self.c.p as usize == 0 {
            return;
        }
        let p = __exr_chan_p(&self.c);
        unsafe {
            let m = &mut (*p).m as *mut u32;
            __exr_lock(m);
            (*p).rx = false;
            // (the values no one can receive now go, after the lock is let go: their drops may use the channel. A
            // rendezvous's value stays, for its sender to get back)
            let rest = if (*p).cap == 0 { VecDeque::new() } else { core::mem::replace(&mut (*p).q, VecDeque::new()) };
            __exr_chan_notify(p);
            __exr_unlock(m);
            drop(rest);
        }
    }
}

pub struct __RecvIter<T> {
    c: Arc<__Chan<T>>,
    // (iter: wait for the next value as recv; try_iter: only what is there)
    wait: bool,
}

impl<T> Iterator for __RecvIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        match __exr_chan_recv(__exr_chan_p(&self.c), self.wait) {
            Ok(v) => Some(v),
            Err(_) => None,
        }
    }
}


/// `std::mem::ManuallyDrop` (the value is not dropped: Program::needs_drop knows the name)
pub struct ManuallyDrop<T> {
    // (not `value`: a field of the type it derefs to may have that name, and std's field is private)
    __md_value: T,
}

impl<T> ManuallyDrop<T> {
    pub const fn new(v: T) -> ManuallyDrop<T> {
        ManuallyDrop { __md_value: v }
    }
    pub fn into_inner(slot: ManuallyDrop<T>) -> T {
        unsafe { (&slot.__md_value as *const T).read() }
    }
    pub unsafe fn drop(slot: &mut ManuallyDrop<T>) {
        __exr_drop_in_place(&mut slot.__md_value as *mut T);
    }
    pub unsafe fn take(slot: &mut ManuallyDrop<T>) -> T {
        (&slot.__md_value as *const T).read()
    }
    pub fn deref(&self) -> &T {
        &self.__md_value
    }
    pub fn deref_mut(&mut self) -> &mut T {
        &mut self.__md_value
    }
}

/// `std::pin::Pin` (no executor: nothing moves values behind the program's back, so a Pin is the pointer)
#[derive(Clone, Copy)]
pub struct Pin<P> {
    pointer: P,
}

// (as std's: what the pointer prints)
impl<P: Debug> Debug for Pin<P> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_debug(&self.pointer, f);
        Ok(())
    }
}

impl<P: Display> Display for Pin<P> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_display(&self.pointer, f);
        Ok(())
    }
}

// (std::task: futures run at once (see `async`), so nothing here is polled by zustc itself; these let a program
// implement Future and poll by hand)
pub enum Poll<T> {
    Ready(T),
    Pending,
}

impl<T> Poll<T> {
    pub fn is_ready(&self) -> bool {
        match self {
            Poll::Ready(_) => true,
            Poll::Pending => false,
        }
    }
    pub fn is_pending(&self) -> bool {
        !self.is_ready()
    }
}

pub struct Waker {
    _w: u8,
}

static __EXR_NOOP_WAKER: Waker = Waker { _w: 0 };

impl Waker {
    pub fn noop() -> &'static Waker {
        &__EXR_NOOP_WAKER
    }
    pub fn wake(self) {}
    pub fn wake_by_ref(&self) {}
    // (every Waker here is the no-op one, which std's will_wake also finds the same: its data and vtable)
    pub fn will_wake(&self, _other: &Waker) -> bool {
        true
    }
}

pub struct Context<'a> {
    waker: &'a Waker,
}

impl<'a> Context<'a> {
    pub fn from_waker(waker: &'a Waker) -> Context<'a> {
        Context { waker: waker }
    }
    pub fn waker(&self) -> &'a Waker {
        self.waker
    }
}

pub trait Future {
    type Output;
    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output>;
}

impl<P> Pin<P> {
    pub fn new(pointer: P) -> Pin<P> {
        Pin { pointer }
    }
    pub unsafe fn new_unchecked(pointer: P) -> Pin<P> {
        Pin { pointer }
    }
    pub fn into_inner(pin: Pin<P>) -> P {
        pin.pointer
    }
    pub unsafe fn into_inner_unchecked(pin: Pin<P>) -> P {
        pin.pointer
    }
    pub fn get_ref(self) -> P {
        self.pointer
    }
    pub fn get_mut(self) -> P {
        self.pointer
    }
    pub unsafe fn get_unchecked_mut(self) -> P {
        self.pointer
    }
    pub fn deref(&self) -> &P {
        &self.pointer
    }
    pub fn deref_mut(&mut self) -> &mut P {
        &mut self.pointer
    }
}

/// `std::any::TypeId` (`TypeId::of::<T>()` is made by the compiler: a hash of the type's name)
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub struct TypeId {
    t: u64,
}

/// `std::ptr::NonNull`
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub struct NonNull<T> {
    p: *mut T,
}

impl<T> NonNull<T> {
    pub fn new(p: *mut T) -> Option<NonNull<T>> {
        if p.is_null() { None } else { Some(NonNull { p }) }
    }
    pub const unsafe fn new_unchecked(p: *mut T) -> NonNull<T> {
        NonNull { p }
    }
    pub fn dangling() -> NonNull<T> {
        NonNull { p: core::mem::align_of::<T>() as *mut T }
    }
    pub fn as_ptr(self) -> *mut T {
        self.p
    }
    pub unsafe fn as_ref(&self) -> &T {
        &*self.p
    }
    pub unsafe fn as_mut(&mut self) -> &mut T {
        &mut *self.p
    }
    pub fn cast<U>(self) -> NonNull<U> {
        NonNull { p: self.p as *mut U }
    }
}

/// `std::cell::UnsafeCell`
pub struct UnsafeCell<T> {
    value: T,
}

impl<T> UnsafeCell<T> {
    pub const fn new(v: T) -> UnsafeCell<T> {
        UnsafeCell { value: v }
    }
    pub fn get(&self) -> *mut T {
        &self.value as *const T as *mut T
    }
    pub fn get_mut(&mut self) -> &mut T {
        &mut self.value
    }
    pub fn into_inner(self) -> T {
        self.value
    }
}

// 内部可変性。借用は実行時に数える (std と同じ): flag は 0 で空き、正なら共有の借用の数、-1 なら可変の借用。
// borrow / borrow_mut は Ref / RefMut (ガード) を返し、ガードが drop されると借用を返す。重なる借用は panic
// (tests/security/rt_refcell.rs: 二つの borrow_mut が同じ値を指せば safe なコードで &mut が二つになる)
pub struct RefCell<T> {
    flag: isize,
    val: T,
}

pub struct BorrowError {
    _p: (),
}

pub struct BorrowMutError {
    _p: (),
}

impl Debug for BorrowError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str("BorrowError");
        Ok(())
    }
}

impl Debug for BorrowMutError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str("BorrowMutError");
        Ok(())
    }
}

impl Display for BorrowError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str("RefCell already mutably borrowed");
        Ok(())
    }
}

impl Display for BorrowMutError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str("RefCell already borrowed");
        Ok(())
    }
}

impl<T> RefCell<T> {
    pub const fn new(v: T) -> RefCell<T> {
        RefCell { flag: 0, val: v }
    }
    fn __flag(&self) -> *mut isize {
        &self.flag as *const isize as *mut isize
    }
    pub fn borrow(&self) -> Ref<T> {
        let f = self.__flag();
        if unsafe { *f } < 0 {
            panic!("RefCell already mutably borrowed");
        }
        unsafe {
            *f += 1;
        }
        Ref { __v: &self.val as *const T, __b: f }
    }
    pub fn borrow_mut(&self) -> RefMut<T> {
        let f = self.__flag();
        if unsafe { *f } != 0 {
            panic!("RefCell already borrowed");
        }
        unsafe {
            *f = -1;
        }
        RefMut { __v: &self.val as *const T as *mut T, __b: f }
    }
    pub fn try_borrow(&self) -> Result<Ref<T>, BorrowError> {
        if unsafe { *self.__flag() } < 0 { Err(BorrowError { _p: () }) } else { Ok(self.borrow()) }
    }
    pub fn try_borrow_mut(&self) -> Result<RefMut<T>, BorrowMutError> {
        if unsafe { *self.__flag() } != 0 { Err(BorrowMutError { _p: () }) } else { Ok(self.borrow_mut()) }
    }
    pub fn into_inner(self) -> T {
        self.val
    }
    pub fn replace(&self, v: T) -> T {
        let mut g = self.borrow_mut();
        __core_replace(g.deref_mut(), v)
    }
    pub fn replace_with<F: FnOnce(&mut T) -> T>(&self, f: F) -> T {
        let mut g = self.borrow_mut();
        let v = f(g.deref_mut());
        __core_replace(g.deref_mut(), v)
    }
    pub fn take(&self) -> T {
        let mut g = self.borrow_mut();
        __core_replace(g.deref_mut(), __exr_default::<T>())
    }
    pub fn swap(&self, other: &RefCell<T>) {
        let mut a = self.borrow_mut();
        let mut b = other.borrow_mut();
        __core_swap(a.deref_mut(), b.deref_mut());
    }
    pub fn get_mut(&mut self) -> &mut T {
        &mut self.val
    }
    pub fn as_ptr(&self) -> *mut T {
        &self.val as *const T as *mut T
    }
}

// `RefCell::borrow` のガード: 生きている間は共有の借用を一つ数える
// (フィールドの名前は値のフィールドと重ならないもの: `guard.f` は値の f)
pub struct Ref<T> {
    __v: *const T,
    __b: *mut isize,
}

impl<T> Ref<T> {
    pub fn deref(&self) -> &T {
        unsafe { &*self.__v }
    }
}

impl<T> Drop for Ref<T> {
    fn drop(&mut self) {
        unsafe {
            *self.__b -= 1;
        }
    }
}

// `RefCell::borrow_mut` のガード: 生きている間は可変の借用 (ほかの借用はすべて panic)
pub struct RefMut<T> {
    __v: *mut T,
    __b: *mut isize,
}

impl<T> RefMut<T> {
    pub fn deref(&self) -> &T {
        unsafe { &*self.__v }
    }
    pub fn deref_mut(&mut self) -> &mut T {
        unsafe { &mut *self.__v }
    }
}

impl<T> Drop for RefMut<T> {
    fn drop(&mut self) {
        unsafe {
            *self.__b = 0;
        }
    }
}

// `Ref::map(r, |v| &v.f)` / `RefMut::map(m, ..)` / `Ref::clone(&r)` (associated functions, not methods: `g.map(..)` is
// the value's). The new guard holds the borrow of the old one, which is forgotten instead of dropped
pub fn __exr_ref_map<T, U, F: FnOnce(&T) -> &U>(orig: Ref<T>, f: F) -> Ref<U> {
    let v = f(unsafe { &*orig.__v }) as *const U;
    let b = orig.__b;
    __core_forget(orig);
    Ref { __v: v, __b: b }
}

pub fn __exr_refmut_map<T, U, F: FnOnce(&mut T) -> &mut U>(orig: RefMut<T>, f: F) -> RefMut<U> {
    let v = f(unsafe { &mut *orig.__v }) as *mut U;
    let b = orig.__b;
    __core_forget(orig);
    RefMut { __v: v, __b: b }
}

pub fn __exr_ref_clone<T>(orig: &Ref<T>) -> Ref<T> {
    unsafe {
        *orig.__b += 1;
    }
    Ref { __v: orig.__v, __b: orig.__b }
}

impl<T> Debug for Ref<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_debug(self.deref(), f);
        Ok(())
    }
}

impl<T> Display for Ref<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_display(self.deref(), f);
        Ok(())
    }
}

impl<T> Debug for RefMut<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_debug(self.deref(), f);
        Ok(())
    }
}

impl<T> Display for RefMut<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_display(self.deref(), f);
        Ok(())
    }
}

impl<T> Debug for RefCell<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_dbg_begin::<()>(f, "RefCell", 0);
        __exr_dbg_item::<()>(f, 0, "value");
        // (borrowed mutably: what std prints instead of the value, which the RefMut may be changing)
        if self.flag < 0 {
            f.buf.push_str("<borrowed>");
        } else {
            __exr_debug(&self.val, f);
        }
        __exr_dbg_item_end::<()>(f);
        __exr_dbg_end::<()>(f, 1, 0, false);
        Ok(())
    }
}

pub struct Cell<T> {
    val: T,
}

// `std::ptr::eq(a, b)`: 同じアドレスか
pub fn __exr_ptr_eq<T>(a: &T, b: &T) -> bool {
    a as *const T == b as *const T
}

// `std::sync::Mutex`: std's futex mutex. The state is 0 unlocked, 1 locked, 2 locked with waiters: `lock` takes it
// 0 -> 1, or else spins a little and then marks it 2 and waits on the futex; the guard's drop sets 0 and wakes one
// waiter when it was 2. A lock by the thread that holds it waits forever, as std's
pub struct Mutex<T> {
    val: T,
    locked: u32,
}

pub struct MutexGuard<T> {
    p: *mut T,
    m: *mut u32,
}

fn __exr_lock(m: *mut u32) {
    if __exr_atomic_cas(m, 0, 1) != 0 {
        __exr_lock_contended(m);
    }
}

fn __exr_lock_contended(m: *mut u32) {
    // (a short spin first: a lock held briefly is often free again before a futex call could return)
    let mut k = 0;
    while k < 100 {
        let s = __exr_atomic_load(m);
        if s == 0 && __exr_atomic_cas(m, 0, 1) == 0 {
            return;
        }
        if s == 2 {
            break;
        }
        k += 1;
    }
    while __exr_atomic_xchg(m, 2) != 0 {
        __exr_futex_wait(m, 2);
    }
}

fn __exr_unlock(m: *mut u32) {
    if __exr_atomic_xchg(m, 0) == 2 {
        __exr_futex_wake(m, 1);
    }
}

impl<T> Mutex<T> {
    pub const fn new(v: T) -> Mutex<T> {
        Mutex { val: v, locked: 0 }
    }
    fn __m(&self) -> *mut u32 {
        &self.locked as *const u32 as *mut u32
    }
    pub fn lock(&self) -> Result<MutexGuard<T>, PoisonError<MutexGuard<T>>> {
        let m = self.__m();
        __exr_lock(m);
        Ok(MutexGuard { p: &self.val as *const T as *mut T, m: m })
    }
    pub fn into_inner(self) -> Result<T, PoisonError<T>> {
        Ok(self.val)
    }
    pub fn get_mut(&mut self) -> Result<&mut T, PoisonError<&mut T>> {
        Ok(&mut self.val)
    }
}

// `std::sync::PoisonError`, the Err of a Mutex's lock: none comes here (a panic does not unwind, so no lock is
// poisoned), but a program handles it, `Err(e) => e.into_inner()` (#256)
pub struct PoisonError<T> {
    guard: T,
}

impl<T> PoisonError<T> {
    pub fn new(guard: T) -> PoisonError<T> {
        PoisonError { guard: guard }
    }
    pub fn into_inner(self) -> T {
        self.guard
    }
    pub fn get_ref(&self) -> &T {
        &self.guard
    }
    pub fn get_mut(&mut self) -> &mut T {
        &mut self.guard
    }
}

impl<T> Debug for PoisonError<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_fmt_str::<()>(f, "PoisonError { .. }");
        Ok(())
    }
}

impl<T> Display for PoisonError<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_fmt_str::<()>(f, "poisoned lock: another task failed inside");
        Ok(())
    }
}

impl<T> Deref for MutexGuard<T> {
    type Target = T;
    fn deref(&self) -> &T {
        unsafe { &*self.p }
    }
}

impl<T: Debug> Debug for MutexGuard<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_debug(self.deref(), f);
        Ok(())
    }
}

impl<T: Display> Display for MutexGuard<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_display(self.deref(), f);
        Ok(())
    }
}

impl<T> Drop for MutexGuard<T> {
    fn drop(&mut self) {
        __exr_unlock(self.m);
    }
}

// `std::sync::Condvar`: std's futex condvar, a counter each notify bumps. `wait` reads it, lets the Mutex go, waits
// on the futex while the counter is still what it read (so a notify between the two is not lost), and takes the
// Mutex again. A wakeup may be spurious, which std allows. A wait nothing notifies waits forever, as std's
pub struct Condvar {
    __cv_n: u32,
}

impl Condvar {
    pub const fn new() -> Condvar {
        Condvar { __cv_n: 0 }
    }
    fn __p(&self) -> *mut u32 {
        &self.__cv_n as *const u32 as *mut u32
    }
    pub fn wait<T>(&self, guard: MutexGuard<T>) -> Result<MutexGuard<T>, PoisonError<MutexGuard<T>>> {
        let n = __exr_atomic_load(self.__p());
        __exr_unlock(guard.m);
        __exr_futex_wait(self.__p(), n);
        __exr_lock(guard.m);
        Ok(guard)
    }
    pub fn wait_while<T, F: FnMut(&mut T) -> bool>(&self, guard: MutexGuard<T>, condition: F) -> Result<MutexGuard<T>, PoisonError<MutexGuard<T>>> {
        let mut g = guard;
        let mut condition = condition;
        while condition(unsafe { &mut *g.p }) {
            g = self.wait(g).unwrap();
        }
        Ok(g)
    }
    pub fn notify_one(&self) {
        __exr_atomic_xadd(self.__p(), 1);
        __exr_futex_wake(self.__p(), 1);
    }
    pub fn notify_all(&self) {
        __exr_atomic_xadd(self.__p(), 1);
        __exr_futex_wake_all(self.__p());
    }
}

impl Debug for Condvar {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.debug_struct("\x43ondvar").finish_non_exhaustive()
    }
}

// `std::sync::Barrier`: as std's, a count under a lock and a generation. The thread that makes the count n is the
// leader: it starts the next generation and wakes the others (a futex word that each new generation bumps)
pub struct Barrier {
    __b_m: u32,
    __b_cv: u32,
    __b_count: usize,
    __b_gen: usize,
    __b_n: usize,
}

pub struct BarrierWaitResult(bool);

impl BarrierWaitResult {
    pub fn is_leader(&self) -> bool {
        self.0
    }
}

impl Barrier {
    pub const fn new(n: usize) -> Barrier {
        Barrier { __b_m: 0, __b_cv: 0, __b_count: 0, __b_gen: 0, __b_n: n }
    }
    pub fn wait(&self) -> BarrierWaitResult {
        let p = self as *const Barrier as *mut Barrier;
        unsafe {
            let m = &mut (*p).__b_m as *mut u32;
            let cv = &mut (*p).__b_cv as *mut u32;
            __exr_lock(m);
            let g = (*p).__b_gen;
            (*p).__b_count += 1;
            if (*p).__b_count < (*p).__b_n {
                while g == (*p).__b_gen {
                    let n = __exr_atomic_load(cv);
                    __exr_unlock(m);
                    __exr_futex_wait(cv, n);
                    __exr_lock(m);
                }
                __exr_unlock(m);
                return BarrierWaitResult(false);
            }
            (*p).__b_count = 0;
            (*p).__b_gen += 1;
            __exr_atomic_xadd(cv, 1);
            __exr_futex_wake_all(cv);
            __exr_unlock(m);
            BarrierWaitResult(true)
        }
    }
}

impl Debug for Barrier {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.debug_struct("\x42arrier").finish_non_exhaustive()
    }
}

impl Debug for BarrierWaitResult {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.debug_struct("\x42arrierWaitResult").field("is_leader", &self.0).finish()
    }
}

// `std::sync::RwLock`: the state is the number of readers, or u32::MAX while a writer holds it. A thread that cannot
// have it waits on a second futex word, which every unlock bumps (and wakes all on, when anyone waits)
struct __RwState {
    st: u32,
    seq: u32,
    waiting: u32,
}

pub struct RwLock<T> {
    val: T,
    __rw: __RwState,
}

pub struct RwLockReadGuard<T> {
    p: *const T,
    l: *mut __RwState,
}

pub struct RwLockWriteGuard<T> {
    p: *mut T,
    l: *mut __RwState,
}

// (wait for the lock to be free for a reader (or a writer) once; the caller tries again)
fn __exr_rw_wait(l: *mut __RwState, write: bool) {
    unsafe {
        let seq = &mut (*l).seq as *mut u32;
        let waiting = &mut (*l).waiting as *mut u32;
        let q = __exr_atomic_load(seq);
        __exr_atomic_xadd(waiting, 1);
        let s = __exr_atomic_load(&mut (*l).st as *mut u32);
        if (write && s != 0) || (!write && s >= 4294967294) {
            __exr_futex_wait(seq, q);
        }
        __exr_atomic_xadd(waiting, 4294967295);
    }
}

fn __exr_rw_wake(l: *mut __RwState) {
    unsafe {
        let seq = &mut (*l).seq as *mut u32;
        __exr_atomic_xadd(seq, 1);
        if __exr_atomic_load(&mut (*l).waiting as *mut u32) != 0 {
            __exr_futex_wake_all(seq);
        }
    }
}

impl<T> RwLock<T> {
    pub const fn new(v: T) -> RwLock<T> {
        RwLock { val: v, __rw: __RwState { st: 0, seq: 0, waiting: 0 } }
    }
    fn __l(&self) -> *mut __RwState {
        &self.__rw as *const __RwState as *mut __RwState
    }
    pub fn read(&self) -> Result<RwLockReadGuard<T>, PoisonError<RwLockReadGuard<T>>> {
        let l = self.__l();
        let st = unsafe { &mut (*l).st as *mut u32 };
        loop {
            let s = __exr_atomic_load(st);
            if s < 4294967294 {
                if __exr_atomic_cas(st, s, s + 1) == s {
                    break;
                }
                continue;
            }
            __exr_rw_wait(l, false);
        }
        Ok(RwLockReadGuard { p: &self.val as *const T, l: l })
    }
    pub fn write(&self) -> Result<RwLockWriteGuard<T>, PoisonError<RwLockWriteGuard<T>>> {
        let l = self.__l();
        let st = unsafe { &mut (*l).st as *mut u32 };
        while __exr_atomic_cas(st, 0, 4294967295) != 0 {
            __exr_rw_wait(l, true);
        }
        Ok(RwLockWriteGuard { p: &self.val as *const T as *mut T, l: l })
    }
    pub fn into_inner(self) -> Result<T, PoisonError<T>> {
        Ok(self.val)
    }
    pub fn get_mut(&mut self) -> Result<&mut T, PoisonError<&mut T>> {
        Ok(&mut self.val)
    }
}

impl<T> Deref for RwLockReadGuard<T> {
    type Target = T;
    fn deref(&self) -> &T {
        unsafe { &*self.p }
    }
}

impl<T> Drop for RwLockReadGuard<T> {
    fn drop(&mut self) {
        unsafe {
            __exr_atomic_xadd(&mut (*self.l).st as *mut u32, 4294967295);
        }
        __exr_rw_wake(self.l);
    }
}

impl<T> Deref for RwLockWriteGuard<T> {
    type Target = T;
    fn deref(&self) -> &T {
        unsafe { &*self.p }
    }
}

impl<T> RwLockWriteGuard<T> {
    pub fn deref_mut(&mut self) -> &mut T {
        unsafe { &mut *self.p }
    }
}

impl<T> Drop for RwLockWriteGuard<T> {
    fn drop(&mut self) {
        unsafe {
            __exr_atomic_store(&mut (*self.l).st as *mut u32, 0);
        }
        __exr_rw_wake(self.l);
    }
}

// (as std's: the data under a read lock taken without waiting, or `<locked>` while a writer holds it)
impl<T: Debug> Debug for RwLock<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        let l = self.__l();
        let st = unsafe { &mut (*l).st as *mut u32 };
        let s = __exr_atomic_load(st);
        f.buf.push_str("RwLock { data: ");
        if s < 4294967294 && __exr_atomic_cas(st, s, s + 1) == s {
            __exr_debug(&self.val, f);
            __exr_atomic_xadd(st, 4294967295);
            __exr_rw_wake(l);
        } else {
            f.buf.push_str("<locked>");
        }
        f.buf.push_str(", poisoned: false, .. }");
        Ok(())
    }
}

// `std::sync::OnceLock`: a Once, and the value it sets
pub struct OnceLock<T> {
    val: Option<T>,
    __ol_once: Once,
}

// `std::sync::Once`: std's futex Once. The state is 0 not run, 1 running, 3 running with waiters, 2 done, 4 poisoned:
// the thread that takes it 0 -> 1 runs the closure, the others wait on the futex until it is done. A panic does not
// unwind, but a spawned thread that panics in the closure poisons it (its waiters wake): `call_once` then panics, as
// std's, and `call_once_force` and OnceLock run their closure again
pub struct Once {
    __once_st: u32,
}

pub struct OnceState {
    __os_poisoned: bool,
}

pub const ONCE_INIT: Once = Once { __once_st: 0 };

// (set by the first thread spawned: a Once begun (true) or done (false) on a spawned thread, which its panic poisons)
static mut __EXR_ONCE_HOOK: Option<fn(*mut u32, bool)> = None;

impl Once {
    pub const fn new() -> Once {
        Once { __once_st: 0 }
    }
    fn __p(&self) -> *mut u32 {
        &self.__once_st as *const u32 as *mut u32
    }
    pub fn is_completed(&self) -> bool {
        __exr_atomic_load(self.__p()) == 2
    }
    pub fn call_once<F: FnOnce()>(&self, f: F) {
        if !self.is_completed() && self.__once_begin(false) != 0 {
            f();
            self.__once_end();
        }
    }
    pub fn call_once_force<F: FnOnce(&OnceState)>(&self, f: F) {
        if !self.is_completed() {
            let b = self.__once_begin(true);
            if b != 0 {
                f(&OnceState { __os_poisoned: b == 2 });
                self.__once_end();
            }
        }
    }
    // (1: this thread is to run the closure; 2: so, after a poisoning (force only); 0: another one ran it meanwhile. A
    // call_once inside its own closure waits forever, as std's)
    fn __once_begin(&self, force: bool) -> u8 {
        let p = self.__p();
        loop {
            let s = __exr_atomic_load(p);
            if s == 2 {
                return 0;
            }
            if s == 0 || s == 4 {
                if s == 4 && !force {
                    panic!("Once instance has previously been poisoned");
                }
                if __exr_atomic_cas(p, s, 1) == s {
                    if let Some(h) = unsafe { __EXR_ONCE_HOOK } {
                        h(p, true);
                    }
                    return if s == 4 { 2 } else { 1 };
                }
                continue;
            }
            if s == 1 && __exr_atomic_cas(p, 1, 3) != 1 {
                continue;
            }
            __exr_futex_wait(p, 3);
        }
    }
    fn __once_end(&self) {
        if let Some(h) = unsafe { __EXR_ONCE_HOOK } {
            h(self.__p(), false);
        }
        if __exr_atomic_xchg(self.__p(), 2) == 3 {
            __exr_futex_wake_all(self.__p());
        }
    }
}

impl OnceState {
    pub fn is_poisoned(&self) -> bool {
        self.__os_poisoned
    }
}

impl Debug for Once {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.debug_struct("\x4fnce").finish_non_exhaustive()
    }
}

// `std::cell::OnceCell`: whether it is set, and the value (OnceLock's, for one thread)
pub struct OnceCell<T> {
    val: Option<T>,
}

impl<T> OnceCell<T> {
    pub const fn new() -> OnceCell<T> {
        OnceCell { val: None }
    }
    pub fn get(&self) -> Option<&T> {
        self.val.as_ref()
    }
    pub fn get_mut(&mut self) -> Option<&mut T> {
        self.val.as_mut()
    }
    pub fn get_or_init<F: FnOnce() -> T>(&self, f: F) -> &T {
        if self.val.is_none() {
            let v = f();
            // (an initializer that set the cell itself: std's "reentrant init" panic, not the value replaced)
            if self.val.is_some() {
                panic!("reentrant init");
            }
            let p = &self.val as *const Option<T> as *mut Option<T>;
            unsafe {
                p.write(Some(v));
            }
        }
        self.val.as_ref().unwrap()
    }
    pub fn set(&self, v: T) -> Result<(), T> {
        if self.val.is_some() {
            return Err(v);
        }
        let p = &self.val as *const Option<T> as *mut Option<T>;
        unsafe {
            p.write(Some(v));
        }
        Ok(())
    }
    pub fn into_inner(self) -> Option<T> {
        self.val
    }
    pub fn take(&mut self) -> Option<T> {
        self.val.take()
    }
}

/// `std::cell::LazyCell`: the function makes the value on the first deref / `force`
pub struct LazyCell<T, F = fn() -> T> {
    __lz_val: Option<T>,
    __lz_init: Option<F>,
}

impl<T, F: FnOnce() -> T> LazyCell<T, F> {
    pub const fn new(f: F) -> LazyCell<T, F> {
        LazyCell { __lz_val: None, __lz_init: Some(f) }
    }
    pub fn force(this: &LazyCell<T, F>) -> &T {
        if this.__lz_val.is_none() {
            let pi = &this.__lz_init as *const Option<F> as *mut Option<F>;
            let f = unsafe { (*pi).take() }.expect("LazyCell instance has previously been poisoned");
            let v = f();
            let p = &this.__lz_val as *const Option<T> as *mut Option<T>;
            unsafe {
                p.write(Some(v));
            }
        }
        this.__lz_val.as_ref().unwrap()
    }
    pub fn deref(&self) -> &T {
        LazyCell::force(self)
    }
}

impl<T> OnceLock<T> {
    pub const fn new() -> OnceLock<T> {
        OnceLock { val: None, __ol_once: Once { __once_st: 0 } }
    }
    pub fn get(&self) -> Option<&T> {
        if self.__ol_once.is_completed() { self.val.as_ref() } else { None }
    }
    // (the closure runs on one thread; the others wait for its value. One that panicked on a spawned thread leaves the
    // cell empty, and the next caller runs its own, as std's)
    pub fn get_or_init<F: FnOnce() -> T>(&self, f: F) -> &T {
        if !self.__ol_once.is_completed() && self.__ol_once.__once_begin(true) != 0 {
            let v = f();
            unsafe {
                (&self.val as *const Option<T> as *mut Option<T>).write(Some(v));
            }
            self.__ol_once.__once_end();
        }
        self.val.as_ref().unwrap()
    }
    pub fn set(&self, v: T) -> Result<(), T> {
        if !self.__ol_once.is_completed() && self.__ol_once.__once_begin(true) != 0 {
            unsafe {
                (&self.val as *const Option<T> as *mut Option<T>).write(Some(v));
            }
            self.__ol_once.__once_end();
            return Ok(());
        }
        Err(v)
    }
}

impl<T> Cell<T> {
    pub fn new(v: T) -> Cell<T> {
        Cell { val: v }
    }
    pub fn get(&self) -> T {
        unsafe { (&self.val as *const T).read() }
    }
    pub fn set(&self, v: T) {
        unsafe {
            let p = &self.val as *const T as *mut T;
            __exr_drop_in_place(p);
            p.write(v);
        }
    }
    pub fn replace(&self, v: T) -> T {
        let p = &self.val as *const T as *mut T;
        unsafe {
            let old = p.read();
            p.write(v);
            old
        }
    }
    pub fn into_inner(self) -> T {
        self.val
    }
    pub fn take(&self) -> T {
        self.replace(__exr_default::<T>())
    }
    pub fn get_mut(&mut self) -> &mut T {
        &mut self.val
    }
}

impl<T> Debug for Cell<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_dbg_begin::<()>(f, "Cell", 0);
        __exr_dbg_item::<()>(f, 0, "value");
        __exr_debug(&self.val, f);
        __exr_dbg_item_end::<()>(f);
        __exr_dbg_end::<()>(f, 1, 0, false);
        Ok(())
    }
}

impl<T> Debug for Vec<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_dbg_begin::<()>(f, "", 2);
        let mut i = 0;
        while i < self.len {
            __exr_dbg_item::<()>(f, i, "");
            unsafe {
                __exr_debug(&*self.ptr.add(i), f);
            }
            __exr_dbg_item_end::<()>(f);
            i += 1;
        }
        if self.len == 0 && f.alt {
            // 空なら `[]`
            f.indent -= 1;
            f.buf.pop_byte();
            f.buf.push(']');
            return Ok(());
        }
        __exr_dbg_end::<()>(f, self.len, 2, false);
        Ok(())
    }
}

impl String {
    fn pop_byte(&mut self) {
        self.vec.len -= 1;
    }
    // (unsafe as in std: the caller keeps the bytes UTF-8)
    pub unsafe fn as_mut_vec(&mut self) -> &mut Vec<u8> {
        &mut self.vec
    }
}
// --- 順序 (Ordering / 大小比較の glue。型ごとの比較の本体は codegen が作る __exr_cmp) ---

// 演算子の trait (`impl Add for V`)。`a + b` は codegen が `a.add(b)` にする (右辺の型は impl の add の引数で決まる)
pub trait Add {
    type Output;
    fn add(self, rhs: Self) -> Self::Output;
}
pub trait Sub {
    type Output;
    fn sub(self, rhs: Self) -> Self::Output;
}
pub trait Mul {
    type Output;
    fn mul(self, rhs: Self) -> Self::Output;
}
pub trait Div {
    type Output;
    fn div(self, rhs: Self) -> Self::Output;
}
pub trait Rem {
    type Output;
    fn rem(self, rhs: Self) -> Self::Output;
}
// std::error::Error (メソッドは使わない: `Box<dyn Error>` は __DynError で表す)
pub trait Error {
    fn __err_mark(&self) {}
    /// (the TypeId of the implementing type, for `dyn Error`'s `is`: each impl's instance of the default)
    fn __err_type_id(&self) -> TypeId {
        TypeId::of::<Self>()
    }
}
// `<dyn Error + 'static>::is` (std's: only a `'static` object has a type to compare)
impl dyn Error + 'static {
    pub fn is<T: Error + 'static>(&self) -> bool {
        self.__err_type_id() == TypeId::of::<T>()
    }
}
// (std's error types are errors: `Some(err)` as `&dyn Error`, `E: Error` bounds)
impl Error for IoError {
    fn __err_mark(&self) {}
}
impl Error for Utf8Error {
    fn __err_mark(&self) {}
}
impl Error for FromUtf8Error {
    fn __err_mark(&self) {}
}
impl Error for ParseIntError {
    fn __err_mark(&self) {}
}
impl Error for ParseFloatError {
    fn __err_mark(&self) {}
}
impl Error for TryFromIntError {
    fn __err_mark(&self) {}
}
impl Error for LayoutError {
    fn __err_mark(&self) {}
}
impl Error for Infallible {
    fn __err_mark(&self) {}
}
impl Error for __FmtError {
    fn __err_mark(&self) {}
}
impl<T> Error for PoisonError<T> {
    fn __err_mark(&self) {}
}
impl<T> Error for TryLockError<T> {
