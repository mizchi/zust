}

pub trait PartialEq {
    fn eq(&self, other: &Self) -> bool;
}
pub trait Eq {
    fn __exr_eq_marker(&self) {}
}
// `Option<String>::as_deref()` 用 (String を &str に)
pub trait __AsStr {
    fn __as_str(&self) -> &str;
}

impl __AsStr for String {
    fn __as_str(&self) -> &str {
        self.as_str()
    }
}

pub trait Default {
    fn default() -> Self;
}
pub trait Clone {
    fn clone(&self) -> Self;
}
pub trait Copy {
    fn __exr_copy_marker(&self) {}
}
pub trait PartialOrd {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering>;
}
pub trait Ord {
    fn cmp(&self, other: &Self) -> Ordering;
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub enum Ordering {
    Less = -1,
    Equal = 0,
    Greater = 1,
}

impl Ordering {
    pub fn reverse(self) -> Ordering {
        match self {
            Ordering::Less => Ordering::Greater,
            Ordering::Equal => Ordering::Equal,
            Ordering::Greater => Ordering::Less,
        }
    }
    pub fn then(self, o: Ordering) -> Ordering {
        match self {
            Ordering::Equal => o,
            x => x,
        }
    }
    pub fn then_with<F: FnOnce() -> Ordering>(self, f: F) -> Ordering {
        match self {
            Ordering::Equal => f(),
            x => x,
        }
    }
    pub fn is_eq(self) -> bool {
        __exr_ord_i32::<()>(&self) == 0
    }
    pub fn is_ne(self) -> bool {
        __exr_ord_i32::<()>(&self) != 0
    }
    pub fn is_lt(self) -> bool {
        __exr_ord_i32::<()>(&self) < 0
    }
    pub fn is_le(self) -> bool {
        __exr_ord_i32::<()>(&self) <= 0
    }
    pub fn is_gt(self) -> bool {
        __exr_ord_i32::<()>(&self) > 0
    }
    pub fn is_ge(self) -> bool {
        __exr_ord_i32::<()>(&self) >= 0
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub struct Reverse<T>(pub T);

/// `std::num::Wrapping<T>` / `std::num::Saturating<T>`: the value in a public field (their arithmetic is not here)
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]
pub struct Wrapping<T>(pub T);
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]
pub struct Saturating<T>(pub T);

/// `std::num::NonZeroU8` .. `NonZeroIsize`: an integer that is never 0 (`new` gives None for 0). Formatted as the
/// number, as std's are

#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct NonZeroU8(u8);
impl NonZeroU8 {
    pub const MIN: NonZeroU8 = NonZeroU8(1);
    pub const MAX: NonZeroU8 = NonZeroU8(u8::MAX);
    pub const BITS: u32 = u8::BITS;
    pub const fn new(n: u8) -> Option<NonZeroU8> {
        if n == 0 { None } else { Some(NonZeroU8(n)) }
    }
    pub const unsafe fn new_unchecked(n: u8) -> NonZeroU8 {
        NonZeroU8(n)
    }
    pub const fn get(self) -> u8 {
        self.0
    }
}
impl Display for NonZeroU8 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        write!(f, "{}", self.0)
    }
}
impl Debug for NonZeroU8 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        write!(f, "{}", self.0)
    }
}

