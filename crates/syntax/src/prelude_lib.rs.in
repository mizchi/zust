}

// `Box<dyn Error>`: 変換した時点で表示 ({}) と Debug ({:?}) の文字列にしておく
pub struct __DynError {
    msg: String,
    dbg: String,
}

impl Display for __DynError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_fmt_str::<()>(f, self.msg.as_str());
        Ok(())
    }
}

// (std's text for `fmt::Error`)
impl Display for __FmtError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_fmt_str::<()>(f, "an error occurred when formatting an argument");
        Ok(())
    }
}

impl Debug for __FmtError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str("Error");
        Ok(())
    }
}
impl Debug for __DynError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str(self.dbg.as_str());
        Ok(())
    }
}

fn __exr_dyn_error<E>(e: E) -> __DynError {
    __DynError { msg: format!("{}", e), dbg: format!("{:?}", e) }
}

// `fn main() -> Result<(), E>` が Err で終わったとき
fn __exr_main_err<E>(e: &E) {
    eprintln!("Error: {:?}", e);
    __core_process_exit(1);
}

// `impl IntoIterator for &Coll`: 名前だけ (for がユーザの into_iter を呼ぶ)
pub trait IntoIterator {
    fn __into_iter_mark(&self) {}
}

// `impl From<X> for S`: trait は名前だけ (型パラメータのある trait はまだないので、impl のシグネチャを使う)
// (宣言の引数の型は使わない。メソッドがないと trait ごと選ばれないので 1 つ置く)
// (declared only for a program's own impls of them, as the operator traits: the compiler gives `x.into()`,
// `s.as_ref()`, `b.borrow()` and `collect()` their meaning for the std types itself)
pub trait AsRef {
    fn as_ref(&self) -> &Self;
}
pub trait AsMut {
    fn as_mut(&mut self) -> &mut Self;
}
pub trait Into {
    fn into(self) -> Self;
}
pub trait Borrow {
    fn borrow(&self) -> &Self;
}
pub trait BorrowMut {
    fn borrow_mut(&mut self) -> &mut Self;
}
pub trait FromIterator {
    fn from_iter<I>(iter: I) -> Self;
}
// (`impl Extend<bool> for BitVec`: a program's own; Vec's, String's and the collections' `extend` are their own methods)
pub trait Extend {
    fn extend<I>(&mut self, iter: I);
}

pub trait From {
    fn from(t: Self) -> Self;
}

/// `TryFrom<T>` / `TryInto<U>` as a crate implements them for its own types (`impl TryFrom<&str> for Alphabet`);
/// integer conversions (`u8::try_from(x)`, `x.try_into()`) are acg's own
pub trait TryFrom {
    type Error;
    fn try_from(t: Self) -> Result<Self, Self::Error>;
}

pub trait TryInto {
    type Error;
    fn try_into(self) -> Result<Self, Self::Error>;
}

pub trait Neg {
