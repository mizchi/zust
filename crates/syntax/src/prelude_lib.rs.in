fn __exr_str_parse<T: FromStr>(s: &str) -> Result<T, T::Err> {
    <T as FromStr>::from_str(s)
}

// char のメソッド (Unicode の表は持たないので、ASCII と Latin-1 / ギリシャ文字 / キリル文字 / 仮名・漢字の範囲で近似する)
// `char::is_ascii_digit` のような関数の値 (std では &self を取る)
fn __exr_charfn_is_ascii_digit<G>(c: &char) -> bool {
    (*c).is_ascii_digit()
}

fn __exr_charfn_is_ascii_alphabetic<G>(c: &char) -> bool {
    (*c).is_ascii_alphabetic()
}

fn __exr_charfn_is_ascii_alphanumeric<G>(c: &char) -> bool {
    (*c).is_ascii_alphanumeric()
}

fn __exr_charfn_is_ascii_uppercase<G>(c: &char) -> bool {
    (*c).is_ascii_uppercase()
}

fn __exr_charfn_is_ascii_lowercase<G>(c: &char) -> bool {
    (*c).is_ascii_lowercase()
}

fn __exr_charfn_is_ascii_whitespace<G>(c: &char) -> bool {
    (*c).is_ascii_whitespace()
}

fn __exr_charfn_is_ascii_punctuation<G>(c: &char) -> bool {
    (*c).is_ascii_punctuation()
}

fn __exr_charfn_is_ascii_hexdigit<G>(c: &char) -> bool {
    (*c).is_ascii_hexdigit()
}

fn __exr_charfn_is_ascii<G>(c: &char) -> bool {
    (*c).is_ascii()
}

fn __exr_charfn_to_ascii_uppercase<G>(c: &char) -> char {
    (*c).to_ascii_uppercase()
}

fn __exr_charfn_to_ascii_lowercase<G>(c: &char) -> char {
    (*c).to_ascii_lowercase()
}

fn __exr_char_is_alphabetic<G>(c: char) -> bool {
    let u = c as u32;
    if u < 0x80 {
        return (u >= 65 && u <= 90) || (u >= 97 && u <= 122);
    }
    (u >= 0xC0 && u <= 0x2FF && u != 0xD7 && u != 0xF7)
        || u == 0xAA
        || u == 0xB5
        || u == 0xBA
        || (u >= 0x370 && u <= 0x52F && u != 0x375 && u != 0x37E && u != 0x384 && u != 0x385 && u != 0x387)
        || (u >= 0x3041 && u <= 0x30FF && u != 0x30A0 && u != 0x30FB)
        || (u >= 0x4E00 && u <= 0x9FFF)
        || (u >= 0xAC00 && u <= 0xD7A3)
}

fn __exr_char_is_numeric<G>(c: char) -> bool {
    let u = c as u32;
    (u >= 48 && u <= 57) || u == 0xB2 || u == 0xB3 || u == 0xB9 || (u >= 0xBC && u <= 0xBE)
}

fn __exr_char_is_alphanumeric<G>(c: char) -> bool {
    __exr_char_is_alphabetic::<()>(c) || __exr_char_is_numeric::<()>(c)
}

fn __exr_char_is_whitespace<G>(c: char) -> bool {
    let u = c as u32;
    (u >= 9 && u <= 13) || u == 32 || u == 0x85 || u == 0xA0 || u == 0x1680 || (u >= 0x2000 && u <= 0x200A)
        || u == 0x2028 || u == 0x2029 || u == 0x202F || u == 0x205F || u == 0x3000
}

fn __exr_char_is_control<G>(c: char) -> bool {
    let u = c as u32;
    u < 32 || (u >= 0x7F && u < 0xA0)
}

fn __exr_char_is_uppercase<G>(c: char) -> bool {
    let u = c as u32;
    (u >= 65 && u <= 90) || (u >= 0xC0 && u <= 0xDE && u != 0xD7) || (u >= 0x391 && u <= 0x3A9) || (u >= 0x410 && u <= 0x42F)
}

fn __exr_char_is_lowercase<G>(c: char) -> bool {
    let u = c as u32;
    (u >= 97 && u <= 122) || u == 0xAA || u == 0xB5 || u == 0xBA || (u >= 0xDF && u <= 0xFF && u != 0xF7)
        || (u >= 0x3B1 && u <= 0x3C9) || (u >= 0x430 && u <= 0x44F)
}

fn __exr_char_to_digit<G>(c: char, radix: u32) -> Option<u32> {
    let u = c as u32;
    let d = if u >= 48 && u <= 57 {
        u - 48
    } else if u >= 97 && u <= 122 {
        u - 97 + 10
    } else if u >= 65 && u <= 90 {
        u - 65 + 10
    } else {
        return None;
    };
    if d < radix { Some(d) } else { None }
}

fn __exr_char_is_digit<G>(c: char, radix: u32) -> bool {
    __exr_char_to_digit::<()>(c, radix).is_some()
}

fn __exr_char_len_utf8<G>(c: char) -> usize {
    let u = c as u32;
    if u < 0x80 {
        1
    } else if u < 0x800 {
        2
    } else if u < 0x10000 {
        3
    } else {
        4
    }
}

// 大文字 / 小文字の 1 文字 (ASCII・Latin-1・ギリシャ文字・キリル文字)
fn __exr_char_upper1<G>(c: char) -> char {
    let u = c as u32;
    let r = if (u >= 97 && u <= 122) || (u >= 0xE0 && u <= 0xFE && u != 0xF7) || (u >= 0x3B1 && u <= 0x3C9 && u != 0x3C2)
        || (u >= 0x430 && u <= 0x44F)
    {
        u - 32
    } else if u == 0x3C2 {
        0x3A3
    } else if u >= 0x450 && u <= 0x45F {
        u - 80
    } else if u == 0xFF {
        0x178
    } else if u == 0xB5 {
        0x39C
    } else {
        u
    };
    unsafe { __exr_char_from_u32(r) }
}

fn __exr_char_lower1<G>(c: char) -> char {
    let u = c as u32;
    let r = if (u >= 65 && u <= 90) || (u >= 0xC0 && u <= 0xDE && u != 0xD7) || (u >= 0x391 && u <= 0x3A9 && u != 0x3A2)
        || (u >= 0x410 && u <= 0x42F)
    {
        u + 32
    } else if u >= 0x400 && u <= 0x40F {
        u + 80
    } else if u == 0x178 {
        0xFF
    } else {
        u
    };
    unsafe { __exr_char_from_u32(r) }
}

// `c.to_uppercase()` / `to_lowercase()`: 1 文字のイテレータ (`.next()` / `collect` / `{}`)
pub struct ToCase {
    c: char,
    done: bool,
}

impl Iterator for ToCase {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        if self.done {
            None
        } else {
            self.done = true;
            Some(self.c)
        }
    }
}

impl Display for ToCase {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        let mut s = String::new();
        s.push(self.c);
        f.pad(s.as_str())
    }
}

fn __exr_char_to_uppercase<G>(c: char) -> ToCase {
    ToCase { c: __exr_char_upper1::<()>(c), done: false }
}

fn __exr_char_to_lowercase<G>(c: char) -> ToCase {
    ToCase { c: __exr_char_lower1::<()>(c), done: false }
}

// `c.escape_unicode()` / `c.escape_default()`: the escape's characters (`.next()` / `collect` / `{}`)
pub struct CharEscape {
    buf: [char; 10],
    n: usize,
    i: usize,
}

impl Iterator for CharEscape {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        if self.i < self.n {
            let c = self.buf[self.i];
            self.i += 1;
            Some(c)
        } else {
            None
        }
    }
}

impl Display for CharEscape {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        let mut s = String::new();
        let mut k = self.i;
        while k < self.n {
            s.push(self.buf[k]);
            k += 1;
        }
        // (the whole escape, as std's: no width or precision applies)
        f.write_str(s.as_str())
    }
}

fn __exr_char_esc_of<G>(s: &str) -> CharEscape {
    let mut e = CharEscape { buf: ['\0'; 10], n: 0, i: 0 };
    for c in s.chars() {
        e.buf[e.n] = c;
        e.n += 1;
    }
    e
}

fn __exr_char_escape_unicode<G>(c: char) -> CharEscape {
    let mut s = String::new();
    __exr_push_unicode_escape::<()>(&mut s, c as u32);
    __exr_char_esc_of::<()>(s.as_str())
}

fn __exr_char_escape_default<G>(c: char) -> CharEscape {
    let mut s = String::new();
    let v = c as u32;
    if c == '\t' {
        s.push_str("\\t");
    } else if c == '\r' {
        s.push_str("\\r");
    } else if c == '\n' {
        s.push_str("\\n");
    } else if c == '\'' || c == '"' || c == '\\' {
        s.push('\\');
        s.push(c);
    } else if v >= 0x20 && v <= 0x7e {
        s.push(c);
    } else {
        __exr_push_unicode_escape::<()>(&mut s, v);
    }
    __exr_char_esc_of::<()>(s.as_str())
}

// `char::from_digit(d, 10)` / `char::from_u32(x)` / `char::from(b)`
fn __exr_char_from_digit<G>(d: u32, radix: u32) -> Option<char> {
    if d >= radix || radix > 36 {
        return None;
    }
    let u = if d < 10 { 48 + d } else { 97 + d - 10 };
    Some(unsafe { __exr_char_from_u32(u) })
}

fn __exr_char_from_u8<G>(b: u8) -> char {
    unsafe { __exr_char_from_u32(b as u32) }
}

// (`Vec::from_raw_parts(ptr, len, cap)`: a buffer of `cap` elements the allocator gave, its first `len` initialized,
// that the Vec owns. A dangling pointer, `NonNull::dangling()` (the type's alignment as an address, also one of 4096 or
// more; or another address below the first page, which no allocation has), is no buffer: the Vec's empty one, a null
// pointer that drop does not free. A buffer this prelude's Vec allocated stays the Vec's, also of zero-sized elements
// (reserve gives them one byte))
unsafe fn __exr_vec_from_raw_parts<T>(ptr: *mut T, len: usize, cap: usize) -> Vec<T> {
    // (cap 0 of a sized element is no buffer whatever the pointer, any aligned one: this prelude's Vec of cap 0 has none)
    if (cap == 0 && core::mem::size_of::<T>() != 0) || (ptr as usize) < 4096 || (ptr as usize) == core::mem::align_of::<T>() {
        let c = if core::mem::size_of::<T>() == 0 { len } else { 0 };
        return Vec { ptr: core::ptr::null_mut(), cap: c, len: len };
    }
    Vec { ptr: ptr, cap: cap, len: len }
}

// (`String::from_utf8_unchecked(bytes)`: bytes the caller knows are UTF-8)
unsafe fn __exr_string_from_utf8_unchecked<G>(v: Vec<u8>) -> String {
    String { vec: v }
}

unsafe fn __exr_char_from_u32_unchecked<G>(u: u32) -> char {
    unsafe { __exr_char_from_u32(u) }
}

fn __exr_char_from_u32_checked<G>(u: u32) -> Option<char> {
    if u > 0x10FFFF || (u >= 0xD800 && u <= 0xDFFF) {
        None
    } else {
        Some(unsafe { __exr_char_from_u32(u) })
    }
}

fn __exr_is_space<G>(b: u8) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12
}

fn __exr_str_split<G>(s: &str, c: char) -> Split {
    Split { p: s.as_ptr(), len: s.len(), i: 0, sep: c as u8, mode: 0, done: false, bk: false }
}

// `s.split(|c| ..)`: 条件に合う文字で区切る
pub struct SplitFn<F> {
    p: *const u8,
    len: usize,
    i: usize,
    f: F,
    done: bool,
}

impl<F: FnMut(char) -> bool> Iterator for SplitFn<F> {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.done {
            return None;
        }
        let rest = __exr_sub::<()>(unsafe { self.p.add(self.i) }, self.len - self.i);
        let mut k = 0;
        for c in __exr_str_chars::<()>(rest) {
            let n = __exr_char_len_utf8::<()>(c);
            if (self.f)(c) {
                self.i += k + n;
                return Some(__exr_sub::<()>(rest.as_ptr(), k));
            }
            k += n;
        }
        self.done = true;
        Some(rest)
    }
}

fn __exr_str_split_fn<G, F: FnMut(char) -> bool>(s: &str, f: F) -> SplitFn<F> {
    SplitFn { p: s.as_ptr(), len: s.len(), i: 0, f: f, done: false }
}

// (a byte of split_whitespace's spaces; with ascii (split_ascii_whitespace's) not the vertical tab)
fn __exr_split_space<G>(b: u8, ascii: u8) -> bool {
    __exr_is_space::<()>(b) && (ascii == 0 || b != 11)
}

fn __exr_str_split_ascii_whitespace<G>(s: &str) -> Split {
    Split { p: s.as_ptr(), len: s.len(), i: 0, sep: 1, mode: 1, done: false, bk: false }
}

fn __exr_str_split_ws<G>(s: &str) -> Split {
    Split { p: s.as_ptr(), len: s.len(), i: 0, sep: 0, mode: 1, done: false, bk: false }
}

fn __exr_str_lines<G>(s: &str) -> Split {
    Split { p: s.as_ptr(), len: s.len(), i: 0, sep: 10, mode: 2, done: false, bk: false }
}

fn __exr_str_trim<G>(s: &str) -> &str {
    let b = s.as_bytes();
    let mut a = 0;
    let mut e = b.len();
    while a < e && __exr_is_space::<()>(b[a]) {
        a += 1;
    }
    while e > a && __exr_is_space::<()>(b[e - 1]) {
        e -= 1;
    }
    __exr_sub::<()>(unsafe { s.as_ptr().add(a) }, e - a)
}

unsafe extern "C" {
    #[link_name = "memmem"]
    fn __exr_memmem(h: *const u8, hl: usize, n: *const u8, nl: usize) -> *const u8;
}

// (libc の memmem: 長い文字列を何度も探すプログラム (zustc 自身) で、1 byte ずつ比べるより何倍も速い)
fn __exr_str_find<G>(s: &str, t: &str) -> Option<usize> {
    let a = s.as_bytes();
    let b = t.as_bytes();
    if b.len() > a.len() {
        return None;
    }
    if b.is_empty() {
        return Some(0);
    }
    let p = unsafe { __exr_memmem(a.as_ptr(), a.len(), b.as_ptr(), b.len()) };
    if p.is_null() {
        None
    } else {
        Some(p as usize - a.as_ptr() as usize)
    }
}

fn __exr_str_starts_with<G>(s: &str, t: &str) -> bool {
    let a = s.as_bytes();
    let b = t.as_bytes();
    if b.len() > a.len() {
        return false;
    }
    let mut j = 0;
    while j < b.len() {
        if a[j] != b[j] {
            return false;
        }
        j += 1;
    }
    true
}

// char の UTF-8 を p に書いて長さを返す (`s.contains('x')` の char を &str にする)
fn __exr_char_utf8<G>(c: char, p: *mut u8) -> usize {
    let c = c as u32;
    unsafe {
        if c < 0x80 {
            *p = c as u8;
            1
        } else if c < 0x800 {
            *p = 0xC0 | (c >> 6) as u8;
            *p.add(1) = 0x80 | (c & 0x3F) as u8;
            2
        } else if c < 0x10000 {
            *p = 0xE0 | (c >> 12) as u8;
            *p.add(1) = 0x80 | ((c >> 6) & 0x3F) as u8;
            *p.add(2) = 0x80 | (c & 0x3F) as u8;
            3
        } else {
            *p = 0xF0 | (c >> 18) as u8;
            *p.add(1) = 0x80 | ((c >> 12) & 0x3F) as u8;
            *p.add(2) = 0x80 | ((c >> 6) & 0x3F) as u8;
            *p.add(3) = 0x80 | (c & 0x3F) as u8;
            4
        }
    }
}

fn __exr_str_ends_with<G>(s: &str, t: &str) -> bool {
    let a = s.as_bytes();
    let b = t.as_bytes();
    if b.len() > a.len() {
        return false;
    }
    let off = a.len() - b.len();
    let mut j = 0;
    while j < b.len() {
        if a[off + j] != b[j] {
            return false;
        }
        j += 1;
    }
    true
}

// --- std::hash (Hash / Hasher / DefaultHasher)。DefaultHasher は std と同じ SipHash-1-3 (鍵 0) で、値も std と一致する ---

pub trait Hasher {
    fn finish(&self) -> u64;
    fn write(&mut self, bytes: &[u8]);
    fn write_u8(&mut self, i: u8) {
        self.write(unsafe { core::slice::from_raw_parts(&i as *const u8, 1) });
    }
    fn write_u16(&mut self, i: u16) {
        self.write(unsafe { core::slice::from_raw_parts(&i as *const u16 as *const u8, 2) });
    }
    fn write_u32(&mut self, i: u32) {
        self.write(unsafe { core::slice::from_raw_parts(&i as *const u32 as *const u8, 4) });
    }
    fn write_u64(&mut self, i: u64) {
        self.write(unsafe { core::slice::from_raw_parts(&i as *const u64 as *const u8, 8) });
    }
    fn write_u128(&mut self, i: u128) {
        self.write(unsafe { core::slice::from_raw_parts(&i as *const u128 as *const u8, 16) });
    }
    fn write_usize(&mut self, i: usize) {
        self.write(unsafe { core::slice::from_raw_parts(&i as *const usize as *const u8, 8) });
    }
    fn write_i8(&mut self, i: i8) {
        self.write_u8(i as u8);
    }
    fn write_i16(&mut self, i: i16) {
        self.write_u16(i as u16);
    }
    fn write_i32(&mut self, i: i32) {
        self.write_u32(i as u32);
    }
    fn write_i64(&mut self, i: i64) {
        self.write_u64(i as u64);
    }
    fn write_i128(&mut self, i: i128) {
        self.write_u128(i as u128);
    }
    fn write_isize(&mut self, i: isize) {
        self.write_usize(i as usize);
    }
    fn write_str(&mut self, s: &str) {
        self.write(s.as_bytes());
        self.write_u8(0xff);
    }
    fn write_length_prefix(&mut self, len: usize) {
        self.write_usize(len);
    }
}

pub trait Hash {
    fn hash<H: Hasher>(&self, state: &mut H);
}

// (HashMap の第 3 引数としては使わない: 組み込みのハッシュで引く)
pub trait BuildHasher {
    type Hasher;
    fn build_hasher(&self) -> Self::Hasher;
    fn hash_one<T: Hash>(&self, x: T) -> u64 {
        let mut h = self.build_hasher();
        x.hash(&mut h);
        h.finish()
    }
}

impl Hash for u8 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_u8(*self);
    }
}
impl Hash for u16 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_u16(*self);
    }
}
impl Hash for u32 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_u32(*self);
    }
}
impl Hash for u64 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_u64(*self);
    }
}
impl Hash for u128 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_u128(*self);
    }
}
impl Hash for usize {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_usize(*self);
    }
}
impl Hash for i8 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_i8(*self);
    }
}
impl Hash for i16 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_i16(*self);
    }
}
impl Hash for i32 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_i32(*self);
    }
}
impl Hash for i64 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_i64(*self);
    }
}
impl Hash for i128 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_i128(*self);
    }
}
impl Hash for isize {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_isize(*self);
    }
}
impl Hash for bool {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_u8(*self as u8);
    }
}
impl Hash for char {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_u32(*self as u32);
    }
}
impl Hash for str {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_str(self);
    }
}
impl Hash for String {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_str(self.as_str());
    }
}
impl<T: Hash> Hash for [T] {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_length_prefix(self.len());
        // (std の hash_slice と同じく、整数の列はまとめて write する: FxHasher などで値が std と一致する)
        if __exr_int_kind::<T>() != 0 {
            state.write(unsafe { core::slice::from_raw_parts(self.as_ptr() as *const u8, self.len() * core::mem::size_of::<T>()) });
            return;
        }
        let mut i = 0;
        while i < self.len() {
            self[i].hash(state);
            i += 1;
        }
    }
}
impl<T: Hash> Hash for Vec<T> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.as_slice().hash(state);
    }
}

pub struct DefaultHasher {
    v0: u64,
    v1: u64,
    v2: u64,
    v3: u64,
    tail: u64,
    ntail: usize,
    length: usize,
}

fn __exr_sip_round<G>(v: &mut [u64; 4]) {
    v[0] = v[0].wrapping_add(v[1]);
    v[1] = v[1].rotate_left(13);
    v[1] ^= v[0];
    v[0] = v[0].rotate_left(32);
    v[2] = v[2].wrapping_add(v[3]);
    v[3] = v[3].rotate_left(16);
    v[3] ^= v[2];
    v[0] = v[0].wrapping_add(v[3]);
    v[3] = v[3].rotate_left(21);
    v[3] ^= v[0];
    v[2] = v[2].wrapping_add(v[1]);
    v[1] = v[1].rotate_left(17);
    v[1] ^= v[2];
    v[2] = v[2].rotate_left(32);
}

impl DefaultHasher {
    pub fn new() -> DefaultHasher {
        DefaultHasher {
            v0: 0x736f6d6570736575,
            v1: 0x646f72616e646f6d,
            v2: 0x6c7967656e657261,
            v3: 0x7465646279746573,
            tail: 0,
            ntail: 0,
            length: 0,
        }
    }
    pub fn default() -> DefaultHasher {
        DefaultHasher::new()
    }
    fn __block(&mut self, m: u64) {
        let mut v = [self.v0, self.v1, self.v2, self.v3];
        v[3] ^= m;
        __exr_sip_round::<()>(&mut v);
        v[0] ^= m;
        self.v0 = v[0];
        self.v1 = v[1];
        self.v2 = v[2];
        self.v3 = v[3];
    }
}

impl Hasher for DefaultHasher {
    fn write(&mut self, msg: &[u8]) {
        let len = msg.len();
        self.length += len;
        let mut i = 0;
        // (前回の端数を 8 byte まで埋める)
        if self.ntail != 0 {
            while i < len && self.ntail < 8 {
                self.tail |= (msg[i] as u64) << (8 * self.ntail);
                self.ntail += 1;
                i += 1;
            }
            if self.ntail < 8 {
                return;
            }
            let t = self.tail;
            self.__block(t);
            self.tail = 0;
            self.ntail = 0;
        }
        while i + 8 <= len {
            let mut m: u64 = 0;
            let mut k = 0;
            while k < 8 {
                m |= (msg[i + k] as u64) << (8 * k);
                k += 1;
            }
            self.__block(m);
            i += 8;
        }
        while i < len {
            self.tail |= (msg[i] as u64) << (8 * self.ntail);
            self.ntail += 1;
            i += 1;
        }
    }
    fn finish(&self) -> u64 {
        let b: u64 = ((self.length as u64 & 0xff) << 56) | self.tail;
        let mut v = [self.v0, self.v1, self.v2, self.v3];
        v[3] ^= b;
        __exr_sip_round::<()>(&mut v);
        v[0] ^= b;
        v[2] ^= 0xff;
        __exr_sip_round::<()>(&mut v);
        __exr_sip_round::<()>(&mut v);
        __exr_sip_round::<()>(&mut v);
        v[0] ^ v[1] ^ v[2] ^ v[3]
    }
}

// bool::then / then_some
pub trait __BoolThen {
    fn then_some<T>(self, t: T) -> Option<T>;
    fn then<T, F: FnOnce() -> T>(self, f: F) -> Option<T>;
}
impl __BoolThen for bool {
    fn then_some<T>(self, t: T) -> Option<T> {
        if self { Some(t) } else { None }
    }
    fn then<T, F: FnOnce() -> T>(self, f: F) -> Option<T> {
        if self { Some(f()) } else { None }
    }
}

// --- std::fs::File, OpenOptions, Metadata (libc's open / read / write / lseek / fstat / close), std::os::unix's fd
// traits. A File owns its fd and closes it when dropped; `into_raw_fd` gives it away without closing ---

unsafe extern "C" {
    #[link_name = "fstat"]
    fn __exr_fstat(fd: i32, buf: *mut u8) -> i32;
}

unsafe extern "C" {
    #[link_name = "lseek"]
    fn __exr_lseek(fd: i32, off: i64, whence: i32) -> i64;
}

unsafe extern "C" {
    #[link_name = "fsync"]
    fn __exr_fsync(fd: i32) -> i32;
}

unsafe extern "C" {
    #[link_name = "ftruncate"]
    fn __exr_ftruncate(fd: i32, len: i64) -> i32;
}

unsafe extern "C" {
    #[link_name = "fcntl"]
    fn __exr_fcntl(fd: i32, cmd: i32, arg: i32) -> i32;
}

pub type RawFd = i32;

pub trait AsRawFd {
    fn as_raw_fd(&self) -> RawFd;
}
pub trait FromRawFd {
    unsafe fn from_raw_fd(fd: RawFd) -> Self;
}
pub trait IntoRawFd {
    fn into_raw_fd(self) -> RawFd;
}

pub struct File {
    __f_fd: i32,
}

// (open(2) of a path with the flags and the mode a new file gets, retried when a signal interrupts it)
fn __exr_file_open<G>(p: &[u8], flags: i32, mode: i32) -> Result<File, IoError> {
    // (a NUL inside the path would end it there: std's InvalidInput)
    if __exr_has_nul::<()>(p) {
        return Err(IoError { code: -8, os: false });
    }
    let c = __exr_c_path::<()>(p);
    loop {
        // (O_CLOEXEC, as std's)
        let fd = unsafe { __exr_open(c.as_ptr(), flags | 0x80000, mode) };
        if fd >= 0 {
            return Ok(File { __f_fd: fd });
        }
        let e = IoError::last_os_error();
        if e.code != 4 {
            return Err(e);
        }
    }
}

fn __exr_fd_metadata<G>(fd: i32) -> Result<Metadata, IoError> {
    let mut m = Metadata { __md: [0u64; 18] };
    if unsafe { __exr_fstat(fd, m.__md.as_mut_ptr() as *mut u8) } != 0 {
        return Err(IoError::last_os_error());
    }
    Ok(m)
}

impl File {
    pub fn open<P>(path: P) -> Result<File, IoError> {
        __exr_file_open::<()>(path.__as_bytes(), 0, 0o666)
    }
    // (O_WRONLY | O_CREAT | O_TRUNC)
    pub fn create<P>(path: P) -> Result<File, IoError> {
        __exr_file_open::<()>(path.__as_bytes(), 0x241, 0o666)
    }
    // (O_RDWR | O_CREAT | O_EXCL)
    pub fn create_new<P>(path: P) -> Result<File, IoError> {
        __exr_file_open::<()>(path.__as_bytes(), 0xc2, 0o666)
    }
    pub fn options() -> OpenOptions {
        OpenOptions::new()
    }
    pub fn metadata(&self) -> Result<Metadata, IoError> {
        __exr_fd_metadata::<()>(self.__f_fd)
    }
    pub fn sync_all(&self) -> Result<(), IoError> {
        if unsafe { __exr_fsync(self.__f_fd) } != 0 {
            return Err(IoError::last_os_error());
        }
        Ok(())
    }
    pub fn sync_data(&self) -> Result<(), IoError> {
        self.sync_all()
    }
    pub fn set_len(&self, size: u64) -> Result<(), IoError> {
        if unsafe { __exr_ftruncate(self.__f_fd, size as i64) } != 0 {
            return Err(IoError::last_os_error());
        }
        Ok(())
    }
    pub fn try_clone(&self) -> Result<File, IoError> {
        // (F_DUPFD_CLOEXEC, as std's: the copy is not left to a child process either)
        let fd = unsafe { __exr_fcntl(self.__f_fd, 1030, 3) };
        if fd < 0 {
            return Err(IoError::last_os_error());
        }
        Ok(File { __f_fd: fd })
    }
}

impl Read for File {
    fn read(&mut self, buf: &mut [u8]) -> Result<usize, IoError> {
        loop {
            let n = unsafe { __exr_read(self.__f_fd, buf.as_mut_ptr(), buf.len()) };
            if n >= 0 {
                return Ok(n as usize);
            }
            let e = IoError::last_os_error();
            if e.code != 4 {
                return Err(e);
            }
        }
    }
}

impl Write for File {
    fn write(&mut self, buf: &[u8]) -> Result<usize, IoError> {
        loop {
            let n = unsafe { __exr_write(self.__f_fd, buf.as_ptr(), buf.len()) };
            if n >= 0 {
                return Ok(n as usize);
            }
            let e = IoError::last_os_error();
            if e.code != 4 {
                return Err(e);
            }
        }
    }
}

impl Seek for File {
    fn seek(&mut self, pos: SeekFrom) -> Result<u64, IoError> {
        let (off, whence) = match pos {
            SeekFrom::Start(n) => (n as i64, 0),
            SeekFrom::Current(n) => (n, 1),
            SeekFrom::End(n) => (n, 2),
        };
        let r = unsafe { __exr_lseek(self.__f_fd, off, whence) };
        if r < 0 {
            return Err(IoError::last_os_error());
        }
        Ok(r as u64)
    }
}

impl Drop for File {
    fn drop(&mut self) {
        unsafe {
            __exr_close(self.__f_fd);
        }
    }
}

// (std's names the path and the access mode too, which it reads back from the system)
impl Debug for File {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.debug_struct("\x46ile").field("fd", &self.__f_fd).finish()
    }
}

impl AsRawFd for File {
    fn as_raw_fd(&self) -> RawFd {
        self.__f_fd
    }
}
impl FromRawFd for File {
    unsafe fn from_raw_fd(fd: RawFd) -> File {
        File { __f_fd: fd }
    }
}
impl IntoRawFd for File {
    fn into_raw_fd(self) -> RawFd {
        let fd = self.__f_fd;
        __core_forget(self);
        fd
    }
}

#[derive(Clone, Debug)]
pub struct OpenOptions {
    __o_read: bool,
    __o_write: bool,
    __o_append: bool,
    __o_truncate: bool,
    __o_create: bool,
    __o_create_new: bool,
    __o_mode: u32,
    __o_flags: i32,
}

impl OpenOptions {
    pub fn new() -> OpenOptions {
        OpenOptions {
            __o_read: false,
            __o_write: false,
            __o_append: false,
            __o_truncate: false,
            __o_create: false,
            __o_create_new: false,
            __o_mode: 0o666,
            __o_flags: 0,
        }
    }
    pub fn read(&mut self, read: bool) -> &mut OpenOptions {
        self.__o_read = read;
        self
    }
    pub fn write(&mut self, write: bool) -> &mut OpenOptions {
        self.__o_write = write;
        self
    }
    pub fn append(&mut self, append: bool) -> &mut OpenOptions {
        self.__o_append = append;
        self
    }
    pub fn truncate(&mut self, truncate: bool) -> &mut OpenOptions {
        self.__o_truncate = truncate;
        self
    }
    pub fn create(&mut self, create: bool) -> &mut OpenOptions {
        self.__o_create = create;
        self
    }
    pub fn create_new(&mut self, create_new: bool) -> &mut OpenOptions {
        self.__o_create_new = create_new;
        self
    }
    // (std's checks, in its order: an access mode (-5), write access to create or truncate (-6), no truncating with
    // append (-7); then O_CREAT / O_TRUNC, or O_CREAT | O_EXCL. A custom flag's access bits are dropped)
    pub fn open<P>(&self, path: P) -> Result<File, IoError> {
        let creates = self.__o_create || self.__o_truncate || self.__o_create_new;
        let mut fl = if self.__o_append {
            (if self.__o_read { 2 } else { 1 }) | 0x400
        } else if self.__o_write {
            if self.__o_read { 2 } else { 1 }
        } else if self.__o_read {
            0
        } else {
            return Err(IoError { code: if creates { -6 } else { -5 }, os: false });
        };
        if !self.__o_write && !self.__o_append && creates {
            return Err(IoError { code: -6, os: false });
        }
        if self.__o_append && self.__o_truncate && !self.__o_create_new {
            return Err(IoError { code: -7, os: false });
        }
        if self.__o_create_new {
            fl |= 0xc0;
        } else {
            if self.__o_create {
                fl |= 0x40;
            }
            if self.__o_truncate {
                fl |= 0x200;
            }
        }
        __exr_file_open::<()>(path.__as_bytes(), fl | self.__o_flags & !3, self.__o_mode as i32)
    }
}

pub trait OpenOptionsExt {
    fn mode(&mut self, mode: u32) -> &mut Self;
    fn custom_flags(&mut self, flags: i32) -> &mut Self;
}
impl OpenOptionsExt for OpenOptions {
    fn mode(&mut self, mode: u32) -> &mut OpenOptions {
        self.__o_mode = mode;
        self
    }
    fn custom_flags(&mut self, flags: i32) -> &mut OpenOptions {
        self.__o_flags = flags;
        self
    }
}

// (struct stat of x86-64 Linux, 144 bytes, as words: st_dev 0, st_ino 1, st_nlink 2, st_mode | st_uid << 32 3,
// st_gid 4, st_rdev 5, st_size 6, st_blksize 7, st_blocks 8, then the times' seconds and nanoseconds 9..15)
#[derive(Clone)]
pub struct Metadata {
    __md: [u64; 18],
}

#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct FileType {
    __ft_mode: u32,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Permissions {
    __pm_mode: u32,
}

impl Metadata {
    fn __mode(&self) -> u32 {
        self.__md[3] as u32
    }
    pub fn len(&self) -> u64 {
        self.__md[6]
    }
    pub fn file_type(&self) -> FileType {
        FileType { __ft_mode: self.__mode() & 0o170000 }
    }
    pub fn is_file(&self) -> bool {
        self.file_type().is_file()
    }
    pub fn is_dir(&self) -> bool {
        self.file_type().is_dir()
    }
    pub fn is_symlink(&self) -> bool {
        self.file_type().is_symlink()
    }
    pub fn permissions(&self) -> Permissions {
        Permissions { __pm_mode: self.__mode() }
    }
}

impl Debug for Metadata {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.debug_struct("\x4detadata").field("file_type", &self.file_type()).field("permissions", &self.permissions()).field("len", &self.len()).finish_non_exhaustive()
    }
}

impl FileType {
    pub fn is_file(&self) -> bool {
        self.__ft_mode & 0o170000 == 0o100000
    }
    pub fn is_dir(&self) -> bool {
        self.__ft_mode & 0o170000 == 0o040000
    }
    pub fn is_symlink(&self) -> bool {
        self.__ft_mode & 0o170000 == 0o120000
    }
}

impl Debug for FileType {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.debug_struct("\x46ileType").field("is_file", &self.is_file()).field("is_dir", &self.is_dir()).field("is_symlink", &self.is_symlink()).finish_non_exhaustive()
    }
}

impl Permissions {
    pub fn readonly(&self) -> bool {
        self.__pm_mode & 0o222 == 0
    }
    pub fn set_readonly(&mut self, readonly: bool) {
        if readonly {
            self.__pm_mode &= !0o222;
        } else {
            self.__pm_mode |= 0o222;
        }
    }
}

impl Debug for Permissions {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.debug_struct("\x50ermissions").field("mode", &self.__pm_mode).finish()
    }
}

pub trait MetadataExt {
    fn dev(&self) -> u64;
    fn ino(&self) -> u64;
    fn mode(&self) -> u32;
    fn nlink(&self) -> u64;
    fn uid(&self) -> u32;
    fn gid(&self) -> u32;
    fn rdev(&self) -> u64;
    fn size(&self) -> u64;
    fn blksize(&self) -> u64;
    fn blocks(&self) -> u64;
}
impl MetadataExt for Metadata {
    fn dev(&self) -> u64 {
        self.__md[0]
    }
    fn ino(&self) -> u64 {
        self.__md[1]
    }
    fn mode(&self) -> u32 {
        self.__md[3] as u32
    }
    fn nlink(&self) -> u64 {
        self.__md[2]
    }
    fn uid(&self) -> u32 {
        (self.__md[3] >> 32) as u32
    }
    fn gid(&self) -> u32 {
        self.__md[4] as u32
    }
    fn rdev(&self) -> u64 {
        self.__md[5]
    }
    fn size(&self) -> u64 {
        self.__md[6]
    }
    fn blksize(&self) -> u64 {
        self.__md[7]
    }
    fn blocks(&self) -> u64 {
        self.__md[8]
    }
}

pub trait PermissionsExt {
    fn mode(&self) -> u32;
    fn set_mode(&mut self, mode: u32);
    fn from_mode(mode: u32) -> Self;
}
impl PermissionsExt for Permissions {
    fn mode(&self) -> u32 {
        self.__pm_mode
    }
    fn set_mode(&mut self, mode: u32) {
        self.__pm_mode = mode;
    }
    fn from_mode(mode: u32) -> Permissions {
        Permissions { __pm_mode: mode }
    }
}

unsafe extern "C" {
    #[link_name = "chmod"]
    fn __exr_chmod(path: *const u8, mode: u32) -> i32;
}

// `fs::set_permissions(p, perm)`: chmod(2)
pub fn __core_set_permissions<P>(path: P, perm: Permissions) -> Result<(), IoError> {
    if __exr_has_nul::<()>(path.__as_bytes()) {
        return Err(IoError { code: -8, os: false });
    }
    let c = __exr_c_path::<()>(path.__as_bytes());
    if unsafe { __exr_chmod(c.as_ptr(), perm.__pm_mode) } != 0 {
        return Err(IoError::last_os_error());
    }
    Ok(())
}

// `fs::metadata(p)`: stat(2), which follows a symlink
pub fn __core_metadata<P>(path: P) -> Result<Metadata, IoError> {
    if __exr_has_nul::<()>(path.__as_bytes()) {
        return Err(IoError { code: -8, os: false });
    }
    let c = __exr_c_path::<()>(path.__as_bytes());
    let mut m = Metadata { __md: [0u64; 18] };
    if unsafe { __exr_stat(c.as_ptr(), m.__md.as_mut_ptr() as *mut u8) } != 0 {
        return Err(IoError::last_os_error());
    }
    Ok(m)
}

// (Read's read_to_end / read_to_string, here at the end, where a program that uses none of them gets no lines of theirs)
fn __exr_read_to_end<R: Read + ?Sized>(r: &mut R, buf: &mut Vec<u8>) -> Result<usize, IoError> {
    let start = buf.len();
    let mut chunk = [0u8; 4096];
    loop {
        // (Interrupted: read again, as std's)
        let n = match r.read(&mut chunk) {
            Ok(n) => n,
            Err(e) => {
                if e.os && e.code == 4 {
                    continue;
                }
                return Err(e);
            }
        };
        if n == 0 {
            return Ok(buf.len() - start);
        }
        buf.extend_from_slice(&chunk[..n]);
    }
}

// (as std's: the bytes read, before an error too, are appended when they are UTF-8; buf is left as it was when they
// are not, with read_to_end's error if it had one)
fn __exr_read_to_string<R: Read + ?Sized>(r: &mut R, buf: &mut String) -> Result<usize, IoError> {
    let mut v: Vec<u8> = Vec::new();
    let ret = __exr_read_to_end(r, &mut v);
    match String::from_utf8(v) {
        Ok(t) => {
            buf.push_str(&t);
            ret
        }
        Err(_) => match ret {
            Err(e) => Err(e),
            Ok(_) => Err(IoError { code: -1, os: false }),
        },
    }
}

// `std::num::FpCategory` and `x.classify()` of an f32 / f64, which codegen calls with the value's bits (widened)
#[derive(Clone, Copy, PartialEq, Eq, Debug, Hash)]
pub enum FpCategory {
    Nan,
    Infinite,
    Zero,
    Subnormal,
    Normal,
}

fn __exr_fp_classify<G>(bits: u64, f32: bool) -> FpCategory {
    let (exp, man, max) = if f32 { ((bits >> 23) & 0xff, bits & 0x7f_ffff, 0xff) } else { ((bits >> 52) & 0x7ff, bits & 0xf_ffff_ffff_ffff, 0x7ff) };
    if exp == max {
        if man == 0 { FpCategory::Infinite } else { FpCategory::Nan }
    } else if exp == 0 {
        if man == 0 { FpCategory::Zero } else { FpCategory::Subnormal }
    } else {
        FpCategory::Normal
    }
}

// `fmt::Binary` / `Octal` / `LowerHex` / `UpperHex` / `LowerExp` / `UpperExp`: what `{:b}` / `{:o}` / `{:x}` / `{:X}` /
// `{:e}` / `{:E}` of a type of the program's call, and std's impls for the numbers, which write as zustc's own `{:x}`
// of a number does (`fmt::LowerHex::fmt(&self.0, f)` in a program's impl)
pub trait Binary {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError>;
}
pub trait Octal {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError>;
}
pub trait LowerHex {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError>;
}
pub trait UpperHex {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError>;
}
pub trait LowerExp {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError>;
}
pub trait UpperExp {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError>;
}
// (std's Pointer of a reference / raw pointer / Box: its address, which the compiler writes itself (`{:p}`, and
// `fmt::Pointer::fmt(&r, f)` through these); `{:p}` of a type of the program's calls its impl, __exr_fmt_pointer)
fn __exr_pointer_fmt<G>(a: usize, f: &mut Formatter) -> Result<(), __FmtError> {
    __exr_fmt_ptr::<()>(f, a);
    Ok(())
}
fn __exr_fat_pointer_fmt<G>(a: usize, n: usize, f: &mut Formatter) -> Result<(), __FmtError> {
    __exr_fmt_fat_ptr::<()>(f, a, n);
    Ok(())
}
fn __exr_dyn_pointer_fmt<G>(a: usize, vt: usize, f: &mut Formatter) -> Result<(), __FmtError> {
    __exr_fmt_dyn_ptr::<()>(f, a, vt);
    Ok(())
}
// (the two words of a fat pointer x points to: its address and its length or vtable, as `Pointer::fmt(&p, f)` of a
// `*const [u8]` / `&dyn Tr` writes them)
fn __exr_fat_words<T>(x: &T) -> (usize, usize) {
    let w = x as *const T as *const usize;
    unsafe { (*w, *w.add(1)) }
}
// (a number in the radix of the trait whose fmt is called, whatever spec the Formatter was given: 1 x, 2 X, 3 b, 4 o. A
// signed one is given as the unsigned type of its width, whose value its bits are: `-1i8` is `ff`, as std's)
fn __exr_radix_fmt<T>(x: &T, f: &mut Formatter, radix: u8) -> Result<(), __FmtError> {
    let r = f.radix;
    f.radix = radix;
    __exr_display(x, f);
    f.radix = r;
    Ok(())
}
